<script>
/* v1.0.7 equal-sized 4-panel comic layout */
(()=>{const img=document.querySelector('img.comic-cover');if(!img||img.dataset.uniform4)return;
const render=()=>{if(img.naturalWidth!==1448||img.naturalHeight!==1086)return;
const c=document.createElement('canvas');c.width=1448;c.height=1086;
const g=c.getContext('2d');if(!g)return;g.drawImage(img,0,0);
g.fillStyle='#fffaf2';g.fillRect(0,184,1448,902);
const crops=[[23,192,674,350],[716,192,668,392],[27,546,651,474],[716,604,666,426]];
const boxes=[[26,196,672,409],[717,196,672,409],[26,618,672,409],[717,618,672,409]];
crops.forEach((q,i)=>{const [x,y,w,h]=boxes[i];g.fillStyle='#fff';g.fillRect(x-4,y-4,w+8,h+8);g.save();g.beginPath();if(g.roundRect)g.roundRect(x,y,w,h,14);else g.rect(x,y,w,h);g.clip();g.drawImage(img,...q,x,y,w,h);g.restore();g.lineWidth=2;g.strokeStyle='#eeebdf';g.strokeRect(x-2,y-2,w+4,h+4);});
img.dataset.uniform4='1';img.src=c.toDataURL('image/webp',.92);};
if(img.complete&&img.naturalWidth)render();else img.addEventListener('load',render,{once:true});})();
<\/script><footer class="site-footer" id="site-footer">
<section class="site-guide" aria-labelledby="seo-heading">
<div class="site-guide-copy">
<h1 id="seo-heading">\uAE30\uBB18\uC640 \uD06C\uB2E4 \uBD80\uC7A5\uC758 \uC0AC\uBB34\uC2E4 \uBBF8\uB85C \uCD94\uACA9\uC804</h1>
<p>CBZP \uC778\uD134 \uACE0\uC591\uC774 \uAE30\uBB18\uAC00 \uC774\uB3D9 \uD30C\uD2F0\uC158\uC73C\uB85C \uC774\uB8E8\uC5B4\uC9C4 \uC0AC\uBB34\uC2E4\uC5D0\uC11C \uD06C\uB2E4 \uBD80\uC7A5\uC744 \uD53C\uD574 \uD654\uBD84\uC744 \uB358\uC9C0\uB294 1\uC778\uC6A9 \uBE0C\uB77C\uC6B0\uC800 \uAC8C\uC784\uC785\uB2C8\uB2E4.</p>
</div>
<details class="site-guide-howto"><summary>\uAC8C\uC784 \uBC29\uBC95</summary><p>\uBC29\uD5A5 \uD328\uB4DC\uB85C \uC774\uB3D9\uD558\uACE0, \uB300\uC2DC\uB85C \uC704\uD5D8\uC744 \uD53C\uD558\uBA70, \uD22C\uCC99 \uBC84\uD2BC\uC73C\uB85C \uD654\uBD84\uC744 \uB358\uC9C0\uC138\uC694. \uAE30\uBB18\uC640 \uD06C\uB2E4 \uBD80\uC7A5\uC758 \uCCB4\uB825 \uC911 \uBA3C\uC800 0\uC774 \uB418\uBA74 \uACBD\uAE30\uAC00 \uB05D\uB0A9\uB2C8\uB2E4.</p></details>
