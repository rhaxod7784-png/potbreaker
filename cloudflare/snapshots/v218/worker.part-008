"\uC11C\uBC84 \uC5F0\uACB0\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.":"\u8FDE\u63A5\u670D\u52A1\u5668\u5931\u8D25\u3002","\uB7AD\uD0B9\uC5D0 \uB4F1\uB85D\uD588\uC2B5\uB2C8\uB2E4.":"\u5DF2\u63D0\u4EA4\u6392\u884C\u3002","Pyodide\uB97C \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC778\uD130\uB137 \uC5F0\uACB0\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694.":"\u65E0\u6CD5\u52A0\u8F7D Pyodide\uFF0C\u8BF7\u68C0\u67E5\u7F51\u7EDC\u8FDE\u63A5\u3002",
