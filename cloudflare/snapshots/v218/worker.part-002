",
  "zh": "data:image/webp;base64,"
};
var GINKGO_PAGES = {
  "ko": `<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f8d14f">
<title>\uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4 | \uD3FF \uBE0C\uB808\uC774\uCEE4 \uD14C\uB9C8 2</title>
<meta name="description" content="\uC740\uD589\uB098\uBB34\uC758 \uB178\uB780 \uC740\uD589\uC744 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD558\uC138\uC694. 60\uCD08 \uAC8C\uC784, \uC138 \uAC00\uC9C0 \uB09C\uC774\uB3C4, \uC5F0\uC18D \uC131\uACF5 \uC810\uC218\uC640 \uB7AD\uD0B9\uC744 \uC9C0\uC6D0\uD569\uB2C8\uB2E4.">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://potbreaker.com/ginkgo">
<link rel="alternate" hreflang="ko" href="https://potbreaker.com/ginkgo">
