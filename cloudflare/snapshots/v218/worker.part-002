<link rel="alternate" hreflang="ja" href="https://potbreaker.com/ginkgo/ja">
<link rel="alternate" hreflang="zh-CN" href="https://potbreaker.com/ginkgo/zh">
<link rel="alternate" hreflang="x-default" href="https://potbreaker.com/ginkgo">
<meta property="og:type" content="website">
<meta property="og:url" content="https://potbreaker.com/ginkgo">
<meta property="og:title" content="\uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4 | \uD3FF \uBE0C\uB808\uC774\uCEE4 \uD14C\uB9C8 2">
<meta property="og:description" content="\uC740\uD589\uB098\uBB34\uC758 \uB178\uB780 \uC740\uD589\uC744 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD558\uC138\uC694. 60\uCD08 \uAC8C\uC784, \uC138 \uAC00\uC9C0 \uB09C\uC774\uB3C4, \uC5F0\uC18D \uC131\uACF5 \uC810\uC218\uC640 \uB7AD\uD0B9\uC744 \uC9C0\uC6D0\uD569\uB2C8\uB2E4.">
<meta property="og:locale" content="ko_KR">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{font-family:system-ui,'Noto Sans KR','Malgun Gothic',sans-serif;color:#342a20;background:#fbe9ad;font-synthesis:none}
*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:radial-gradient(circle at 10% 12%,#fff7cd 0,transparent 34%),radial-gradient(circle at 95% 5%,#bdeed8 0,transparent 28%),linear-gradient(125deg,#ffe58b,#fff3c7 45%,#f4dc8c);background-attachment:fixed}
button,input,select{font:inherit}button{cursor:pointer;touch-action:manipulation}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #1f7d74;outline-offset:3px}
.topbar{z-index:30;display:flex;justify-content:space-between;align-items:center;padding:10px clamp(10px,3vw,32px);position:sticky;top:0;background:#fffbebdb;backdrop-filter:blur(12px);border-bottom:3px solid #644630}
.menu{position:relative}.menu-button,.lang-button{border:2px solid #563b2a;border-radius:15px;background:#fff8d8;box-shadow:0 3px 0 #563b2a;padding:8px 13px;font-weight:900;color:#42321e}
.menu-list{position:absolute;top:calc(100% + 9px);left:0;min-width:245px;background:white;border:3px solid #563b2a;border-radius:14px;padding:8px;box-shadow:0 10px 25px #5f461d4b}
.menu-list a{display:block;margin:4px 0;padding:10px 12px;color:#273858;text-decoration:none;border:1px solid #c2d8ee;border-radius:999px;background:#fffdf8;box-shadow:0 2px 0 #90b4d1;font-weight:900}.menu-list a[aria-current]{background:#fff1b8}
.brand-mini{font-size:12px;font-weight:1000;color:#7b552b;letter-spacing:.02em}.lang-picker{border:2px solid #563b2a;background:#fffdf5;border-radius:12px;padding:9px 12px;font-weight:900;color:#463219}
.container{max-width:1080px;margin:0 auto;padding:clamp(10px,3vw,24px);text-align:center}
.heading{padding:12px 0 18px;position:relative}.heading small{font-weight:1000;letter-spacing:.12em;color:#684727}.heading h1{font-weight:1000;font-size:clamp(33px,7vw,78px);margin:6px 0;line-height:1.13;color:#f7b221;-webkit-text-stroke:2px #51341d;text-shadow:4px 5px 0 #67442c,7px 8px 0 #fff7c0}.heading h1 span{color:#7ec94d}.heading p{font-weight:800;line-height:1.5;margin:12px auto}
.leaves{position:absolute;pointer-events:none;font-size:clamp(30px,6vw,70px);top:4px;left:5%}.leaves.right{left:auto;right:6%;transform:rotate(35deg)}
.surface{background:#fff9de;border:3px solid #503623;box-shadow:0 7px 0 #523826;border-radius:23px;padding:clamp(13px,2.5vw,24px)}
.difficulties{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:16px 0}
.difficulties label{cursor:pointer;display:flex;align-items:center;gap:8px;padding:12px 16px;background:#fff9dc;border:2px solid #6a492e;border-radius:13px;font-weight:1000}
.difficulties label:has(input:checked){background:#a4da5c;box-shadow:inset 0 0 0 2px #305c27}
.action{background:linear-gradient(#9fe16c,#58b74a);color:#1d3920;font-weight:1000;padding:12px 22px;border:3px solid #3b5430;border-radius:16px;box-shadow:0 5px 0 #355d37;margin:5px}
.action.secondary{background:linear-gradient(#fff2b0,#e7bf69);border-color:#745232;box-shadow:0 5px 0 #745232}
.action:disabled{filter:grayscale(1);opacity:.55;cursor:not-allowed}
.comic-title{margin:26px 0 15px;font-size:clamp(18px,3vw,28px);font-weight:1000}
.comics{display:flex;justify-content:center;width:min(100%,800px);margin:16px auto}
.comic{margin:0;width:100%;overflow:hidden;border:4px solid #513421;border-radius:18px;background:#fff6cf;box-shadow:0 6px 0 #63432b}
.comic-image{display:block;width:100%;height:auto;object-fit:contain}
@media(max-width:680px){.comics{width:100%;margin:10px auto}.comic{border-width:2px;border-radius:10px}}
.play-area{padding-top:0}
.hud{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px auto;max-width:880px}
.stat{background:#fffaf0;border:2px solid #634531;border-radius:12px;padding:7px 13px;min-width:78px;font-size:clamp(11px,2.1vw,18px);font-weight:1000}
.stat b{font-size:clamp(18px,3vw,29px)}.stat.time{background:#ffe293}
.board-wrap{width:min(100%,880px);margin:auto;padding:7px;border:4px solid #704722;border-radius:22px;background:linear-gradient(#f6d77e,#d4a862);box-shadow:0 10px 0 #714b2b}
.board{display:grid;grid-template-columns:repeat(13,1fr);gap:3px;aspect-ratio:13/7;touch-action:manipulation}
.cell{border:1px solid #b79b52;position:relative;border-radius:7px;background:linear-gradient(160deg,#fff7c2,#f5de7e);padding:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.cell:after{content:'';position:absolute;bottom:9%;left:25%;right:25%;height:3px;background:#a7824d77;border-radius:50%}
.trunk{position:absolute;bottom:15%;left:46%;height:32%;width:10%;border-radius:3px;background:linear-gradient(90deg,#7b5330,#a98051);z-index:1}
.tree{position:absolute;z-index:2;top:7%;height:64%;width:76%;border:2px solid #516a31;border-radius:60% 60% 41% 41%;box-shadow:0 3px 0 #ffffff65 inset;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:1000}
.tree.leaf0{background:radial-gradient(circle at 40% 30%,#d0f783,#78c34c 70%,#4a9d42)}.tree.leaf1{background:radial-gradient(circle at 40% 30%,#fff5a8,#ffc62f 68%,#d99e22);border-color:#9f6d14}
.tree.fruit2,.tree.fruit3{height:45%;width:47%;top:30%;border-radius:50% 45% 58% 48%;background:radial-gradient(circle at 34% 27%,#fff2aa,#dfaa36 67%,#ba7320);border-color:#8d6a22}
.tree.fruit2:after{content:'\u2022';color:#e8c260;text-shadow:-7px 3px #f8d15b,7px 3px #ffe399;font-size:clamp(9px,2vw,23px)}
.tree.fruit3{background:radial-gradient(circle at 35% 20%,#9f8664,#62503f 74%,#392f29);border-color:#382d25}
.tree.fruit3:after{content:'\xD7';font-size:clamp(12px,2vw,24px);color:#f2d5ac}
.cell:active{transform:scale(.93)}.cell:disabled{cursor:default}
.locked{filter:grayscale(.5)}.lock-message{margin:9px auto;color:#763e22;font-weight:900;min-height:1.8em}
.end-grid{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:16px}
.end-grid .stat{min-width:130px}.nickname{border:2px solid #634531;border-radius:12px;padding:10px 12px;width:min(90%,280px);font-weight:700}
table{border-collapse:collapse;width:100%;font-weight:700}td,th{padding:10px 8px;border-bottom:1px solid #d9bf89;text-align:left}td:nth-child(3),td:nth-child(4),th:nth-child(3),th:nth-child(4){text-align:right}
.status{min-height:1.4em;color:#7e432c;font-weight:800}
.seo-copy{max-width:880px;margin:28px auto 10px;text-align:left;line-height:1.65}.seo-copy h2{font-size:21px}
footer{max-width:880px;margin:24px auto;padding-bottom:15px;display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font-size:13px}footer a{color:#533a26}
[hidden]{display:none!important}
@media(max-width:680px){.comics{grid-template-columns:repeat(2,1fr);gap:7px}.comic{min-height:130px;padding:8px}.comics .art{margin:2px 0}.board{gap:1px}.cell{border-radius:3px}.tree{border-width:1px}.trunk{width:11%}.hud{gap:4px}.stat{min-width:0;padding:5px 7px}.heading h1{-webkit-text-stroke:1.3px #51341d;text-shadow:2px 3px 0 #67442c}.topbar{padding:7px}.brand-mini{display:none}}
@media(max-width:380px){.tree.fruit2:after{display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

/* Theme 2 follows the existing Pot Breaker cover \u2192 comic intro \u2192 game entry flow. */
:root{background:#fae9ab}
body{background:linear-gradient(145deg,#fff6c9 0%,#f6d865 50%,#ffeeb6 100%)}
.cover-screen{width:100%;margin:0 auto}
.cover-frame{position:relative;overflow:hidden;width:min(100%,1080px);margin:8px auto 0;aspect-ratio:16/9;border:4px solid #513421;border-radius:22px;background:#f5d75b;box-shadow:0 9px 0 #63432b}
.cover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.cover-actions{width:min(100%,1080px);margin:14px auto 4px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}
.cover-copy{flex:1 1 100%;text-align:center}.cover-copy small{font-weight:1000;letter-spacing:.1em;color:#674824}.cover-copy h1{font-size:clamp(30px,6vw,68px);line-height:1.08;margin:5px 0;color:#f4bc24;-webkit-text-stroke:2px #51341d;text-shadow:3px 4px 0 #67442c,6px 7px 0 #fff7c0}
.cover-copy h1 span:last-child{color:#80c950}.cover-copy p{font-weight:900;margin:7px 0 3px}
.cover-start{min-width:190px;border-radius:999px;padding:15px 25px;font-size:clamp(17px,2.2vw,24px);background:linear-gradient(#ffe877,#ffbd34);color:#49351d;border-color:#78512a;box-shadow:0 5px 0 #79502a}
.intro-screen{width:100%;min-height:calc(100dvh - 80px);display:flex;align-items:center;justify-content:center}
.intro-layout{width:min(100%,1240px);display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,310px);align-items:center;gap:24px;text-align:left}
.intro-art{margin:0;width:100%;max-height:78dvh;display:grid;place-items:center;overflow:hidden;border-radius:14px;background:#fff8dc}
.intro-comic-image{display:block;width:100%;height:auto;max-height:78dvh;object-fit:contain}
.intro-panel{padding:22px 20px;text-align:left}.episode{margin:0 0 8px;color:#79613b;letter-spacing:.14em;font-size:12px;font-weight:1000}
.intro-panel h1{font-size:clamp(22px,2.4vw,32px);line-height:1.2;margin:7px 0}
.intro-copy{font-weight:800;line-height:1.55}.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:7px;margin:13px 0}
.intro-panel .difficulties label{justify-content:flex-start;padding:9px 10px}
.intro-panel .action{width:100%;margin:7px 0}.intro-panel .action.secondary{font-size:15px;padding:9px}
.intro-help{font-size:12px;line-height:1.5;color:#685638}.intro-panel .status{margin:2px 0}
@media(max-width:760px){.cover-frame{aspect-ratio:1.18/1;border-width:2px;border-radius:13px}.cover-actions{gap:8px}.cover-copy h1{-webkit-text-stroke:1.2px #51341d;text-shadow:2px 3px 0 #67442c}.cover-start{min-width:160px}.intro-screen{align-items:flex-start}.intro-layout{grid-template-columns:1fr;gap:10px}.intro-art{max-height:none}.intro-comic-image{max-height:none}.intro-panel{padding:15px}.intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))}.intro-panel .difficulties label{font-size:11px;gap:4px;padding:8px 5px}}


/* Shared Pot Breaker landscape shell: 16:9 stage, rotated for portrait touch screens. */
html,body{width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
body{background:#83c4f3}
.viewport{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 50% 0%,#dff8ff 0,#a5d9fc 45%,#70b8ee 100%)}
.stage{position:relative;flex:0 0 auto;width:min(100vw,177.778dvh);height:min(100dvh,56.25vw);aspect-ratio:16/9;container-type:size;container-name:game-stage;overflow:hidden;isolation:isolate;background:#f6eedf;box-shadow:0 2vh 7vh #2b467669}
.topbar{position:absolute;z-index:30;left:1.5%;right:1.5%;top:1.5%;height:8%;padding:0 1.2%;display:flex;align-items:center;justify-content:space-between;background:#ffffffdb;border:2px solid #fff;border-radius:16px;box-shadow:0 4px 14px #40577b24}
.topbar .menu-button,.topbar .lang-picker{border:2px solid #bfd7ef;border-radius:12px;background:#fffdf9;color:#303d67;box-shadow:0 3px 0 #9ab5d0;padding:6px 10px}
.topbar .brand-mini{font-size:clamp(7px,1cqw,12px);color:#303d67}
.container{position:absolute;inset:11% 2% 2%;width:96%;max-width:none;height:87%;margin:0;padding:0;overflow:hidden;text-align:center}
.cover-screen,.intro-screen,.play-area,#rankings,#end{position:absolute;inset:0;width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
.cover-screen:not([hidden]),.intro-screen:not([hidden]),.play-area:not([hidden]),#rankings:not([hidden]),#end:not([hidden]){display:flex}
.cover-screen{align-items:center;justify-content:center;gap:3%;padding:2.2%;background:linear-gradient(115deg,#e7f8ff,#b0dffc 64%,#98cafa);border:3px solid white;border-radius:24px}
.cover-frame{order:2;flex:0 0 58%;width:58%;max-width:none;aspect-ratio:16/9;margin:0;border:0;border-radius:16px;box-shadow:0 8px 18px #30456832}
.cover-actions{order:1;flex:1;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;width:auto;gap:2%;margin:0}
.cover-copy{flex:0 1 auto;text-align:left}.cover-copy h1{font-size:clamp(22px,5cqw,64px);color:#303d67;-webkit-text-stroke:0;text-shadow:0 3px 0 #fff,0 7px 12px #40577b25}.cover-copy h1 span:last-child{color:#5578bd}.cover-copy p{font-size:clamp(9px,1.5cqw,18px);line-height:1.35}
.cover-start,.action{border:2px solid #fff;border-radius:999px;color:#fff;background:linear-gradient(145deg,#648ddc,#446ab6);box-shadow:0 5px 0 #38528499;padding:clamp(7px,1.2cqw,14px) clamp(12px,2cqw,24px);font-size:clamp(10px,1.5cqw,20px)}
.action.secondary{color:#303d67;background:#fffdf9;border-color:#bfdbf6;box-shadow:0 4px 0 #9ab5d0}
.intro-screen{align-items:center;justify-content:center;padding:1.5%;background:linear-gradient(115deg,#f1faff,#a7d5f9);border:3px solid white;border-radius:24px}
.intro-layout{width:100%;height:100%;display:grid;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;align-items:center}
.intro-art{width:100%;height:100%;max-height:100%;margin:0;display:grid;place-items:center;overflow:hidden;border:3px solid white;border-radius:14px;background:#fffcf5c9}
.intro-comic-image{width:100%;height:100%;max-height:none;object-fit:contain}
.intro-panel{max-height:100%;overflow:auto;padding:2%;border:2px solid white;border-radius:18px;background:#fffcf5ed;box-shadow:0 5px 14px #456f9530}
.intro-panel h1{font-size:clamp(14px,2.5cqw,30px)}.intro-copy,.intro-help{font-size:clamp(8px,1.2cqw,14px);line-height:1.4}
.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:4px;margin:7px 0}
.intro-panel .difficulties label{font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
.intro-panel .action{width:100%;margin:3px 0}
.play-area{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1%;background:#f3eada;border:3px solid white;border-radius:24px}
.hud{width:min(100%,90cqw);margin:0 auto 1%;gap:1%}.stat{min-width:0;padding:4px 8px;font-size:clamp(9px,1.15cqw,15px)}.stat b{font-size:clamp(12px,1.8cqw,22px)}
.board-wrap{width:100%;height:auto;max-height:none;min-height:0;flex:1 1 auto;padding:.6%;border:3px solid white;border-radius:14px;box-shadow:0 6px 0 #7b694e44}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.3cqw,4px)}
#play #lock-message:empty{display:none}
..seo-copy{display:none}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:fixed;inset:0;width:100vw;height:100dvh;display:block;overflow:hidden}
 .stage{position:absolute;left:50%;top:50%;width:min(100dvh,177.778vw);height:min(100vw,56.25dvh);transform:translate(-50%,-50%) rotate(90deg);transform-origin:center center}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;height:100%}
 .intro-panel{max-height:100%;overflow:auto;padding:2%}
 .intro-panel .difficulties{grid-template-columns:1fr}
 .intro-panel .difficulties label{justify-content:flex-start;font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
}
@media(orientation:landscape) and (pointer:coarse){.viewport{width:100vw;height:100dvh}.stage{width:min(100vw,177.778dvh);height:min(100dvh,56.25vw)}}


/* Pot Breaker visual system: full-screen cover, warm gold CTA, compact floating controls. */
:root{color:#302a27;background:#83c4f3}
body{background:#83c4f3}
.stage{background:#f6eedf}
.topbar{left:1.2%;right:1.2%;top:1.4%;height:8%;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none}
.topbar .menu-button,.topbar .lang-picker{min-height:clamp(28px,5.4cqh,48px);padding:clamp(4px,.8cqw,9px) clamp(8px,1.35cqw,16px);border:2px solid #fff;border-radius:999px;background:#fffdf2;color:#273858;box-shadow:0 4px 0 #9ab5d0,0 6px 13px #18395b38;font-weight:900}
.topbar .brand-mini{color:#fffdf2;font-size:clamp(7px,1cqw,12px);font-weight:1000;letter-spacing:.1em;text-shadow:0 1px 4px #19355c,0 0 7px #19355c}
.menu-list{top:calc(100% + 6px);border:2px solid #c2d8ee;border-radius:18px;background:#fffdf8;box-shadow:0 5px 16px #18395b44}
.container{inset:0;width:100%;height:100%;padding:0}
.cover-screen{display:block!important;padding:0;border:0;border-radius:0;background:#f6eedf}
.cover-frame{position:absolute;inset:0;order:initial;width:100%;height:100%;max-width:none;aspect-ratio:auto;margin:0;border:0;border-radius:0;box-shadow:none;background:#78c6f5}
.cover-image{width:100%;height:100%;object-fit:cover;object-position:center 58%;filter:saturate(1.04)}
.cover-actions{position:absolute;inset:0;order:initial;display:block;width:100%;height:100%;margin:0;pointer-events:none}
.cover-copy{position:absolute;left:12%;right:12%;top:9%;text-align:center;pointer-events:none}
.cover-copy small{display:inline-block;margin-bottom:.3%;padding:.25em .8em;border-radius:999px;color:#fff9df;background:#453527b8;font-size:clamp(8px,1.15cqw,14px);font-weight:1000;letter-spacing:.12em;text-shadow:none}
.cover-copy h1{margin:0;color:#f4cf70;font-family:"Gungsuh","\uAD81\uC11C","\uAD81\uC11C\uCCB4","Nanum Myeongjo","Batang",serif;font-size:clamp(28px,7.1cqw,86px);font-weight:700;line-height:1.08;letter-spacing:.025em;-webkit-text-stroke:clamp(3px,.65cqw,8px) #050403;paint-order:stroke fill;text-shadow:0 3px 10px #1d2b3f99}
.cover-copy h1 span:last-child{color:inherit}
.cover-copy p{display:none}
.cover-start,.action{pointer-events:auto;border:3px solid #583a22;border-radius:999px;color:#302b31;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%);box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360;padding:clamp(8px,1.4cqw,16px) clamp(20px,3.4cqw,42px);font-weight:1000;text-shadow:0 1px #fff8d8;transition:transform .12s,filter .12s}
.cover-start:hover,.action:hover{filter:brightness(1.04);transform:translateY(-1px)}
.site-info-links [class^="info-"]{display:none}html[lang="ko"] .site-info-links .info-ko,html[lang="en"] .site-info-links .info-en,html[lang="zh"] .site-info-links .info-zh,html[lang="ja"] .site-info-links .info-ja{display:inline}
.intro-screen{padding:2%;border:0;border-radius:0;background:linear-gradient(145deg,#a8dcfb,#77bdf0)}
.intro-layout{width:100%;height:100%;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
.intro-art{border:3px solid #fff;border-radius:18px;background:#f6eedf;box-shadow:0 5px 0 #6489a355}
.intro-panel{padding:2.1%;border:2px solid #fff;border-radius:20px;background:#fffdf7;box-shadow:0 5px 0 #6489a355,0 9px 20px #385b7824;color:#302a27}
.intro-panel .episode{color:#795529}
.intro-panel .action{min-height:clamp(28px,5.5cqh,50px)}
.intro-panel .action.secondary{color:#273858;background:#fffdf7;border:2px solid #c2d8ee;box-shadow:0 3px 0 #90b4d1}
.play-area{inset:1.5%;width:97%;height:97%;padding:1%;border:3px solid #fff;border-radius:22px;background:#f3eada;box-shadow:0 5px 0 #6f5e4840}
/* Floating, non-layout feedback for the brief rotten-fruit input lock. */
.tree.fruit2{border:clamp(2px,.3cqw,4px) solid #e6403b;box-shadow:0 0 0 1px #fff6dd,0 3px 0 #ffffff65 inset,0 2px 4px #572a2344}
.play-area .lock-message{position:absolute;z-index:30;top:10%;left:50%;width:max-content;max-width:82%;margin:0;padding:6px 12px;border:1px solid #fff8e7;border-radius:999px;background:#2d3340df;color:#fff5d6;box-shadow:0 4px 12px #2a283244;font-size:clamp(9px,1.15cqw,14px);font-weight:900;text-align:center;opacity:0;visibility:hidden;transform:translate(-50%,-6px);pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s}
.play-area .lock-message.is-visible{opacity:1;visibility:visible;transform:translate(-50%,0)}

.hud{width:100%;max-width:none;margin:8% auto 1%;gap:1%}
.board-wrap{flex:1 1 0;width:100%;height:auto;max-height:none;min-height:0;padding:.55%;border:3px solid #fff;border-radius:16px;background:linear-gradient(135deg,#f8df82,#dcae58);box-shadow:0 5px 0 #6f5e4844}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.32cqw,4px)}
#rankings:not([hidden]),#end:not([hidden]){display:block;inset:3%;width:94%;height:94%;padding:10% 3% 3%;overflow:auto;border:3px solid #fff;border-radius:22px;background:#fffdf7;box-shadow:0 5px 0 #6f5e4844}
#rankings h1,#end h1{color:#303d67}
@media(orientation:portrait) and (pointer:coarse){
 .topbar{left:1.2%;right:1.2%;top:1.4%;height:8%}
 .container{inset:0;width:100%;height:100%}
 .cover-image{object-position:center 58%}
 .cover-copy{top:8%;left:8%;right:8%}
 .cover-copy h1{font-size:clamp(28px,7.1cqw,86px)}

 .play-area{inset:1.5%;width:97%;height:97%}
 .hud{margin-top:8%}
 .intro-screen{padding:2%}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
}

/* Shared Pot Breaker home controls. Keep these anchors identical in both modes. */
:root{--pb-home-gold:#ffd35c;--pb-home-blue:#303d67;--pb-home-outline:#5c4222;--pb-home-shadow:#9ab8d0}
#pb-game-mode{position:fixed;top:9px;left:9px;z-index:50;pointer-events:auto;font:900 12px/1.3 system-ui,sans-serif;color:#343027}
#pb-game-mode summary{display:flex;align-items:center;gap:6px;min-height:28px;box-sizing:border-box;cursor:pointer;list-style:none;background:#fff7d8f5;border:2px solid #6c482f;border-radius:12px;padding:7px 10px;box-shadow:0 3px 0 #765436}
#pb-game-mode summary::-webkit-details-marker{display:none}
#pb-game-mode nav{position:absolute;top:calc(100% + 8px);left:0;display:grid;width:max-content;min-width:185px;box-sizing:border-box;background:#fffced;border:2px solid #6c482f;border-radius:12px;margin:0;padding:6px;box-shadow:0 9px 22px #32201059}
#title .home-start,.cover-actions .home-start--visible{position:absolute;left:36.6%;top:39.4%;width:26.8%;height:11%;display:flex!important;align-items:center;justify-content:center;gap:.5em;box-sizing:border-box;margin:0!important;padding:0!important;border:3px solid var(--pb-home-outline)!important;border-radius:999px;color:#302b31!important;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%)!important;box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(16px,2cqw,22px)!important;font-weight:1000;line-height:1;text-shadow:0 1px #fff8d8;white-space:nowrap;z-index:9}
#title .home-start{cursor:pointer}
#title .home-start:hover{transform:none!important}
#title .home-start::before,.cover-actions .home-start--visible::before{content:"";flex:0 0 auto;width:0;height:0;border-top:.48em solid transparent;border-bottom:.48em solid transparent;border-left:.72em solid #242329;filter:drop-shadow(1px 1px 0 #fff8d8)}
.cover-actions .home-start--visible{pointer-events:auto;transform:none}
.cover-actions .home-start--visible:hover{filter:brightness(1.04);transform:none}
#title .home-ranking,.cover-actions .home-ranking{position:absolute;left:3%;bottom:3%;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;width:clamp(96px,9cqw,108px);min-width:clamp(96px,9cqw,108px);height:40px;margin:0;padding:7px 12px;border:2px solid #fff;border-radius:999px;color:var(--pb-home-blue);background:#fffdf2;box-shadow:0 4px 0 var(--pb-home-shadow),0 6px 13px #18395b38;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:12px;font-weight:1000;line-height:1;white-space:nowrap;pointer-events:auto}
.game-switch{position:absolute!important;z-index:5;left:4%!important;bottom:calc(4% + 54px)!important;display:flex!important;align-items:center;justify-content:center;width:clamp(168px,22cqw,226px)!important;height:42px!important;box-sizing:border-box;padding:0 12px!important;border:2px solid #fff!important;border-radius:999px!important;color:#35456d!important;background:#fffdf0e8!important;box-shadow:0 5px 14px #35456535!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(10px,1.05cqw,14px)!important;font-weight:1000!important;line-height:1!important;text-align:center;text-decoration:none;white-space:nowrap;pointer-events:auto}
.site-info-links{position:absolute!important;z-index:12;right:calc(2.2% + clamp(92px,15cqw,200px))!important;bottom:calc(2.4% + 38px)!important;display:flex!important;align-items:center;justify-content:flex-end;gap:clamp(4px,.7cqw,9px);pointer-events:auto}
.site-info-links a{display:inline-flex;align-items:center;justify-content:center;min-height:clamp(24px,3.6cqw,36px);box-sizing:border-box;padding:4px clamp(7px,1cqw,12px);border:1px solid #fff;border-radius:999px;background:#fffdf0e8;color:#35456d;box-shadow:0 3px 9px #35456530;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:clamp(8px,.95cqw,12px);font-weight:900;line-height:1;text-decoration:none;white-space:nowrap}
#pb-game-mode summary,.topbar .menu-button{min-height:28px;padding:7px 10px;border:2px solid #6c482f;border-radius:12px;background:#fff7d8f5;color:#343027;box-shadow:0 3px 0 #765436;font:900 12px/1.3 system-ui,sans-serif}
.menu-list{min-width:185px;margin-top:8px;padding:6px;border:2px solid #6c482f;border-radius:12px;background:#fffced;box-shadow:0 9px 22px #32201059}
#pb-game-mode nav a,.menu-list a{display:block;margin:0;padding:10px;border:0;border-radius:7px;background:transparent;color:#3f3226;box-shadow:none;font-weight:900;text-decoration:none}
#pb-game-mode nav a:hover,#pb-game-mode nav a:focus-visible,.menu-list a:hover,.menu-list a:focus-visible{background:#f8e5a4}
.menu .locale-control{right:1.2%!important;top:1.4%!important;bottom:auto!important}
.topbar .lang-picker{position:absolute;top:0;right:0}
.locale-control select,.topbar .lang-picker{box-sizing:border-box;max-width:104px;min-height:clamp(28px,5.4cqh,40px);padding:4px 20px 4px 9px;border:1px solid #ffffffed;border-radius:999px;background:#fffef4;color:#293b60;font:700 clamp(9px,1cqw,12px)/1.2 system-ui,sans-serif;box-shadow:0 2px 7px #34486b36;touch-action:manipulation}
.locale-control select:focus-visible,.topbar .lang-picker:focus-visible{outline:3px solid #f0bd48;outline-offset:2px}

#pb-game-mode .mode-label,#pb-game-mode .mode-pot,#pb-game-mode .mode-ginkgo{display:none}
html[lang="ko"] #pb-game-mode .mode-label-ko,html[lang="ko"] #pb-game-mode .mode-pot-ko,html[lang="ko"] #pb-game-mode .mode-ginkgo-ko{display:inline}
html[lang="en"] #pb-game-mode .mode-label-en,html[lang="en"] #pb-game-mode .mode-pot-en,html[lang="en"] #pb-game-mode .mode-ginkgo-en{display:inline}
html[lang="ja"] #pb-game-mode .mode-label-ja,html[lang="ja"] #pb-game-mode .mode-pot-ja,html[lang="ja"] #pb-game-mode .mode-ginkgo-ja{display:inline}
html[lang="zh"] #pb-game-mode .mode-label-zh,html[lang="zh"] #pb-game-mode .mode-pot-zh,html[lang="zh"] #pb-game-mode .mode-ginkgo-zh{display:inline}
#pb-game-mode nav a[aria-current="page"]{background:#f8e5a4}
.topbar{justify-content:flex-end}
/* Shared footer and 16:9 stage sizing for Pot Breaker and Ginkgo Tree Breaker. */
:root{--pb-footer-h:clamp(72px,9vh,104px)}
html,body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}
body{min-height:100dvh!important}
.viewport{position:relative!important;inset:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:280px;box-sizing:border-box;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;background:linear-gradient(135deg,#c8e8ff,#9acaf6)!important}
.stage{position:relative!important;left:auto!important;top:auto!important;flex:0 0 auto!important;width:min(100vw,calc((100dvh - var(--pb-footer-h))*1.77778))!important;height:min(calc(100dvh - var(--pb-footer-h)),56.25vw)!important;transform:none!important;margin:auto!important}
.site-footer{position:relative;z-index:50;width:100%;max-width:none!important;min-height:var(--pb-footer-h);box-sizing:border-box;display:grid;place-items:center;margin:0!important;padding:8px clamp(12px,2vw,28px);background:linear-gradient(100deg,#dff5ff,#b9e0fa 55%,#99cdf2);border-top:1px solid #ffffffc7;color:#293b60}
.site-guide{width:min(100%,1280px);display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:clamp(8px,1.6vw,22px)}
.site-guide-copy h1,.site-guide-copy h2{margin:0 0 3px;font-size:clamp(11px,1.15vw,16px);line-height:1.2}.site-guide-copy p{margin:0;font-size:clamp(9px,.9vw,12px);line-height:1.35}
.site-guide-howto{position:relative;font-size:clamp(9px,.9vw,12px)}.site-guide-howto summary{cursor:pointer;font-weight:800;white-space:nowrap}.site-guide-howto p{max-width:min(55vw,520px);margin:6px 0 0}
.site-guide nav{display:flex;gap:clamp(6px,1vw,14px);flex-wrap:wrap;justify-content:flex-end;font-size:clamp(9px,.9vw,12px)}.site-guide a{color:#244e70;text-underline-offset:2px}
/* Keep shared navigation and legal links out of the active playfield. */
body.is-playing{--pb-footer-h:0px!important}
body.is-playing #home,body.is-playing #title,body.is-playing #pb-game-mode,body.is-playing .topbar,body.is-playing .game-switch,body.is-playing .site-info-links,body.is-playing .site-footer{display:none!important}
body.is-ginkgo-subview #home,body.is-ginkgo-subview .game-switch,body.is-pot-subview #title,body.is-pot-subview .game-switch,body.is-pot-subview .site-info-links{display:none!important}
@media(max-width:700px){:root{--pb-footer-h:clamp(96px,16vh,136px)}.site-guide{grid-template-columns:minmax(0,1fr);align-items:start;gap:5px}.site-guide-copy{grid-column:auto}.site-guide-copy h1,.site-guide-copy h2{font-size:12px}.site-guide-copy p{font-size:10px;line-height:1.3}.site-guide nav{justify-content:flex-start;font-size:10px}.site-guide-howto{font-size:10px}.site-guide-howto p{max-width:90vw}}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:relative!important;inset:auto!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:220px!important;width:100vw!important;display:block!important;overflow:hidden!important}
 .stage{position:relative!important;left:auto!important;top:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;transform:none!important;transform-origin:center center!important;margin:0!important;aspect-ratio:auto!important;border-radius:0!important}
 body.is-playing .viewport{position:fixed!important;inset:0!important;height:100dvh!important}
 body.is-playing .stage{position:absolute!important;left:50%!important;top:50%!important;width:min(100dvh,177.778vw)!important;height:min(100vw,56.25dvh)!important;transform:translate(-50%,-50%) rotate(90deg)!important}
 #title .home-start,.cover-actions .home-start--visible{left:50%!important;top:40.5%!important;width:min(82%,320px)!important;height:clamp(52px,9vh,70px)!important;transform:translateX(-50%)!important;font-size:clamp(17px,5vw,22px)!important}
 #title .home-ranking,.cover-actions .home-ranking{left:50%!important;bottom:3%!important;transform:translateX(-50%)!important}
 .game-switch{left:50%!important;bottom:calc(3% + 46px)!important;width:min(82%,260px)!important;transform:translateX(-50%)!important}
 .site-info-links{right:50%!important;bottom:2%!important;transform:translateX(50%)!important;gap:5px!important}
 .site-info-links a{font-size:10px!important}
 #intro{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,1fr) auto!important;gap:8px!important;padding:56px 12px 12px!important}
 #intro>.comic-cover-wrap{height:40vh!important;max-height:40vh!important;min-height:0!important}
 #intro>.intro-side{height:auto!important;max-height:calc(100% - 40vh - 8px)!important;min-height:clamp(220px,34vh,280px)!important;overflow:auto!important;align-items:stretch!important;gap:8px!important;padding:10px!important}
 #intro .difficulty-picker{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 #intro .difficulty-picker span{grid-column:1/-1!important}
 #intro .intro-side h2{font-size:clamp(18px,5vw,26px)!important}
 #intro .intro-side p,#intro .intro-side small{font-size:12px!important}
 #home .cover-frame{width:100%!important;height:100%!important;max-width:none!important;aspect-ratio:auto!important}
 #home .cover-image{object-fit:cover!important;object-position:center 50%!important}
 .intro-layout{width:100%!important;height:100%!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,32vh) minmax(0,1fr)!important;gap:8px!important;padding:56px 10px 10px!important}
 .intro-art{height:100%!important;max-height:32vh!important;min-height:0!important}
 .intro-comic-image{width:100%!important;height:100%!important;object-fit:contain!important}
 .intro-panel{height:auto!important;min-height:clamp(250px,36vh,300px)!important;max-height:calc(100% - 32vh - 8px)!important;overflow:auto!important;padding:12px!important}
 .intro-panel h1{font-size:clamp(18px,5vw,26px)!important}
 .intro-panel .intro-copy,.intro-panel .intro-help{font-size:12px!important}
 .intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 .intro-panel .difficulties label{font-size:10px!important;padding:8px 4px!important}
 .intro-panel .action{min-height:44px!important}
 .play-area{inset:1.5%!important;width:97%!important;height:97%!important}
 .hud{margin-top:clamp(50px,8vh,76px)!important}
}

</style>
</head>
<body>
<div class="viewport"><div class="stage" id="ginkgo-stage">
<header class="topbar">
<select id="language" class="lang-picker" aria-label="Language"><option value="ko">\uD55C\uAD6D\uC5B4</option><option value="en">English</option><option value="ja">\u65E5\u672C\u8A9E</option><option value="zh">\u4E2D\u6587</option></select>
</header>
<main class="container">
<section id="home" class="cover-screen">
<div class="cover-frame">
<img class="cover-image" src="{{COVER_IMAGE}}" alt="\uAC00\uC744 \uC740\uD589\uB098\uBB34 \uAE38\uC744 \uBC14\uB77C\uBCF4\uB294 \uAE30\uBB18\uC640 \uD06C\uB2E4 \uBD80\uC7A5" width="995" height="560" decoding="async" fetchpriority="high">
</div>
<div class="cover-actions">
<div class="cover-copy"><small data-i18n="theme">\uD3FF \uBE0C\uB808\uC774\uCEE4 \uD14C\uB9C8 2</small><h1><span data-i18n="title1">\uAE45\uCF54\uD2B8\uB9AC</span> <span data-i18n="title2">\uBE0C\uB808\uC774\uCEE4!</span></h1><p data-i18n="subtitle">\uB9CE\uC774 \uBF51\uC744\uC218\uB85D \uC88B\uC740 \uAC74\uAC00...? \uC369\uAE30 \uC804\uC5D0 \uC740\uD589\uC744 \uD130\uCE58\uD574 \uC810\uC218\uB97C \uC62C\uB9AC\uC138\uC694!</p></div>
<button class="action cover-start home-start home-start--visible" id="open-intro" data-i18n="open">\uAC8C\uC784 \uC2DC\uC791</button>
<button class="action secondary home-ranking" id="ranks-from-home" data-i18n="home_ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</button><a class="game-switch" id="potbreaker-link" href="/"><span data-i18n="pot">\u{1FAB4} \uD3FF\uBE0C\uB808\uC774\uCEE4 RE</span></a>
</div>
<nav class="site-info-links" aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav></section>
<section id="intro" class="intro-screen" hidden>
<div class="intro-layout">
<figure class="intro-art"><img class="intro-comic-image" src="{{COMIC_IMAGE}}" alt="\uAE30\uBB18\uC758 \uCD9C\uADFC\uAE38\uC5D0\uC11C \uC740\uD589\uB098\uBB34 \uC81C\uAC70 \uC791\uC5C5\uAE4C\uC9C0 \uC774\uC5B4\uC9C0\uB294 \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4 4\uCEF7 \uB9CC\uD654" width="600" height="600" decoding="async" fetchpriority="high"></figure>
<aside class="intro-panel surface">
<p class="episode">EP.02 / GINKGO TREE BREAKER</p>
<h1 data-i18n="intro_title">\uAE30\uBB18\uC758 \uC774\uC0C1\uD55C \uCD9C\uADFC\uAE38</h1>
<p class="intro-copy" data-i18n="intro_copy">\uC740\uD589\uC774 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD574 \uC5C6\uC560\uC138\uC694. 60\uCD08 \uB3D9\uC548 \uC810\uC218\uB97C \uBAA8\uC544 \uB7AD\uD0B9\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4.</p>
<div class="difficulties">
<label><input type="radio" name="difficulty" value="normal" checked> NORMAL <small>3s</small></label>
<label><input type="radio" name="difficulty" value="hard"> HARD <small>2s</small></label>
<label><input type="radio" name="difficulty" value="very_hard"> VERY HARD <small>1s</small></label>
</div>
<button class="action cover-start" id="begin" data-i18n="enter">\uC740\uD589\uB098\uBB34\uB85C \uCD9C\uADFC \u25B6</button>
<button class="action secondary" id="intro-back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
<p class="intro-help" data-i18n="intro_help">\uB178\uB780 \uC740\uD589\uB9CC \uD130\uCE58\uD558\uC138\uC694. \uC78E\uC740 \uCF64\uBCF4\uB97C \uB04A\uACE0, \uC369\uC740 \uC740\uD589\uC740 0.5\uCD08 \uB3D9\uC548 \uC785\uB825\uC744 \uB9C9\uC2B5\uB2C8\uB2E4.</p>
<p class="status" id="begin-status" aria-live="polite"></p>
</aside>
</div>
</section>
<section id="play" class="play-area" hidden aria-label="Ginkgo Tree Breaker game">
<div class="hud"><div class="stat">\u{1F3C6} <span data-i18n="score">\uC810\uC218</span> <b id="score">0</b></div><div class="stat time">\u23F1\uFE0F <b id="timer">60.0</b>s</div><div class="stat">\u{1F525} <span data-i18n="combo">\uC5F0\uC18D</span> <b id="combo">0</b></div></div>
<div class="board-wrap"><div id="board" class="board" role="group" aria-label="Ginkgo trees"></div></div>
<p id="lock-message" class="lock-message" aria-live="polite"></p>
</section>
<section id="end" class="surface" hidden>
<h2 data-i18n="finished">60\uCD08 \uC885\uB8CC!</h2><div class="end-grid"><div class="stat"><span data-i18n="score">\uC810\uC218</span><br><b id="final-score">0</b></div><div class="stat"><span data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</span><br><b id="final-combo">0</b></div></div>
<label for="nickname" data-i18n="name">\uB7AD\uD0B9\uC5D0 \uD45C\uC2DC\uD560 \uB2C9\uB124\uC784</label><br><input class="nickname" maxlength="16" id="nickname" autocomplete="nickname" placeholder="Gimyo">
<div><button class="action" id="submit" data-i18n="submit">\uB7AD\uD0B9 \uB4F1\uB85D</button><button class="action secondary" id="retry" data-i18n="retry">\uB2E4\uC2DC \uC2DC\uC791</button></div>
<p id="result-status" class="status" aria-live="polite"></p>
</section>
<section id="rankings" class="surface" hidden>
<h2 data-i18n="ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</h2><p data-i18n="ranking_info">\uC810\uC218 \uC6B0\uC120 \xB7 \uB3D9\uC810 \uC2DC \uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5 \xB7 1~3\uC704 \uC601\uAD6C \uBCF4\uAD00 / 4\uC704 \uC774\uD558 \uB9E4\uC6D4 1\uC77C \uC0AD\uC81C</p>
<select id="rank-difficulty" class="lang-picker"><option value="normal">NORMAL</option><option value="hard">HARD</option><option value="very_hard">VERY HARD</option></select>
<div style="overflow-x:auto"><table><thead><tr><th data-i18n="place">\uC21C\uC704</th><th data-i18n="player">\uD50C\uB808\uC774\uC5B4</th><th data-i18n="score">\uC810\uC218</th><th data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</th></tr></thead><tbody id="ranking-rows"></tbody></table></div>
<p id="rank-status" class="status" aria-live="polite"></p><button class="action secondary" id="back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
</section>
</main></div></div>
<footer class="site-footer" id="site-footer">
<section class="site-guide" aria-labelledby="ginkgo-guide-heading">
<div class="site-guide-copy"><h2 id="ginkgo-guide-heading">\uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4 \uAC8C\uC784 \uBC29\uBC95</h2><p>\uC740\uD589\uB098\uBB34\uC758 \uB178\uB780 \uC740\uD589\uC744 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD558\uC138\uC694. 60\uCD08 \uAC8C\uC784, \uC138 \uAC00\uC9C0 \uB09C\uC774\uB3C4, \uC5F0\uC18D \uC131\uACF5 \uC810\uC218\uC640 \uB7AD\uD0B9\uC744 \uC9C0\uC6D0\uD569\uB2C8\uB2E4.</p></div>
<details class="site-guide-howto"><summary data-i18n="howto">\uAC8C\uC784 \uBC29\uBC95</summary><p>60\uCD08 \uB3D9\uC548 \uB178\uB780 \uC740\uD589 \uC5F4\uB9E4\uB97C \uD130\uCE58\uD574 \uC810\uC218\uB97C \uC5BB\uC2B5\uB2C8\uB2E4. \uB178\uBA40\uC740 1\xB72\xB73\uC810, \uD558\uB4DC\uB294 2\xB74\xB76\uC810, \uBCA0\uB9AC\uD558\uB4DC\uB294 3\xB76\xB79\uC810\uC73C\uB85C \uC5F0\uC18D \uC131\uACF5 \uC810\uC218\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4. \uCD08\uB85D\uC78E, \uB178\uB780\uC78E \uB610\uB294 \uC369\uC740 \uC740\uD589\uC744 \uD130\uCE58\uD558\uBA74 \uC5F0\uC18D \uC810\uC218\uAC00 \uCD08\uAE30\uD654\uB418\uACE0, \uC369\uC740 \uC740\uD589\uC740 0.5\uCD08 \uB3D9\uC548 \uD130\uCE58\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB178\uBA40\uC740 3\uCD08, \uD558\uB4DC\uB294 2\uCD08, \uBCA0\uB9AC\uD558\uB4DC\uB294 1\uCD08\uB9C8\uB2E4 \uB098\uBB34 \uC0C1\uD0DC\uAC00 \uBCC0\uD569\uB2C8\uB2E4.</p></details>
<nav aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav>
</section>
</footer>
<script type="module" src="/modules/ginkgo/main.js"><\/script>
</body></html>
`,
  "en": `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f8d14f">
<title>Ginkgo Tree Breaker | Pot Breaker Theme 2</title>
<meta name="description" content="Tap the ripe ginkgo fruit before it rots in this free 60-second game. Three difficulty levels, combo scoring and rankings.">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://potbreaker.com/ginkgo/en">
<link rel="alternate" hreflang="ko" href="https://potbreaker.com/ginkgo">
<link rel="alternate" hreflang="en" href="https://potbreaker.com/ginkgo/en">
<link rel="alternate" hreflang="ja" href="https://potbreaker.com/ginkgo/ja">
<link rel="alternate" hreflang="zh-CN" href="https://potbreaker.com/ginkgo/zh">
<link rel="alternate" hreflang="x-default" href="https://potbreaker.com/ginkgo">
<meta property="og:type" content="website">
<meta property="og:url" content="https://potbreaker.com/ginkgo/en">
<meta property="og:title" content="Ginkgo Tree Breaker | Pot Breaker Theme 2">
<meta property="og:description" content="Tap the ripe ginkgo fruit before it rots in this free 60-second game. Three difficulty levels, combo scoring and rankings.">
<meta property="og:locale" content="en_US">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{font-family:system-ui,'Noto Sans KR','Malgun Gothic',sans-serif;color:#342a20;background:#fbe9ad;font-synthesis:none}
*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:radial-gradient(circle at 10% 12%,#fff7cd 0,transparent 34%),radial-gradient(circle at 95% 5%,#bdeed8 0,transparent 28%),linear-gradient(125deg,#ffe58b,#fff3c7 45%,#f4dc8c);background-attachment:fixed}
button,input,select{font:inherit}button{cursor:pointer;touch-action:manipulation}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #1f7d74;outline-offset:3px}
.topbar{z-index:30;display:flex;justify-content:space-between;align-items:center;padding:10px clamp(10px,3vw,32px);position:sticky;top:0;background:#fffbebdb;backdrop-filter:blur(12px);border-bottom:3px solid #644630}
.menu{position:relative}.menu-button,.lang-button{border:2px solid #563b2a;border-radius:15px;background:#fff8d8;box-shadow:0 3px 0 #563b2a;padding:8px 13px;font-weight:900;color:#42321e}
.menu-list{position:absolute;top:calc(100% + 9px);left:0;min-width:245px;background:white;border:3px solid #563b2a;border-radius:14px;padding:8px;box-shadow:0 10px 25px #5f461d4b}
.menu-list a{display:block;margin:4px 0;padding:10px 12px;color:#273858;text-decoration:none;border:1px solid #c2d8ee;border-radius:999px;background:#fffdf8;box-shadow:0 2px 0 #90b4d1;font-weight:900}.menu-list a[aria-current]{background:#fff1b8}
.brand-mini{font-size:12px;font-weight:1000;color:#7b552b;letter-spacing:.02em}.lang-picker{border:2px solid #563b2a;background:#fffdf5;border-radius:12px;padding:9px 12px;font-weight:900;color:#463219}
.container{max-width:1080px;margin:0 auto;padding:clamp(10px,3vw,24px);text-align:center}
.heading{padding:12px 0 18px;position:relative}.heading small{font-weight:1000;letter-spacing:.12em;color:#684727}.heading h1{font-weight:1000;font-size:clamp(33px,7vw,78px);margin:6px 0;line-height:1.13;color:#f7b221;-webkit-text-stroke:2px #51341d;text-shadow:4px 5px 0 #67442c,7px 8px 0 #fff7c0}.heading h1 span{color:#7ec94d}.heading p{font-weight:800;line-height:1.5;margin:12px auto}
.leaves{position:absolute;pointer-events:none;font-size:clamp(30px,6vw,70px);top:4px;left:5%}.leaves.right{left:auto;right:6%;transform:rotate(35deg)}
.surface{background:#fff9de;border:3px solid #503623;box-shadow:0 7px 0 #523826;border-radius:23px;padding:clamp(13px,2.5vw,24px)}
.difficulties{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:16px 0}
.difficulties label{cursor:pointer;display:flex;align-items:center;gap:8px;padding:12px 16px;background:#fff9dc;border:2px solid #6a492e;border-radius:13px;font-weight:1000}
.difficulties label:has(input:checked){background:#a4da5c;box-shadow:inset 0 0 0 2px #305c27}
.action{background:linear-gradient(#9fe16c,#58b74a);color:#1d3920;font-weight:1000;padding:12px 22px;border:3px solid #3b5430;border-radius:16px;box-shadow:0 5px 0 #355d37;margin:5px}
.action.secondary{background:linear-gradient(#fff2b0,#e7bf69);border-color:#745232;box-shadow:0 5px 0 #745232}
.action:disabled{filter:grayscale(1);opacity:.55;cursor:not-allowed}
.comic-title{margin:26px 0 15px;font-size:clamp(18px,3vw,28px);font-weight:1000}
.comics{display:flex;justify-content:center;width:min(100%,800px);margin:16px auto}
.comic{margin:0;width:100%;overflow:hidden;border:4px solid #513421;border-radius:18px;background:#fff6cf;box-shadow:0 6px 0 #63432b}
.comic-image{display:block;width:100%;height:auto;object-fit:contain}
@media(max-width:680px){.comics{width:100%;margin:10px auto}.comic{border-width:2px;border-radius:10px}}
.play-area{padding-top:0}
.hud{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px auto;max-width:880px}
.stat{background:#fffaf0;border:2px solid #634531;border-radius:12px;padding:7px 13px;min-width:78px;font-size:clamp(11px,2.1vw,18px);font-weight:1000}
.stat b{font-size:clamp(18px,3vw,29px)}.stat.time{background:#ffe293}
.board-wrap{width:min(100%,880px);margin:auto;padding:7px;border:4px solid #704722;border-radius:22px;background:linear-gradient(#f6d77e,#d4a862);box-shadow:0 10px 0 #714b2b}
.board{display:grid;grid-template-columns:repeat(13,1fr);gap:3px;aspect-ratio:13/7;touch-action:manipulation}
.cell{border:1px solid #b79b52;position:relative;border-radius:7px;background:linear-gradient(160deg,#fff7c2,#f5de7e);padding:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.cell:after{content:'';position:absolute;bottom:9%;left:25%;right:25%;height:3px;background:#a7824d77;border-radius:50%}
.trunk{position:absolute;bottom:15%;left:46%;height:32%;width:10%;border-radius:3px;background:linear-gradient(90deg,#7b5330,#a98051);z-index:1}
.tree{position:absolute;z-index:2;top:7%;height:64%;width:76%;border:2px solid #516a31;border-radius:60% 60% 41% 41%;box-shadow:0 3px 0 #ffffff65 inset;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:1000}
.tree.leaf0{background:radial-gradient(circle at 40% 30%,#d0f783,#78c34c 70%,#4a9d42)}.tree.leaf1{background:radial-gradient(circle at 40% 30%,#fff5a8,#ffc62f 68%,#d99e22);border-color:#9f6d14}
.tree.fruit2,.tree.fruit3{height:45%;width:47%;top:30%;border-radius:50% 45% 58% 48%;background:radial-gradient(circle at 34% 27%,#fff2aa,#dfaa36 67%,#ba7320);border-color:#8d6a22}
.tree.fruit2:after{content:'\u2022';color:#e8c260;text-shadow:-7px 3px #f8d15b,7px 3px #ffe399;font-size:clamp(9px,2vw,23px)}
.tree.fruit3{background:radial-gradient(circle at 35% 20%,#9f8664,#62503f 74%,#392f29);border-color:#382d25}
.tree.fruit3:after{content:'\xD7';font-size:clamp(12px,2vw,24px);color:#f2d5ac}
.cell:active{transform:scale(.93)}.cell:disabled{cursor:default}
.locked{filter:grayscale(.5)}.lock-message{margin:9px auto;color:#763e22;font-weight:900;min-height:1.8em}
.end-grid{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:16px}
.end-grid .stat{min-width:130px}.nickname{border:2px solid #634531;border-radius:12px;padding:10px 12px;width:min(90%,280px);font-weight:700}
table{border-collapse:collapse;width:100%;font-weight:700}td,th{padding:10px 8px;border-bottom:1px solid #d9bf89;text-align:left}td:nth-child(3),td:nth-child(4),th:nth-child(3),th:nth-child(4){text-align:right}
.status{min-height:1.4em;color:#7e432c;font-weight:800}
.seo-copy{max-width:880px;margin:28px auto 10px;text-align:left;line-height:1.65}.seo-copy h2{font-size:21px}
footer{max-width:880px;margin:24px auto;padding-bottom:15px;display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font-size:13px}footer a{color:#533a26}
[hidden]{display:none!important}
@media(max-width:680px){.comics{grid-template-columns:repeat(2,1fr);gap:7px}.comic{min-height:130px;padding:8px}.comics .art{margin:2px 0}.board{gap:1px}.cell{border-radius:3px}.tree{border-width:1px}.trunk{width:11%}.hud{gap:4px}.stat{min-width:0;padding:5px 7px}.heading h1{-webkit-text-stroke:1.3px #51341d;text-shadow:2px 3px 0 #67442c}.topbar{padding:7px}.brand-mini{display:none}}
@media(max-width:380px){.tree.fruit2:after{display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

/* Theme 2 follows the existing Pot Breaker cover \u2192 comic intro \u2192 game entry flow. */
:root{background:#fae9ab}
body{background:linear-gradient(145deg,#fff6c9 0%,#f6d865 50%,#ffeeb6 100%)}
.cover-screen{width:100%;margin:0 auto}
.cover-frame{position:relative;overflow:hidden;width:min(100%,1080px);margin:8px auto 0;aspect-ratio:16/9;border:4px solid #513421;border-radius:22px;background:#f5d75b;box-shadow:0 9px 0 #63432b}
.cover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.cover-actions{width:min(100%,1080px);margin:14px auto 4px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}
.cover-copy{flex:1 1 100%;text-align:center}.cover-copy small{font-weight:1000;letter-spacing:.1em;color:#674824}.cover-copy h1{font-size:clamp(30px,6vw,68px);line-height:1.08;margin:5px 0;color:#f4bc24;-webkit-text-stroke:2px #51341d;text-shadow:3px 4px 0 #67442c,6px 7px 0 #fff7c0}
.cover-copy h1 span:last-child{color:#80c950}.cover-copy p{font-weight:900;margin:7px 0 3px}
.cover-start{min-width:190px;border-radius:999px;padding:15px 25px;font-size:clamp(17px,2.2vw,24px);background:linear-gradient(#ffe877,#ffbd34);color:#49351d;border-color:#78512a;box-shadow:0 5px 0 #79502a}
.intro-screen{width:100%;min-height:calc(100dvh - 80px);display:flex;align-items:center;justify-content:center}
.intro-layout{width:min(100%,1240px);display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,310px);align-items:center;gap:24px;text-align:left}
.intro-art{margin:0;width:100%;max-height:78dvh;display:grid;place-items:center;overflow:hidden;border-radius:14px;background:#fff8dc}
.intro-comic-image{display:block;width:100%;height:auto;max-height:78dvh;object-fit:contain}
.intro-panel{padding:22px 20px;text-align:left}.episode{margin:0 0 8px;color:#79613b;letter-spacing:.14em;font-size:12px;font-weight:1000}
.intro-panel h1{font-size:clamp(22px,2.4vw,32px);line-height:1.2;margin:7px 0}
.intro-copy{font-weight:800;line-height:1.55}.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:7px;margin:13px 0}
.intro-panel .difficulties label{justify-content:flex-start;padding:9px 10px}
.intro-panel .action{width:100%;margin:7px 0}.intro-panel .action.secondary{font-size:15px;padding:9px}
.intro-help{font-size:12px;line-height:1.5;color:#685638}.intro-panel .status{margin:2px 0}
@media(max-width:760px){.cover-frame{aspect-ratio:1.18/1;border-width:2px;border-radius:13px}.cover-actions{gap:8px}.cover-copy h1{-webkit-text-stroke:1.2px #51341d;text-shadow:2px 3px 0 #67442c}.cover-start{min-width:160px}.intro-screen{align-items:flex-start}.intro-layout{grid-template-columns:1fr;gap:10px}.intro-art{max-height:none}.intro-comic-image{max-height:none}.intro-panel{padding:15px}.intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))}.intro-panel .difficulties label{font-size:11px;gap:4px;padding:8px 5px}}


/* Shared Pot Breaker landscape shell: 16:9 stage, rotated for portrait touch screens. */
html,body{width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
body{background:#83c4f3}
.viewport{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 50% 0%,#dff8ff 0,#a5d9fc 45%,#70b8ee 100%)}
.stage{position:relative;flex:0 0 auto;width:min(100vw,177.778dvh);height:min(100dvh,56.25vw);aspect-ratio:16/9;container-type:size;container-name:game-stage;overflow:hidden;isolation:isolate;background:#f6eedf;box-shadow:0 2vh 7vh #2b467669}
.topbar{position:absolute;z-index:30;left:1.5%;right:1.5%;top:1.5%;height:8%;padding:0 1.2%;display:flex;align-items:center;justify-content:space-between;background:#ffffffdb;border:2px solid #fff;border-radius:16px;box-shadow:0 4px 14px #40577b24}
.topbar .menu-button,.topbar .lang-picker{border:2px solid #bfd7ef;border-radius:12px;background:#fffdf9;color:#303d67;box-shadow:0 3px 0 #9ab5d0;padding:6px 10px}
.topbar .brand-mini{font-size:clamp(7px,1cqw,12px);color:#303d67}
.container{position:absolute;inset:11% 2% 2%;width:96%;max-width:none;height:87%;margin:0;padding:0;overflow:hidden;text-align:center}
.cover-screen,.intro-screen,.play-area,#rankings,#end{position:absolute;inset:0;width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
.cover-screen:not([hidden]),.intro-screen:not([hidden]),.play-area:not([hidden]),#rankings:not([hidden]),#end:not([hidden]){display:flex}
.cover-screen{align-items:center;justify-content:center;gap:3%;padding:2.2%;background:linear-gradient(115deg,#e7f8ff,#b0dffc 64%,#98cafa);border:3px solid white;border-radius:24px}
.cover-frame{order:2;flex:0 0 58%;width:58%;max-width:none;aspect-ratio:16/9;margin:0;border:0;border-radius:16px;box-shadow:0 8px 18px #30456832}
.cover-actions{order:1;flex:1;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;width:auto;gap:2%;margin:0}
.cover-copy{flex:0 1 auto;text-align:left}.cover-copy h1{font-size:clamp(22px,5cqw,64px);color:#303d67;-webkit-text-stroke:0;text-shadow:0 3px 0 #fff,0 7px 12px #40577b25}.cover-copy h1 span:last-child{color:#5578bd}.cover-copy p{font-size:clamp(9px,1.5cqw,18px);line-height:1.35}
.cover-start,.action{border:2px solid #fff;border-radius:999px;color:#fff;background:linear-gradient(145deg,#648ddc,#446ab6);box-shadow:0 5px 0 #38528499;padding:clamp(7px,1.2cqw,14px) clamp(12px,2cqw,24px);font-size:clamp(10px,1.5cqw,20px)}
.action.secondary{color:#303d67;background:#fffdf9;border-color:#bfdbf6;box-shadow:0 4px 0 #9ab5d0}
.intro-screen{align-items:center;justify-content:center;padding:1.5%;background:linear-gradient(115deg,#f1faff,#a7d5f9);border:3px solid white;border-radius:24px}
.intro-layout{width:100%;height:100%;display:grid;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;align-items:center}
.intro-art{width:100%;height:100%;max-height:100%;margin:0;display:grid;place-items:center;overflow:hidden;border:3px solid white;border-radius:14px;background:#fffcf5c9}
.intro-comic-image{width:100%;height:100%;max-height:none;object-fit:contain}
.intro-panel{max-height:100%;overflow:auto;padding:2%;border:2px solid white;border-radius:18px;background:#fffcf5ed;box-shadow:0 5px 14px #456f9530}
.intro-panel h1{font-size:clamp(14px,2.5cqw,30px)}.intro-copy,.intro-help{font-size:clamp(8px,1.2cqw,14px);line-height:1.4}
.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:4px;margin:7px 0}
.intro-panel .difficulties label{font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
.intro-panel .action{width:100%;margin:3px 0}
.play-area{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1%;background:#f3eada;border:3px solid white;border-radius:24px}
.hud{width:min(100%,90cqw);margin:0 auto 1%;gap:1%}.stat{min-width:0;padding:4px 8px;font-size:clamp(9px,1.15cqw,15px)}.stat b{font-size:clamp(12px,1.8cqw,22px)}
.board-wrap{width:100%;height:auto;max-height:none;min-height:0;flex:1 1 auto;padding:.6%;border:3px solid white;border-radius:14px;box-shadow:0 6px 0 #7b694e44}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.3cqw,4px)}
#play #lock-message:empty{display:none}
..seo-copy{display:none}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:fixed;inset:0;width:100vw;height:100dvh;display:block;overflow:hidden}
 .stage{position:absolute;left:50%;top:50%;width:min(100dvh,177.778vw);height:min(100vw,56.25dvh);transform:translate(-50%,-50%) rotate(90deg);transform-origin:center center}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;height:100%}
 .intro-panel{max-height:100%;overflow:auto;padding:2%}
 .intro-panel .difficulties{grid-template-columns:1fr}
 .intro-panel .difficulties label{justify-content:flex-start;font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
}
@media(orientation:landscape) and (pointer:coarse){.viewport{width:100vw;height:100dvh}.stage{width:min(100vw,177.778dvh);height:min(100dvh,56.25vw)}}


/* Pot Breaker visual system: full-screen cover, warm gold CTA, compact floating controls. */
:root{color:#302a27;background:#83c4f3}
body{background:#83c4f3}
.stage{background:#f6eedf}
.topbar{left:1.2%;right:1.2%;top:1.4%;height:8%;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none}
.topbar .menu-button,.topbar .lang-picker{min-height:clamp(28px,5.4cqh,48px);padding:clamp(4px,.8cqw,9px) clamp(8px,1.35cqw,16px);border:2px solid #fff;border-radius:999px;background:#fffdf2;color:#273858;box-shadow:0 4px 0 #9ab5d0,0 6px 13px #18395b38;font-weight:900}
.topbar .brand-mini{color:#fffdf2;font-size:clamp(7px,1cqw,12px);font-weight:1000;letter-spacing:.1em;text-shadow:0 1px 4px #19355c,0 0 7px #19355c}
.menu-list{top:calc(100% + 6px);border:2px solid #c2d8ee;border-radius:18px;background:#fffdf8;box-shadow:0 5px 16px #18395b44}
.container{inset:0;width:100%;height:100%;padding:0}
.cover-screen{display:block!important;padding:0;border:0;border-radius:0;background:#f6eedf}
.cover-frame{position:absolute;inset:0;order:initial;width:100%;height:100%;max-width:none;aspect-ratio:auto;margin:0;border:0;border-radius:0;box-shadow:none;background:#78c6f5}
.cover-image{width:100%;height:100%;object-fit:cover;object-position:center 58%;filter:saturate(1.04)}
.cover-actions{position:absolute;inset:0;order:initial;display:block;width:100%;height:100%;margin:0;pointer-events:none}
.cover-copy{position:absolute;left:12%;right:12%;top:9%;text-align:center;pointer-events:none}
.cover-copy small{display:inline-block;margin-bottom:.3%;padding:.25em .8em;border-radius:999px;color:#fff9df;background:#453527b8;font-size:clamp(8px,1.15cqw,14px);font-weight:1000;letter-spacing:.12em;text-shadow:none}
.cover-copy h1{margin:0;color:#f4cf70;font-family:"Gungsuh","\uAD81\uC11C","\uAD81\uC11C\uCCB4","Nanum Myeongjo","Batang",serif;font-size:clamp(28px,7.1cqw,86px);font-weight:700;line-height:1.08;letter-spacing:.025em;-webkit-text-stroke:clamp(3px,.65cqw,8px) #050403;paint-order:stroke fill;text-shadow:0 3px 10px #1d2b3f99}
.cover-copy h1 span:last-child{color:inherit}
.cover-copy p{display:none}
.cover-start,.action{pointer-events:auto;border:3px solid #583a22;border-radius:999px;color:#302b31;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%);box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360;padding:clamp(8px,1.4cqw,16px) clamp(20px,3.4cqw,42px);font-weight:1000;text-shadow:0 1px #fff8d8;transition:transform .12s,filter .12s}
.cover-start:hover,.action:hover{filter:brightness(1.04);transform:translateY(-1px)}
.site-info-links [class^="info-"]{display:none}html[lang="ko"] .site-info-links .info-ko,html[lang="en"] .site-info-links .info-en,html[lang="zh"] .site-info-links .info-zh,html[lang="ja"] .site-info-links .info-ja{display:inline}
.intro-screen{padding:2%;border:0;border-radius:0;background:linear-gradient(145deg,#a8dcfb,#77bdf0)}
.intro-layout{width:100%;height:100%;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
.intro-art{border:3px solid #fff;border-radius:18px;background:#f6eedf;box-shadow:0 5px 0 #6489a355}
.intro-panel{padding:2.1%;border:2px solid #fff;border-radius:20px;background:#fffdf7;box-shadow:0 5px 0 #6489a355,0 9px 20px #385b7824;color:#302a27}
.intro-panel .episode{color:#795529}
.intro-panel .action{min-height:clamp(28px,5.5cqh,50px)}
.intro-panel .action.secondary{color:#273858;background:#fffdf7;border:2px solid #c2d8ee;box-shadow:0 3px 0 #90b4d1}
.play-area{inset:1.5%;width:97%;height:97%;padding:1%;border:3px solid #fff;border-radius:22px;background:#f3eada;box-shadow:0 5px 0 #6f5e4840}
/* Floating, non-layout feedback for the brief rotten-fruit input lock. */
.tree.fruit2{border:clamp(2px,.3cqw,4px) solid #e6403b;box-shadow:0 0 0 1px #fff6dd,0 3px 0 #ffffff65 inset,0 2px 4px #572a2344}
.play-area .lock-message{position:absolute;z-index:30;top:10%;left:50%;width:max-content;max-width:82%;margin:0;padding:6px 12px;border:1px solid #fff8e7;border-radius:999px;background:#2d3340df;color:#fff5d6;box-shadow:0 4px 12px #2a283244;font-size:clamp(9px,1.15cqw,14px);font-weight:900;text-align:center;opacity:0;visibility:hidden;transform:translate(-50%,-6px);pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s}
.play-area .lock-message.is-visible{opacity:1;visibility:visible;transform:translate(-50%,0)}

.hud{width:100%;max-width:none;margin:8% auto 1%;gap:1%}
.board-wrap{flex:1 1 0;width:100%;height:auto;max-height:none;min-height:0;padding:.55%;border:3px solid #fff;border-radius:16px;background:linear-gradient(135deg,#f8df82,#dcae58);box-shadow:0 5px 0 #6f5e4844}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.32cqw,4px)}
#rankings:not([hidden]),#end:not([hidden]){display:block;inset:3%;width:94%;height:94%;padding:10% 3% 3%;overflow:auto;border:3px solid #fff;border-radius:22px;background:#fffdf7;box-shadow:0 5px 0 #6f5e4844}
#rankings h1,#end h1{color:#303d67}
@media(orientation:portrait) and (pointer:coarse){
 .topbar{left:1.2%;right:1.2%;top:1.4%;height:8%}
 .container{inset:0;width:100%;height:100%}
 .cover-image{object-position:center 58%}
 .cover-copy{top:8%;left:8%;right:8%}
 .cover-copy h1{font-size:clamp(28px,7.1cqw,86px)}

 .play-area{inset:1.5%;width:97%;height:97%}
 .hud{margin-top:8%}
 .intro-screen{padding:2%}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
}

/* Shared Pot Breaker home controls. Keep these anchors identical in both modes. */
:root{--pb-home-gold:#ffd35c;--pb-home-blue:#303d67;--pb-home-outline:#5c4222;--pb-home-shadow:#9ab8d0}
#pb-game-mode{position:fixed;top:9px;left:9px;z-index:50;pointer-events:auto;font:900 12px/1.3 system-ui,sans-serif;color:#343027}
#pb-game-mode summary{display:flex;align-items:center;gap:6px;min-height:28px;box-sizing:border-box;cursor:pointer;list-style:none;background:#fff7d8f5;border:2px solid #6c482f;border-radius:12px;padding:7px 10px;box-shadow:0 3px 0 #765436}
#pb-game-mode summary::-webkit-details-marker{display:none}
#pb-game-mode nav{position:absolute;top:calc(100% + 8px);left:0;display:grid;width:max-content;min-width:185px;box-sizing:border-box;background:#fffced;border:2px solid #6c482f;border-radius:12px;margin:0;padding:6px;box-shadow:0 9px 22px #32201059}
#title .home-start,.cover-actions .home-start--visible{position:absolute;left:36.6%;top:39.4%;width:26.8%;height:11%;display:flex!important;align-items:center;justify-content:center;gap:.5em;box-sizing:border-box;margin:0!important;padding:0!important;border:3px solid var(--pb-home-outline)!important;border-radius:999px;color:#302b31!important;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%)!important;box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(16px,2cqw,22px)!important;font-weight:1000;line-height:1;text-shadow:0 1px #fff8d8;white-space:nowrap;z-index:9}
#title .home-start{cursor:pointer}
#title .home-start:hover{transform:none!important}
#title .home-start::before,.cover-actions .home-start--visible::before{content:"";flex:0 0 auto;width:0;height:0;border-top:.48em solid transparent;border-bottom:.48em solid transparent;border-left:.72em solid #242329;filter:drop-shadow(1px 1px 0 #fff8d8)}
.cover-actions .home-start--visible{pointer-events:auto;transform:none}
.cover-actions .home-start--visible:hover{filter:brightness(1.04);transform:none}
#title .home-ranking,.cover-actions .home-ranking{position:absolute;left:3%;bottom:3%;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;width:clamp(96px,9cqw,108px);min-width:clamp(96px,9cqw,108px);height:40px;margin:0;padding:7px 12px;border:2px solid #fff;border-radius:999px;color:var(--pb-home-blue);background:#fffdf2;box-shadow:0 4px 0 var(--pb-home-shadow),0 6px 13px #18395b38;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:12px;font-weight:1000;line-height:1;white-space:nowrap;pointer-events:auto}
.game-switch{position:absolute!important;z-index:5;left:4%!important;bottom:calc(4% + 54px)!important;display:flex!important;align-items:center;justify-content:center;width:clamp(168px,22cqw,226px)!important;height:42px!important;box-sizing:border-box;padding:0 12px!important;border:2px solid #fff!important;border-radius:999px!important;color:#35456d!important;background:#fffdf0e8!important;box-shadow:0 5px 14px #35456535!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(10px,1.05cqw,14px)!important;font-weight:1000!important;line-height:1!important;text-align:center;text-decoration:none;white-space:nowrap;pointer-events:auto}
.site-info-links{position:absolute!important;z-index:12;right:calc(2.2% + clamp(92px,15cqw,200px))!important;bottom:calc(2.4% + 38px)!important;display:flex!important;align-items:center;justify-content:flex-end;gap:clamp(4px,.7cqw,9px);pointer-events:auto}
.site-info-links a{display:inline-flex;align-items:center;justify-content:center;min-height:clamp(24px,3.6cqw,36px);box-sizing:border-box;padding:4px clamp(7px,1cqw,12px);border:1px solid #fff;border-radius:999px;background:#fffdf0e8;color:#35456d;box-shadow:0 3px 9px #35456530;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:clamp(8px,.95cqw,12px);font-weight:900;line-height:1;text-decoration:none;white-space:nowrap}
#pb-game-mode summary,.topbar .menu-button{min-height:28px;padding:7px 10px;border:2px solid #6c482f;border-radius:12px;background:#fff7d8f5;color:#343027;box-shadow:0 3px 0 #765436;font:900 12px/1.3 system-ui,sans-serif}
.menu-list{min-width:185px;margin-top:8px;padding:6px;border:2px solid #6c482f;border-radius:12px;background:#fffced;box-shadow:0 9px 22px #32201059}
#pb-game-mode nav a,.menu-list a{display:block;margin:0;padding:10px;border:0;border-radius:7px;background:transparent;color:#3f3226;box-shadow:none;font-weight:900;text-decoration:none}
#pb-game-mode nav a:hover,#pb-game-mode nav a:focus-visible,.menu-list a:hover,.menu-list a:focus-visible{background:#f8e5a4}
.menu .locale-control{right:1.2%!important;top:1.4%!important;bottom:auto!important}
.topbar .lang-picker{position:absolute;top:0;right:0}
.locale-control select,.topbar .lang-picker{box-sizing:border-box;max-width:104px;min-height:clamp(28px,5.4cqh,40px);padding:4px 20px 4px 9px;border:1px solid #ffffffed;border-radius:999px;background:#fffef4;color:#293b60;font:700 clamp(9px,1cqw,12px)/1.2 system-ui,sans-serif;box-shadow:0 2px 7px #34486b36;touch-action:manipulation}
.locale-control select:focus-visible,.topbar .lang-picker:focus-visible{outline:3px solid #f0bd48;outline-offset:2px}

#pb-game-mode .mode-label,#pb-game-mode .mode-pot,#pb-game-mode .mode-ginkgo{display:none}
html[lang="ko"] #pb-game-mode .mode-label-ko,html[lang="ko"] #pb-game-mode .mode-pot-ko,html[lang="ko"] #pb-game-mode .mode-ginkgo-ko{display:inline}
html[lang="en"] #pb-game-mode .mode-label-en,html[lang="en"] #pb-game-mode .mode-pot-en,html[lang="en"] #pb-game-mode .mode-ginkgo-en{display:inline}
html[lang="ja"] #pb-game-mode .mode-label-ja,html[lang="ja"] #pb-game-mode .mode-pot-ja,html[lang="ja"] #pb-game-mode .mode-ginkgo-ja{display:inline}
html[lang="zh"] #pb-game-mode .mode-label-zh,html[lang="zh"] #pb-game-mode .mode-pot-zh,html[lang="zh"] #pb-game-mode .mode-ginkgo-zh{display:inline}
#pb-game-mode nav a[aria-current="page"]{background:#f8e5a4}
.topbar{justify-content:flex-end}
/* Shared footer and 16:9 stage sizing for Pot Breaker and Ginkgo Tree Breaker. */
:root{--pb-footer-h:clamp(72px,9vh,104px)}
html,body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}
body{min-height:100dvh!important}
.viewport{position:relative!important;inset:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:280px;box-sizing:border-box;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;background:linear-gradient(135deg,#c8e8ff,#9acaf6)!important}
.stage{position:relative!important;left:auto!important;top:auto!important;flex:0 0 auto!important;width:min(100vw,calc((100dvh - var(--pb-footer-h))*1.77778))!important;height:min(calc(100dvh - var(--pb-footer-h)),56.25vw)!important;transform:none!important;margin:auto!important}
.site-footer{position:relative;z-index:50;width:100%;max-width:none!important;min-height:var(--pb-footer-h);box-sizing:border-box;display:grid;place-items:center;margin:0!important;padding:8px clamp(12px,2vw,28px);background:linear-gradient(100deg,#dff5ff,#b9e0fa 55%,#99cdf2);border-top:1px solid #ffffffc7;color:#293b60}
.site-guide{width:min(100%,1280px);display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:clamp(8px,1.6vw,22px)}
.site-guide-copy h1,.site-guide-copy h2{margin:0 0 3px;font-size:clamp(11px,1.15vw,16px);line-height:1.2}.site-guide-copy p{margin:0;font-size:clamp(9px,.9vw,12px);line-height:1.35}
.site-guide-howto{position:relative;font-size:clamp(9px,.9vw,12px)}.site-guide-howto summary{cursor:pointer;font-weight:800;white-space:nowrap}.site-guide-howto p{max-width:min(55vw,520px);margin:6px 0 0}
.site-guide nav{display:flex;gap:clamp(6px,1vw,14px);flex-wrap:wrap;justify-content:flex-end;font-size:clamp(9px,.9vw,12px)}.site-guide a{color:#244e70;text-underline-offset:2px}
/* Keep shared navigation and legal links out of the active playfield. */
body.is-playing{--pb-footer-h:0px!important}
body.is-playing #home,body.is-playing #title,body.is-playing #pb-game-mode,body.is-playing .topbar,body.is-playing .game-switch,body.is-playing .site-info-links,body.is-playing .site-footer{display:none!important}
body.is-ginkgo-subview #home,body.is-ginkgo-subview .game-switch,body.is-pot-subview #title,body.is-pot-subview .game-switch,body.is-pot-subview .site-info-links{display:none!important}
@media(max-width:700px){:root{--pb-footer-h:clamp(96px,16vh,136px)}.site-guide{grid-template-columns:minmax(0,1fr);align-items:start;gap:5px}.site-guide-copy{grid-column:auto}.site-guide-copy h1,.site-guide-copy h2{font-size:12px}.site-guide-copy p{font-size:10px;line-height:1.3}.site-guide nav{justify-content:flex-start;font-size:10px}.site-guide-howto{font-size:10px}.site-guide-howto p{max-width:90vw}}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:relative!important;inset:auto!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:220px!important;width:100vw!important;display:block!important;overflow:hidden!important}
 .stage{position:relative!important;left:auto!important;top:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;transform:none!important;transform-origin:center center!important;margin:0!important;aspect-ratio:auto!important;border-radius:0!important}
 body.is-playing .viewport{position:fixed!important;inset:0!important;height:100dvh!important}
 body.is-playing .stage{position:absolute!important;left:50%!important;top:50%!important;width:min(100dvh,177.778vw)!important;height:min(100vw,56.25dvh)!important;transform:translate(-50%,-50%) rotate(90deg)!important}
 #title .home-start,.cover-actions .home-start--visible{left:50%!important;top:40.5%!important;width:min(82%,320px)!important;height:clamp(52px,9vh,70px)!important;transform:translateX(-50%)!important;font-size:clamp(17px,5vw,22px)!important}
 #title .home-ranking,.cover-actions .home-ranking{left:50%!important;bottom:3%!important;transform:translateX(-50%)!important}
 .game-switch{left:50%!important;bottom:calc(3% + 46px)!important;width:min(82%,260px)!important;transform:translateX(-50%)!important}
 .site-info-links{right:50%!important;bottom:2%!important;transform:translateX(50%)!important;gap:5px!important}
 .site-info-links a{font-size:10px!important}
 #intro{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,1fr) auto!important;gap:8px!important;padding:56px 12px 12px!important}
 #intro>.comic-cover-wrap{height:40vh!important;max-height:40vh!important;min-height:0!important}
 #intro>.intro-side{height:auto!important;max-height:calc(100% - 40vh - 8px)!important;min-height:clamp(220px,34vh,280px)!important;overflow:auto!important;align-items:stretch!important;gap:8px!important;padding:10px!important}
 #intro .difficulty-picker{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 #intro .difficulty-picker span{grid-column:1/-1!important}
 #intro .intro-side h2{font-size:clamp(18px,5vw,26px)!important}
 #intro .intro-side p,#intro .intro-side small{font-size:12px!important}
 #home .cover-frame{width:100%!important;height:100%!important;max-width:none!important;aspect-ratio:auto!important}
 #home .cover-image{object-fit:cover!important;object-position:center 50%!important}
 .intro-layout{width:100%!important;height:100%!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,32vh) minmax(0,1fr)!important;gap:8px!important;padding:56px 10px 10px!important}
 .intro-art{height:100%!important;max-height:32vh!important;min-height:0!important}
 .intro-comic-image{width:100%!important;height:100%!important;object-fit:contain!important}
 .intro-panel{height:auto!important;min-height:clamp(250px,36vh,300px)!important;max-height:calc(100% - 32vh - 8px)!important;overflow:auto!important;padding:12px!important}
 .intro-panel h1{font-size:clamp(18px,5vw,26px)!important}
 .intro-panel .intro-copy,.intro-panel .intro-help{font-size:12px!important}
 .intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 .intro-panel .difficulties label{font-size:10px!important;padding:8px 4px!important}
 .intro-panel .action{min-height:44px!important}
 .play-area{inset:1.5%!important;width:97%!important;height:97%!important}
 .hud{margin-top:clamp(50px,8vh,76px)!important}
}

</style>
</head>
<body>
<div class="viewport"><div class="stage" id="ginkgo-stage">
<header class="topbar">
<select id="language" class="lang-picker" aria-label="Language"><option value="ko">\uD55C\uAD6D\uC5B4</option><option value="en">English</option><option value="ja">\u65E5\u672C\u8A9E</option><option value="zh">\u4E2D\u6587</option></select>
</header>
<main class="container">
<section id="home" class="cover-screen">
<div class="cover-frame">
<img class="cover-image" src="{{COVER_IMAGE}}" alt="Gimyo and Manager Keuda looking down a golden ginkgo avenue" width="995" height="560" decoding="async" fetchpriority="high">
</div>
<div class="cover-actions">
<div class="cover-copy"><small data-i18n="theme">\uD3FF \uBE0C\uB808\uC774\uCEE4 \uD14C\uB9C8 2</small><h1><span data-i18n="title1">\uAE45\uCF54\uD2B8\uB9AC</span> <span data-i18n="title2">\uBE0C\uB808\uC774\uCEE4!</span></h1><p data-i18n="subtitle">\uB9CE\uC774 \uBF51\uC744\uC218\uB85D \uC88B\uC740 \uAC74\uAC00...? \uC369\uAE30 \uC804\uC5D0 \uC740\uD589\uC744 \uD130\uCE58\uD574 \uC810\uC218\uB97C \uC62C\uB9AC\uC138\uC694!</p></div>
<button class="action cover-start home-start home-start--visible" id="open-intro" data-i18n="open">\uAC8C\uC784 \uC2DC\uC791</button>
<button class="action secondary home-ranking" id="ranks-from-home" data-i18n="home_ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</button><a class="game-switch" id="potbreaker-link" href="/"><span data-i18n="pot">\u{1FAB4} \uD3FF\uBE0C\uB808\uC774\uCEE4 RE</span></a>
</div>
<nav class="site-info-links" aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav></section>
<section id="intro" class="intro-screen" hidden>
<div class="intro-layout">
<figure class="intro-art"><img class="intro-comic-image" src="{{COMIC_IMAGE}}" alt="Four-panel comic showing Gimyo's commute and the ginkgo tree removal job" width="600" height="600" decoding="async" fetchpriority="high"></figure>
<aside class="intro-panel surface">
<p class="episode">EP.02 / GINKGO TREE BREAKER</p>
<h1 data-i18n="intro_title">\uAE30\uBB18\uC758 \uC774\uC0C1\uD55C \uCD9C\uADFC\uAE38</h1>
<p class="intro-copy" data-i18n="intro_copy">\uC740\uD589\uC774 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD574 \uC5C6\uC560\uC138\uC694. 60\uCD08 \uB3D9\uC548 \uC810\uC218\uB97C \uBAA8\uC544 \uB7AD\uD0B9\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4.</p>
<div class="difficulties">
<label><input type="radio" name="difficulty" value="normal" checked> NORMAL <small>3s</small></label>
<label><input type="radio" name="difficulty" value="hard"> HARD <small>2s</small></label>
<label><input type="radio" name="difficulty" value="very_hard"> VERY HARD <small>1s</small></label>
</div>
<button class="action cover-start" id="begin" data-i18n="enter">\uC740\uD589\uB098\uBB34\uB85C \uCD9C\uADFC \u25B6</button>
<button class="action secondary" id="intro-back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
<p class="intro-help" data-i18n="intro_help">\uB178\uB780 \uC740\uD589\uB9CC \uD130\uCE58\uD558\uC138\uC694. \uC78E\uC740 \uCF64\uBCF4\uB97C \uB04A\uACE0, \uC369\uC740 \uC740\uD589\uC740 0.5\uCD08 \uB3D9\uC548 \uC785\uB825\uC744 \uB9C9\uC2B5\uB2C8\uB2E4.</p>
<p class="status" id="begin-status" aria-live="polite"></p>
</aside>
</div>
</section>
<section id="play" class="play-area" hidden aria-label="Ginkgo Tree Breaker game">
<div class="hud"><div class="stat">\u{1F3C6} <span data-i18n="score">\uC810\uC218</span> <b id="score">0</b></div><div class="stat time">\u23F1\uFE0F <b id="timer">60.0</b>s</div><div class="stat">\u{1F525} <span data-i18n="combo">\uC5F0\uC18D</span> <b id="combo">0</b></div></div>
<div class="board-wrap"><div id="board" class="board" role="group" aria-label="Ginkgo trees"></div></div>
<p id="lock-message" class="lock-message" aria-live="polite"></p>
</section>
<section id="end" class="surface" hidden>
<h2 data-i18n="finished">60\uCD08 \uC885\uB8CC!</h2><div class="end-grid"><div class="stat"><span data-i18n="score">\uC810\uC218</span><br><b id="final-score">0</b></div><div class="stat"><span data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</span><br><b id="final-combo">0</b></div></div>
<label for="nickname" data-i18n="name">\uB7AD\uD0B9\uC5D0 \uD45C\uC2DC\uD560 \uB2C9\uB124\uC784</label><br><input class="nickname" maxlength="16" id="nickname" autocomplete="nickname" placeholder="Gimyo">
<div><button class="action" id="submit" data-i18n="submit">\uB7AD\uD0B9 \uB4F1\uB85D</button><button class="action secondary" id="retry" data-i18n="retry">\uB2E4\uC2DC \uC2DC\uC791</button></div>
<p id="result-status" class="status" aria-live="polite"></p>
</section>
<section id="rankings" class="surface" hidden>
<h2 data-i18n="ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</h2><p data-i18n="ranking_info">\uC810\uC218 \uC6B0\uC120 \xB7 \uB3D9\uC810 \uC2DC \uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5 \xB7 1~3\uC704 \uC601\uAD6C \uBCF4\uAD00 / 4\uC704 \uC774\uD558 \uB9E4\uC6D4 1\uC77C \uC0AD\uC81C</p>
<select id="rank-difficulty" class="lang-picker"><option value="normal">NORMAL</option><option value="hard">HARD</option><option value="very_hard">VERY HARD</option></select>
<div style="overflow-x:auto"><table><thead><tr><th data-i18n="place">\uC21C\uC704</th><th data-i18n="player">\uD50C\uB808\uC774\uC5B4</th><th data-i18n="score">\uC810\uC218</th><th data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</th></tr></thead><tbody id="ranking-rows"></tbody></table></div>
<p id="rank-status" class="status" aria-live="polite"></p><button class="action secondary" id="back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
</section>
</main></div></div>
<footer class="site-footer" id="site-footer">
<section class="site-guide" aria-labelledby="ginkgo-guide-heading">
<div class="site-guide-copy"><h2 id="ginkgo-guide-heading">How to play Ginkgo Tree Breaker</h2><p>Tap the ripe ginkgo fruit before it rots in this free 60-second game. Three difficulty levels, combo scoring and rankings.</p></div>
<details class="site-guide-howto"><summary data-i18n="howto">\uAC8C\uC784 \uBC29\uBC95</summary><p>Tap yellow ginkgo fruit in 60 seconds to earn points. Consecutive combo points are 1, 2, 3 on Normal; 2, 4, 6 on Hard; and 3, 6, 9 on Very Hard. Tapping leaves or rotten fruit resets your combo, and rotten fruit locks taps for 0.5 seconds. Tree phases advance every 3, 2 or 1 seconds based on difficulty.</p></details>
<nav aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav>
</section>
</footer>
<script type="module" src="/modules/ginkgo/main.js"><\/script>
</body></html>
`,
  "ja": `<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f8d14f">
<title>\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC | \u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC \u30C6\u30FC\u30DE2</title>
<meta name="description" content="60\u79D2\u9593\u3067\u8150\u308B\u524D\u306E\u30AE\u30F3\u30CA\u30F3\u3092\u30BF\u30C3\u30D7\u3002\u30CE\u30FC\u30DE\u30EB\u30FB\u30CF\u30FC\u30C9\u30FB\u30D9\u30EA\u30FC\u30CF\u30FC\u30C9\u3001\u9023\u7D9A\u6210\u529F\u30B9\u30B3\u30A2\u3068\u30E9\u30F3\u30AD\u30F3\u30B0\u3002">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://potbreaker.com/ginkgo/ja">
<link rel="alternate" hreflang="ko" href="https://potbreaker.com/ginkgo">
<link rel="alternate" hreflang="en" href="https://potbreaker.com/ginkgo/en">
<link rel="alternate" hreflang="ja" href="https://potbreaker.com/ginkgo/ja">
<link rel="alternate" hreflang="zh-CN" href="https://potbreaker.com/ginkgo/zh">
<link rel="alternate" hreflang="x-default" href="https://potbreaker.com/ginkgo">
<meta property="og:type" content="website">
<meta property="og:url" content="https://potbreaker.com/ginkgo/ja">
<meta property="og:title" content="\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC | \u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC \u30C6\u30FC\u30DE2">
<meta property="og:description" content="60\u79D2\u9593\u3067\u8150\u308B\u524D\u306E\u30AE\u30F3\u30CA\u30F3\u3092\u30BF\u30C3\u30D7\u3002\u30CE\u30FC\u30DE\u30EB\u30FB\u30CF\u30FC\u30C9\u30FB\u30D9\u30EA\u30FC\u30CF\u30FC\u30C9\u3001\u9023\u7D9A\u6210\u529F\u30B9\u30B3\u30A2\u3068\u30E9\u30F3\u30AD\u30F3\u30B0\u3002">
<meta property="og:locale" content="ja_JP">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{font-family:system-ui,'Noto Sans KR','Malgun Gothic',sans-serif;color:#342a20;background:#fbe9ad;font-synthesis:none}
*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:radial-gradient(circle at 10% 12%,#fff7cd 0,transparent 34%),radial-gradient(circle at 95% 5%,#bdeed8 0,transparent 28%),linear-gradient(125deg,#ffe58b,#fff3c7 45%,#f4dc8c);background-attachment:fixed}
button,input,select{font:inherit}button{cursor:pointer;touch-action:manipulation}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #1f7d74;outline-offset:3px}
.topbar{z-index:30;display:flex;justify-content:space-between;align-items:center;padding:10px clamp(10px,3vw,32px);position:sticky;top:0;background:#fffbebdb;backdrop-filter:blur(12px);border-bottom:3px solid #644630}
.menu{position:relative}.menu-button,.lang-button{border:2px solid #563b2a;border-radius:15px;background:#fff8d8;box-shadow:0 3px 0 #563b2a;padding:8px 13px;font-weight:900;color:#42321e}
.menu-list{position:absolute;top:calc(100% + 9px);left:0;min-width:245px;background:white;border:3px solid #563b2a;border-radius:14px;padding:8px;box-shadow:0 10px 25px #5f461d4b}
.menu-list a{display:block;margin:4px 0;padding:10px 12px;color:#273858;text-decoration:none;border:1px solid #c2d8ee;border-radius:999px;background:#fffdf8;box-shadow:0 2px 0 #90b4d1;font-weight:900}.menu-list a[aria-current]{background:#fff1b8}
.brand-mini{font-size:12px;font-weight:1000;color:#7b552b;letter-spacing:.02em}.lang-picker{border:2px solid #563b2a;background:#fffdf5;border-radius:12px;padding:9px 12px;font-weight:900;color:#463219}
.container{max-width:1080px;margin:0 auto;padding:clamp(10px,3vw,24px);text-align:center}
.heading{padding:12px 0 18px;position:relative}.heading small{font-weight:1000;letter-spacing:.12em;color:#684727}.heading h1{font-weight:1000;font-size:clamp(33px,7vw,78px);margin:6px 0;line-height:1.13;color:#f7b221;-webkit-text-stroke:2px #51341d;text-shadow:4px 5px 0 #67442c,7px 8px 0 #fff7c0}.heading h1 span{color:#7ec94d}.heading p{font-weight:800;line-height:1.5;margin:12px auto}
.leaves{position:absolute;pointer-events:none;font-size:clamp(30px,6vw,70px);top:4px;left:5%}.leaves.right{left:auto;right:6%;transform:rotate(35deg)}
.surface{background:#fff9de;border:3px solid #503623;box-shadow:0 7px 0 #523826;border-radius:23px;padding:clamp(13px,2.5vw,24px)}
.difficulties{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:16px 0}
.difficulties label{cursor:pointer;display:flex;align-items:center;gap:8px;padding:12px 16px;background:#fff9dc;border:2px solid #6a492e;border-radius:13px;font-weight:1000}
.difficulties label:has(input:checked){background:#a4da5c;box-shadow:inset 0 0 0 2px #305c27}
.action{background:linear-gradient(#9fe16c,#58b74a);color:#1d3920;font-weight:1000;padding:12px 22px;border:3px solid #3b5430;border-radius:16px;box-shadow:0 5px 0 #355d37;margin:5px}
.action.secondary{background:linear-gradient(#fff2b0,#e7bf69);border-color:#745232;box-shadow:0 5px 0 #745232}
.action:disabled{filter:grayscale(1);opacity:.55;cursor:not-allowed}
.comic-title{margin:26px 0 15px;font-size:clamp(18px,3vw,28px);font-weight:1000}
.comics{display:flex;justify-content:center;width:min(100%,800px);margin:16px auto}
.comic{margin:0;width:100%;overflow:hidden;border:4px solid #513421;border-radius:18px;background:#fff6cf;box-shadow:0 6px 0 #63432b}
.comic-image{display:block;width:100%;height:auto;object-fit:contain}
@media(max-width:680px){.comics{width:100%;margin:10px auto}.comic{border-width:2px;border-radius:10px}}
.play-area{padding-top:0}
.hud{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px auto;max-width:880px}
.stat{background:#fffaf0;border:2px solid #634531;border-radius:12px;padding:7px 13px;min-width:78px;font-size:clamp(11px,2.1vw,18px);font-weight:1000}
.stat b{font-size:clamp(18px,3vw,29px)}.stat.time{background:#ffe293}
.board-wrap{width:min(100%,880px);margin:auto;padding:7px;border:4px solid #704722;border-radius:22px;background:linear-gradient(#f6d77e,#d4a862);box-shadow:0 10px 0 #714b2b}
.board{display:grid;grid-template-columns:repeat(13,1fr);gap:3px;aspect-ratio:13/7;touch-action:manipulation}
.cell{border:1px solid #b79b52;position:relative;border-radius:7px;background:linear-gradient(160deg,#fff7c2,#f5de7e);padding:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.cell:after{content:'';position:absolute;bottom:9%;left:25%;right:25%;height:3px;background:#a7824d77;border-radius:50%}
.trunk{position:absolute;bottom:15%;left:46%;height:32%;width:10%;border-radius:3px;background:linear-gradient(90deg,#7b5330,#a98051);z-index:1}
.tree{position:absolute;z-index:2;top:7%;height:64%;width:76%;border:2px solid #516a31;border-radius:60% 60% 41% 41%;box-shadow:0 3px 0 #ffffff65 inset;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:1000}
.tree.leaf0{background:radial-gradient(circle at 40% 30%,#d0f783,#78c34c 70%,#4a9d42)}.tree.leaf1{background:radial-gradient(circle at 40% 30%,#fff5a8,#ffc62f 68%,#d99e22);border-color:#9f6d14}
.tree.fruit2,.tree.fruit3{height:45%;width:47%;top:30%;border-radius:50% 45% 58% 48%;background:radial-gradient(circle at 34% 27%,#fff2aa,#dfaa36 67%,#ba7320);border-color:#8d6a22}
.tree.fruit2:after{content:'\u2022';color:#e8c260;text-shadow:-7px 3px #f8d15b,7px 3px #ffe399;font-size:clamp(9px,2vw,23px)}
.tree.fruit3{background:radial-gradient(circle at 35% 20%,#9f8664,#62503f 74%,#392f29);border-color:#382d25}
.tree.fruit3:after{content:'\xD7';font-size:clamp(12px,2vw,24px);color:#f2d5ac}
.cell:active{transform:scale(.93)}.cell:disabled{cursor:default}
.locked{filter:grayscale(.5)}.lock-message{margin:9px auto;color:#763e22;font-weight:900;min-height:1.8em}
.end-grid{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:16px}
.end-grid .stat{min-width:130px}.nickname{border:2px solid #634531;border-radius:12px;padding:10px 12px;width:min(90%,280px);font-weight:700}
table{border-collapse:collapse;width:100%;font-weight:700}td,th{padding:10px 8px;border-bottom:1px solid #d9bf89;text-align:left}td:nth-child(3),td:nth-child(4),th:nth-child(3),th:nth-child(4){text-align:right}
.status{min-height:1.4em;color:#7e432c;font-weight:800}
.seo-copy{max-width:880px;margin:28px auto 10px;text-align:left;line-height:1.65}.seo-copy h2{font-size:21px}
footer{max-width:880px;margin:24px auto;padding-bottom:15px;display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font-size:13px}footer a{color:#533a26}
[hidden]{display:none!important}
@media(max-width:680px){.comics{grid-template-columns:repeat(2,1fr);gap:7px}.comic{min-height:130px;padding:8px}.comics .art{margin:2px 0}.board{gap:1px}.cell{border-radius:3px}.tree{border-width:1px}.trunk{width:11%}.hud{gap:4px}.stat{min-width:0;padding:5px 7px}.heading h1{-webkit-text-stroke:1.3px #51341d;text-shadow:2px 3px 0 #67442c}.topbar{padding:7px}.brand-mini{display:none}}
@media(max-width:380px){.tree.fruit2:after{display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

/* Theme 2 follows the existing Pot Breaker cover \u2192 comic intro \u2192 game entry flow. */
:root{background:#fae9ab}
body{background:linear-gradient(145deg,#fff6c9 0%,#f6d865 50%,#ffeeb6 100%)}
.cover-screen{width:100%;margin:0 auto}
.cover-frame{position:relative;overflow:hidden;width:min(100%,1080px);margin:8px auto 0;aspect-ratio:16/9;border:4px solid #513421;border-radius:22px;background:#f5d75b;box-shadow:0 9px 0 #63432b}
.cover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.cover-actions{width:min(100%,1080px);margin:14px auto 4px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}
.cover-copy{flex:1 1 100%;text-align:center}.cover-copy small{font-weight:1000;letter-spacing:.1em;color:#674824}.cover-copy h1{font-size:clamp(30px,6vw,68px);line-height:1.08;margin:5px 0;color:#f4bc24;-webkit-text-stroke:2px #51341d;text-shadow:3px 4px 0 #67442c,6px 7px 0 #fff7c0}
.cover-copy h1 span:last-child{color:#80c950}.cover-copy p{font-weight:900;margin:7px 0 3px}
.cover-start{min-width:190px;border-radius:999px;padding:15px 25px;font-size:clamp(17px,2.2vw,24px);background:linear-gradient(#ffe877,#ffbd34);color:#49351d;border-color:#78512a;box-shadow:0 5px 0 #79502a}
.intro-screen{width:100%;min-height:calc(100dvh - 80px);display:flex;align-items:center;justify-content:center}
.intro-layout{width:min(100%,1240px);display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,310px);align-items:center;gap:24px;text-align:left}
.intro-art{margin:0;width:100%;max-height:78dvh;display:grid;place-items:center;overflow:hidden;border-radius:14px;background:#fff8dc}
.intro-comic-image{display:block;width:100%;height:auto;max-height:78dvh;object-fit:contain}
.intro-panel{padding:22px 20px;text-align:left}.episode{margin:0 0 8px;color:#79613b;letter-spacing:.14em;font-size:12px;font-weight:1000}
.intro-panel h1{font-size:clamp(22px,2.4vw,32px);line-height:1.2;margin:7px 0}
.intro-copy{font-weight:800;line-height:1.55}.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:7px;margin:13px 0}
.intro-panel .difficulties label{justify-content:flex-start;padding:9px 10px}
.intro-panel .action{width:100%;margin:7px 0}.intro-panel .action.secondary{font-size:15px;padding:9px}
.intro-help{font-size:12px;line-height:1.5;color:#685638}.intro-panel .status{margin:2px 0}
@media(max-width:760px){.cover-frame{aspect-ratio:1.18/1;border-width:2px;border-radius:13px}.cover-actions{gap:8px}.cover-copy h1{-webkit-text-stroke:1.2px #51341d;text-shadow:2px 3px 0 #67442c}.cover-start{min-width:160px}.intro-screen{align-items:flex-start}.intro-layout{grid-template-columns:1fr;gap:10px}.intro-art{max-height:none}.intro-comic-image{max-height:none}.intro-panel{padding:15px}.intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))}.intro-panel .difficulties label{font-size:11px;gap:4px;padding:8px 5px}}


/* Shared Pot Breaker landscape shell: 16:9 stage, rotated for portrait touch screens. */
html,body{width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
body{background:#83c4f3}
.viewport{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 50% 0%,#dff8ff 0,#a5d9fc 45%,#70b8ee 100%)}
.stage{position:relative;flex:0 0 auto;width:min(100vw,177.778dvh);height:min(100dvh,56.25vw);aspect-ratio:16/9;container-type:size;container-name:game-stage;overflow:hidden;isolation:isolate;background:#f6eedf;box-shadow:0 2vh 7vh #2b467669}
.topbar{position:absolute;z-index:30;left:1.5%;right:1.5%;top:1.5%;height:8%;padding:0 1.2%;display:flex;align-items:center;justify-content:space-between;background:#ffffffdb;border:2px solid #fff;border-radius:16px;box-shadow:0 4px 14px #40577b24}
.topbar .menu-button,.topbar .lang-picker{border:2px solid #bfd7ef;border-radius:12px;background:#fffdf9;color:#303d67;box-shadow:0 3px 0 #9ab5d0;padding:6px 10px}
.topbar .brand-mini{font-size:clamp(7px,1cqw,12px);color:#303d67}
.container{position:absolute;inset:11% 2% 2%;width:96%;max-width:none;height:87%;margin:0;padding:0;overflow:hidden;text-align:center}
.cover-screen,.intro-screen,.play-area,#rankings,#end{position:absolute;inset:0;width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
.cover-screen:not([hidden]),.intro-screen:not([hidden]),.play-area:not([hidden]),#rankings:not([hidden]),#end:not([hidden]){display:flex}
.cover-screen{align-items:center;justify-content:center;gap:3%;padding:2.2%;background:linear-gradient(115deg,#e7f8ff,#b0dffc 64%,#98cafa);border:3px solid white;border-radius:24px}
.cover-frame{order:2;flex:0 0 58%;width:58%;max-width:none;aspect-ratio:16/9;margin:0;border:0;border-radius:16px;box-shadow:0 8px 18px #30456832}
.cover-actions{order:1;flex:1;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;width:auto;gap:2%;margin:0}
.cover-copy{flex:0 1 auto;text-align:left}.cover-copy h1{font-size:clamp(22px,5cqw,64px);color:#303d67;-webkit-text-stroke:0;text-shadow:0 3px 0 #fff,0 7px 12px #40577b25}.cover-copy h1 span:last-child{color:#5578bd}.cover-copy p{font-size:clamp(9px,1.5cqw,18px);line-height:1.35}
.cover-start,.action{border:2px solid #fff;border-radius:999px;color:#fff;background:linear-gradient(145deg,#648ddc,#446ab6);box-shadow:0 5px 0 #38528499;padding:clamp(7px,1.2cqw,14px) clamp(12px,2cqw,24px);font-size:clamp(10px,1.5cqw,20px)}
.action.secondary{color:#303d67;background:#fffdf9;border-color:#bfdbf6;box-shadow:0 4px 0 #9ab5d0}
.intro-screen{align-items:center;justify-content:center;padding:1.5%;background:linear-gradient(115deg,#f1faff,#a7d5f9);border:3px solid white;border-radius:24px}
.intro-layout{width:100%;height:100%;display:grid;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;align-items:center}
.intro-art{width:100%;height:100%;max-height:100%;margin:0;display:grid;place-items:center;overflow:hidden;border:3px solid white;border-radius:14px;background:#fffcf5c9}
.intro-comic-image{width:100%;height:100%;max-height:none;object-fit:contain}
.intro-panel{max-height:100%;overflow:auto;padding:2%;border:2px solid white;border-radius:18px;background:#fffcf5ed;box-shadow:0 5px 14px #456f9530}
.intro-panel h1{font-size:clamp(14px,2.5cqw,30px)}.intro-copy,.intro-help{font-size:clamp(8px,1.2cqw,14px);line-height:1.4}
.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:4px;margin:7px 0}
.intro-panel .difficulties label{font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
.intro-panel .action{width:100%;margin:3px 0}
.play-area{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1%;background:#f3eada;border:3px solid white;border-radius:24px}
.hud{width:min(100%,90cqw);margin:0 auto 1%;gap:1%}.stat{min-width:0;padding:4px 8px;font-size:clamp(9px,1.15cqw,15px)}.stat b{font-size:clamp(12px,1.8cqw,22px)}
.board-wrap{width:100%;height:auto;max-height:none;min-height:0;flex:1 1 auto;padding:.6%;border:3px solid white;border-radius:14px;box-shadow:0 6px 0 #7b694e44}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.3cqw,4px)}
#play #lock-message:empty{display:none}
..seo-copy{display:none}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:fixed;inset:0;width:100vw;height:100dvh;display:block;overflow:hidden}
 .stage{position:absolute;left:50%;top:50%;width:min(100dvh,177.778vw);height:min(100vw,56.25dvh);transform:translate(-50%,-50%) rotate(90deg);transform-origin:center center}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;height:100%}
 .intro-panel{max-height:100%;overflow:auto;padding:2%}
 .intro-panel .difficulties{grid-template-columns:1fr}
 .intro-panel .difficulties label{justify-content:flex-start;font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
}
@media(orientation:landscape) and (pointer:coarse){.viewport{width:100vw;height:100dvh}.stage{width:min(100vw,177.778dvh);height:min(100dvh,56.25vw)}}


/* Pot Breaker visual system: full-screen cover, warm gold CTA, compact floating controls. */
:root{color:#302a27;background:#83c4f3}
body{background:#83c4f3}
.stage{background:#f6eedf}
.topbar{left:1.2%;right:1.2%;top:1.4%;height:8%;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none}
.topbar .menu-button,.topbar .lang-picker{min-height:clamp(28px,5.4cqh,48px);padding:clamp(4px,.8cqw,9px) clamp(8px,1.35cqw,16px);border:2px solid #fff;border-radius:999px;background:#fffdf2;color:#273858;box-shadow:0 4px 0 #9ab5d0,0 6px 13px #18395b38;font-weight:900}
.topbar .brand-mini{color:#fffdf2;font-size:clamp(7px,1cqw,12px);font-weight:1000;letter-spacing:.1em;text-shadow:0 1px 4px #19355c,0 0 7px #19355c}
.menu-list{top:calc(100% + 6px);border:2px solid #c2d8ee;border-radius:18px;background:#fffdf8;box-shadow:0 5px 16px #18395b44}
.container{inset:0;width:100%;height:100%;padding:0}
.cover-screen{display:block!important;padding:0;border:0;border-radius:0;background:#f6eedf}
.cover-frame{position:absolute;inset:0;order:initial;width:100%;height:100%;max-width:none;aspect-ratio:auto;margin:0;border:0;border-radius:0;box-shadow:none;background:#78c6f5}
.cover-image{width:100%;height:100%;object-fit:cover;object-position:center 58%;filter:saturate(1.04)}
.cover-actions{position:absolute;inset:0;order:initial;display:block;width:100%;height:100%;margin:0;pointer-events:none}
.cover-copy{position:absolute;left:12%;right:12%;top:9%;text-align:center;pointer-events:none}
.cover-copy small{display:inline-block;margin-bottom:.3%;padding:.25em .8em;border-radius:999px;color:#fff9df;background:#453527b8;font-size:clamp(8px,1.15cqw,14px);font-weight:1000;letter-spacing:.12em;text-shadow:none}
.cover-copy h1{margin:0;color:#f4cf70;font-family:"Gungsuh","\uAD81\uC11C","\uAD81\uC11C\uCCB4","Nanum Myeongjo","Batang",serif;font-size:clamp(28px,7.1cqw,86px);font-weight:700;line-height:1.08;letter-spacing:.025em;-webkit-text-stroke:clamp(3px,.65cqw,8px) #050403;paint-order:stroke fill;text-shadow:0 3px 10px #1d2b3f99}
.cover-copy h1 span:last-child{color:inherit}
.cover-copy p{display:none}
.cover-start,.action{pointer-events:auto;border:3px solid #583a22;border-radius:999px;color:#302b31;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%);box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360;padding:clamp(8px,1.4cqw,16px) clamp(20px,3.4cqw,42px);font-weight:1000;text-shadow:0 1px #fff8d8;transition:transform .12s,filter .12s}
.cover-start:hover,.action:hover{filter:brightness(1.04);transform:translateY(-1px)}
.site-info-links [class^="info-"]{display:none}html[lang="ko"] .site-info-links .info-ko,html[lang="en"] .site-info-links .info-en,html[lang="zh"] .site-info-links .info-zh,html[lang="ja"] .site-info-links .info-ja{display:inline}
.intro-screen{padding:2%;border:0;border-radius:0;background:linear-gradient(145deg,#a8dcfb,#77bdf0)}
.intro-layout{width:100%;height:100%;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
.intro-art{border:3px solid #fff;border-radius:18px;background:#f6eedf;box-shadow:0 5px 0 #6489a355}
.intro-panel{padding:2.1%;border:2px solid #fff;border-radius:20px;background:#fffdf7;box-shadow:0 5px 0 #6489a355,0 9px 20px #385b7824;color:#302a27}
.intro-panel .episode{color:#795529}
.intro-panel .action{min-height:clamp(28px,5.5cqh,50px)}
.intro-panel .action.secondary{color:#273858;background:#fffdf7;border:2px solid #c2d8ee;box-shadow:0 3px 0 #90b4d1}
.play-area{inset:1.5%;width:97%;height:97%;padding:1%;border:3px solid #fff;border-radius:22px;background:#f3eada;box-shadow:0 5px 0 #6f5e4840}
/* Floating, non-layout feedback for the brief rotten-fruit input lock. */
.tree.fruit2{border:clamp(2px,.3cqw,4px) solid #e6403b;box-shadow:0 0 0 1px #fff6dd,0 3px 0 #ffffff65 inset,0 2px 4px #572a2344}
.play-area .lock-message{position:absolute;z-index:30;top:10%;left:50%;width:max-content;max-width:82%;margin:0;padding:6px 12px;border:1px solid #fff8e7;border-radius:999px;background:#2d3340df;color:#fff5d6;box-shadow:0 4px 12px #2a283244;font-size:clamp(9px,1.15cqw,14px);font-weight:900;text-align:center;opacity:0;visibility:hidden;transform:translate(-50%,-6px);pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s}
.play-area .lock-message.is-visible{opacity:1;visibility:visible;transform:translate(-50%,0)}

.hud{width:100%;max-width:none;margin:8% auto 1%;gap:1%}
.board-wrap{flex:1 1 0;width:100%;height:auto;max-height:none;min-height:0;padding:.55%;border:3px solid #fff;border-radius:16px;background:linear-gradient(135deg,#f8df82,#dcae58);box-shadow:0 5px 0 #6f5e4844}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.32cqw,4px)}
#rankings:not([hidden]),#end:not([hidden]){display:block;inset:3%;width:94%;height:94%;padding:10% 3% 3%;overflow:auto;border:3px solid #fff;border-radius:22px;background:#fffdf7;box-shadow:0 5px 0 #6f5e4844}
#rankings h1,#end h1{color:#303d67}
@media(orientation:portrait) and (pointer:coarse){
 .topbar{left:1.2%;right:1.2%;top:1.4%;height:8%}
 .container{inset:0;width:100%;height:100%}
 .cover-image{object-position:center 58%}
 .cover-copy{top:8%;left:8%;right:8%}
 .cover-copy h1{font-size:clamp(28px,7.1cqw,86px)}

 .play-area{inset:1.5%;width:97%;height:97%}
 .hud{margin-top:8%}
 .intro-screen{padding:2%}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
}

/* Shared Pot Breaker home controls. Keep these anchors identical in both modes. */
:root{--pb-home-gold:#ffd35c;--pb-home-blue:#303d67;--pb-home-outline:#5c4222;--pb-home-shadow:#9ab8d0}
#pb-game-mode{position:fixed;top:9px;left:9px;z-index:50;pointer-events:auto;font:900 12px/1.3 system-ui,sans-serif;color:#343027}
#pb-game-mode summary{display:flex;align-items:center;gap:6px;min-height:28px;box-sizing:border-box;cursor:pointer;list-style:none;background:#fff7d8f5;border:2px solid #6c482f;border-radius:12px;padding:7px 10px;box-shadow:0 3px 0 #765436}
#pb-game-mode summary::-webkit-details-marker{display:none}
#pb-game-mode nav{position:absolute;top:calc(100% + 8px);left:0;display:grid;width:max-content;min-width:185px;box-sizing:border-box;background:#fffced;border:2px solid #6c482f;border-radius:12px;margin:0;padding:6px;box-shadow:0 9px 22px #32201059}
#title .home-start,.cover-actions .home-start--visible{position:absolute;left:36.6%;top:39.4%;width:26.8%;height:11%;display:flex!important;align-items:center;justify-content:center;gap:.5em;box-sizing:border-box;margin:0!important;padding:0!important;border:3px solid var(--pb-home-outline)!important;border-radius:999px;color:#302b31!important;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%)!important;box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(16px,2cqw,22px)!important;font-weight:1000;line-height:1;text-shadow:0 1px #fff8d8;white-space:nowrap;z-index:9}
#title .home-start{cursor:pointer}
#title .home-start:hover{transform:none!important}
#title .home-start::before,.cover-actions .home-start--visible::before{content:"";flex:0 0 auto;width:0;height:0;border-top:.48em solid transparent;border-bottom:.48em solid transparent;border-left:.72em solid #242329;filter:drop-shadow(1px 1px 0 #fff8d8)}
.cover-actions .home-start--visible{pointer-events:auto;transform:none}
.cover-actions .home-start--visible:hover{filter:brightness(1.04);transform:none}
#title .home-ranking,.cover-actions .home-ranking{position:absolute;left:3%;bottom:3%;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;width:clamp(96px,9cqw,108px);min-width:clamp(96px,9cqw,108px);height:40px;margin:0;padding:7px 12px;border:2px solid #fff;border-radius:999px;color:var(--pb-home-blue);background:#fffdf2;box-shadow:0 4px 0 var(--pb-home-shadow),0 6px 13px #18395b38;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:12px;font-weight:1000;line-height:1;white-space:nowrap;pointer-events:auto}
.game-switch{position:absolute!important;z-index:5;left:4%!important;bottom:calc(4% + 54px)!important;display:flex!important;align-items:center;justify-content:center;width:clamp(168px,22cqw,226px)!important;height:42px!important;box-sizing:border-box;padding:0 12px!important;border:2px solid #fff!important;border-radius:999px!important;color:#35456d!important;background:#fffdf0e8!important;box-shadow:0 5px 14px #35456535!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(10px,1.05cqw,14px)!important;font-weight:1000!important;line-height:1!important;text-align:center;text-decoration:none;white-space:nowrap;pointer-events:auto}
.site-info-links{position:absolute!important;z-index:12;right:calc(2.2% + clamp(92px,15cqw,200px))!important;bottom:calc(2.4% + 38px)!important;display:flex!important;align-items:center;justify-content:flex-end;gap:clamp(4px,.7cqw,9px);pointer-events:auto}
.site-info-links a{display:inline-flex;align-items:center;justify-content:center;min-height:clamp(24px,3.6cqw,36px);box-sizing:border-box;padding:4px clamp(7px,1cqw,12px);border:1px solid #fff;border-radius:999px;background:#fffdf0e8;color:#35456d;box-shadow:0 3px 9px #35456530;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:clamp(8px,.95cqw,12px);font-weight:900;line-height:1;text-decoration:none;white-space:nowrap}
#pb-game-mode summary,.topbar .menu-button{min-height:28px;padding:7px 10px;border:2px solid #6c482f;border-radius:12px;background:#fff7d8f5;color:#343027;box-shadow:0 3px 0 #765436;font:900 12px/1.3 system-ui,sans-serif}
.menu-list{min-width:185px;margin-top:8px;padding:6px;border:2px solid #6c482f;border-radius:12px;background:#fffced;box-shadow:0 9px 22px #32201059}
#pb-game-mode nav a,.menu-list a{display:block;margin:0;padding:10px;border:0;border-radius:7px;background:transparent;color:#3f3226;box-shadow:none;font-weight:900;text-decoration:none}
#pb-game-mode nav a:hover,#pb-game-mode nav a:focus-visible,.menu-list a:hover,.menu-list a:focus-visible{background:#f8e5a4}
.menu .locale-control{right:1.2%!important;top:1.4%!important;bottom:auto!important}
.topbar .lang-picker{position:absolute;top:0;right:0}
.locale-control select,.topbar .lang-picker{box-sizing:border-box;max-width:104px;min-height:clamp(28px,5.4cqh,40px);padding:4px 20px 4px 9px;border:1px solid #ffffffed;border-radius:999px;background:#fffef4;color:#293b60;font:700 clamp(9px,1cqw,12px)/1.2 system-ui,sans-serif;box-shadow:0 2px 7px #34486b36;touch-action:manipulation}
.locale-control select:focus-visible,.topbar .lang-picker:focus-visible{outline:3px solid #f0bd48;outline-offset:2px}

#pb-game-mode .mode-label,#pb-game-mode .mode-pot,#pb-game-mode .mode-ginkgo{display:none}
html[lang="ko"] #pb-game-mode .mode-label-ko,html[lang="ko"] #pb-game-mode .mode-pot-ko,html[lang="ko"] #pb-game-mode .mode-ginkgo-ko{display:inline}
html[lang="en"] #pb-game-mode .mode-label-en,html[lang="en"] #pb-game-mode .mode-pot-en,html[lang="en"] #pb-game-mode .mode-ginkgo-en{display:inline}
html[lang="ja"] #pb-game-mode .mode-label-ja,html[lang="ja"] #pb-game-mode .mode-pot-ja,html[lang="ja"] #pb-game-mode .mode-ginkgo-ja{display:inline}
html[lang="zh"] #pb-game-mode .mode-label-zh,html[lang="zh"] #pb-game-mode .mode-pot-zh,html[lang="zh"] #pb-game-mode .mode-ginkgo-zh{display:inline}
#pb-game-mode nav a[aria-current="page"]{background:#f8e5a4}
.topbar{justify-content:flex-end}
/* Shared footer and 16:9 stage sizing for Pot Breaker and Ginkgo Tree Breaker. */
:root{--pb-footer-h:clamp(72px,9vh,104px)}
html,body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}
body{min-height:100dvh!important}
.viewport{position:relative!important;inset:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:280px;box-sizing:border-box;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;background:linear-gradient(135deg,#c8e8ff,#9acaf6)!important}
.stage{position:relative!important;left:auto!important;top:auto!important;flex:0 0 auto!important;width:min(100vw,calc((100dvh - var(--pb-footer-h))*1.77778))!important;height:min(calc(100dvh - var(--pb-footer-h)),56.25vw)!important;transform:none!important;margin:auto!important}
.site-footer{position:relative;z-index:50;width:100%;max-width:none!important;min-height:var(--pb-footer-h);box-sizing:border-box;display:grid;place-items:center;margin:0!important;padding:8px clamp(12px,2vw,28px);background:linear-gradient(100deg,#dff5ff,#b9e0fa 55%,#99cdf2);border-top:1px solid #ffffffc7;color:#293b60}
.site-guide{width:min(100%,1280px);display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:clamp(8px,1.6vw,22px)}
.site-guide-copy h1,.site-guide-copy h2{margin:0 0 3px;font-size:clamp(11px,1.15vw,16px);line-height:1.2}.site-guide-copy p{margin:0;font-size:clamp(9px,.9vw,12px);line-height:1.35}
.site-guide-howto{position:relative;font-size:clamp(9px,.9vw,12px)}.site-guide-howto summary{cursor:pointer;font-weight:800;white-space:nowrap}.site-guide-howto p{max-width:min(55vw,520px);margin:6px 0 0}
.site-guide nav{display:flex;gap:clamp(6px,1vw,14px);flex-wrap:wrap;justify-content:flex-end;font-size:clamp(9px,.9vw,12px)}.site-guide a{color:#244e70;text-underline-offset:2px}
/* Keep shared navigation and legal links out of the active playfield. */
body.is-playing{--pb-footer-h:0px!important}
body.is-playing #home,body.is-playing #title,body.is-playing #pb-game-mode,body.is-playing .topbar,body.is-playing .game-switch,body.is-playing .site-info-links,body.is-playing .site-footer{display:none!important}
body.is-ginkgo-subview #home,body.is-ginkgo-subview .game-switch,body.is-pot-subview #title,body.is-pot-subview .game-switch,body.is-pot-subview .site-info-links{display:none!important}
@media(max-width:700px){:root{--pb-footer-h:clamp(96px,16vh,136px)}.site-guide{grid-template-columns:minmax(0,1fr);align-items:start;gap:5px}.site-guide-copy{grid-column:auto}.site-guide-copy h1,.site-guide-copy h2{font-size:12px}.site-guide-copy p{font-size:10px;line-height:1.3}.site-guide nav{justify-content:flex-start;font-size:10px}.site-guide-howto{font-size:10px}.site-guide-howto p{max-width:90vw}}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:relative!important;inset:auto!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:220px!important;width:100vw!important;display:block!important;overflow:hidden!important}
 .stage{position:relative!important;left:auto!important;top:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;transform:none!important;transform-origin:center center!important;margin:0!important;aspect-ratio:auto!important;border-radius:0!important}
 body.is-playing .viewport{position:fixed!important;inset:0!important;height:100dvh!important}
 body.is-playing .stage{position:absolute!important;left:50%!important;top:50%!important;width:min(100dvh,177.778vw)!important;height:min(100vw,56.25dvh)!important;transform:translate(-50%,-50%) rotate(90deg)!important}
 #title .home-start,.cover-actions .home-start--visible{left:50%!important;top:40.5%!important;width:min(82%,320px)!important;height:clamp(52px,9vh,70px)!important;transform:translateX(-50%)!important;font-size:clamp(17px,5vw,22px)!important}
 #title .home-ranking,.cover-actions .home-ranking{left:50%!important;bottom:3%!important;transform:translateX(-50%)!important}
 .game-switch{left:50%!important;bottom:calc(3% + 46px)!important;width:min(82%,260px)!important;transform:translateX(-50%)!important}
 .site-info-links{right:50%!important;bottom:2%!important;transform:translateX(50%)!important;gap:5px!important}
 .site-info-links a{font-size:10px!important}
 #intro{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,1fr) auto!important;gap:8px!important;padding:56px 12px 12px!important}
 #intro>.comic-cover-wrap{height:40vh!important;max-height:40vh!important;min-height:0!important}
 #intro>.intro-side{height:auto!important;max-height:calc(100% - 40vh - 8px)!important;min-height:clamp(220px,34vh,280px)!important;overflow:auto!important;align-items:stretch!important;gap:8px!important;padding:10px!important}
 #intro .difficulty-picker{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 #intro .difficulty-picker span{grid-column:1/-1!important}
 #intro .intro-side h2{font-size:clamp(18px,5vw,26px)!important}
 #intro .intro-side p,#intro .intro-side small{font-size:12px!important}
 #home .cover-frame{width:100%!important;height:100%!important;max-width:none!important;aspect-ratio:auto!important}
 #home .cover-image{object-fit:cover!important;object-position:center 50%!important}
 .intro-layout{width:100%!important;height:100%!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,32vh) minmax(0,1fr)!important;gap:8px!important;padding:56px 10px 10px!important}
 .intro-art{height:100%!important;max-height:32vh!important;min-height:0!important}
 .intro-comic-image{width:100%!important;height:100%!important;object-fit:contain!important}
 .intro-panel{height:auto!important;min-height:clamp(250px,36vh,300px)!important;max-height:calc(100% - 32vh - 8px)!important;overflow:auto!important;padding:12px!important}
 .intro-panel h1{font-size:clamp(18px,5vw,26px)!important}
 .intro-panel .intro-copy,.intro-panel .intro-help{font-size:12px!important}
 .intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 .intro-panel .difficulties label{font-size:10px!important;padding:8px 4px!important}
 .intro-panel .action{min-height:44px!important}
 .play-area{inset:1.5%!important;width:97%!important;height:97%!important}
 .hud{margin-top:clamp(50px,8vh,76px)!important}
}

</style>
</head>
<body>
<div class="viewport"><div class="stage" id="ginkgo-stage">
<header class="topbar">
<select id="language" class="lang-picker" aria-label="Language"><option value="ko">\uD55C\uAD6D\uC5B4</option><option value="en">English</option><option value="ja">\u65E5\u672C\u8A9E</option><option value="zh">\u4E2D\u6587</option></select>
</header>
<main class="container">
<section id="home" class="cover-screen">
<div class="cover-frame">
<img class="cover-image" src="{{COVER_IMAGE}}" alt="\u9EC4\u91D1\u8272\u306E\u30A4\u30C1\u30E7\u30A6\u4E26\u6728\u3092\u773A\u3081\u308B\u30AE\u30DF\u30E7\u3068\u30AF\u30C0\u90E8\u9577" width="995" height="560" decoding="async" fetchpriority="high">
</div>
<div class="cover-actions">
<div class="cover-copy"><small data-i18n="theme">\uD3FF \uBE0C\uB808\uC774\uCEE4 \uD14C\uB9C8 2</small><h1><span data-i18n="title1">\uAE45\uCF54\uD2B8\uB9AC</span> <span data-i18n="title2">\uBE0C\uB808\uC774\uCEE4!</span></h1><p data-i18n="subtitle">\uB9CE\uC774 \uBF51\uC744\uC218\uB85D \uC88B\uC740 \uAC74\uAC00...? \uC369\uAE30 \uC804\uC5D0 \uC740\uD589\uC744 \uD130\uCE58\uD574 \uC810\uC218\uB97C \uC62C\uB9AC\uC138\uC694!</p></div>
<button class="action cover-start home-start home-start--visible" id="open-intro" data-i18n="open">\uAC8C\uC784 \uC2DC\uC791</button>
<button class="action secondary home-ranking" id="ranks-from-home" data-i18n="home_ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</button><a class="game-switch" id="potbreaker-link" href="/"><span data-i18n="pot">\u{1FAB4} \uD3FF\uBE0C\uB808\uC774\uCEE4 RE</span></a>
</div>
<nav class="site-info-links" aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav></section>
<section id="intro" class="intro-screen" hidden>
<div class="intro-layout">
<figure class="intro-art"><img class="intro-comic-image" src="{{COMIC_IMAGE}}" alt="\u30AE\u30DF\u30E7\u306E\u901A\u52E4\u304B\u3089\u30A4\u30C1\u30E7\u30A6\u4F10\u63A1\u306E\u4ED5\u4E8B\u307E\u3067\u3092\u63CF\u304F4\u30B3\u30DE\u6F2B\u753B" width="600" height="600" decoding="async" fetchpriority="high"></figure>
<aside class="intro-panel surface">
<p class="episode">EP.02 / GINKGO TREE BREAKER</p>
<h1 data-i18n="intro_title">\uAE30\uBB18\uC758 \uC774\uC0C1\uD55C \uCD9C\uADFC\uAE38</h1>
<p class="intro-copy" data-i18n="intro_copy">\uC740\uD589\uC774 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD574 \uC5C6\uC560\uC138\uC694. 60\uCD08 \uB3D9\uC548 \uC810\uC218\uB97C \uBAA8\uC544 \uB7AD\uD0B9\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4.</p>
<div class="difficulties">
<label><input type="radio" name="difficulty" value="normal" checked> NORMAL <small>3s</small></label>
<label><input type="radio" name="difficulty" value="hard"> HARD <small>2s</small></label>
<label><input type="radio" name="difficulty" value="very_hard"> VERY HARD <small>1s</small></label>
</div>
<button class="action cover-start" id="begin" data-i18n="enter">\uC740\uD589\uB098\uBB34\uB85C \uCD9C\uADFC \u25B6</button>
<button class="action secondary" id="intro-back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
<p class="intro-help" data-i18n="intro_help">\uB178\uB780 \uC740\uD589\uB9CC \uD130\uCE58\uD558\uC138\uC694. \uC78E\uC740 \uCF64\uBCF4\uB97C \uB04A\uACE0, \uC369\uC740 \uC740\uD589\uC740 0.5\uCD08 \uB3D9\uC548 \uC785\uB825\uC744 \uB9C9\uC2B5\uB2C8\uB2E4.</p>
<p class="status" id="begin-status" aria-live="polite"></p>
</aside>
</div>
</section>
<section id="play" class="play-area" hidden aria-label="Ginkgo Tree Breaker game">
<div class="hud"><div class="stat">\u{1F3C6} <span data-i18n="score">\uC810\uC218</span> <b id="score">0</b></div><div class="stat time">\u23F1\uFE0F <b id="timer">60.0</b>s</div><div class="stat">\u{1F525} <span data-i18n="combo">\uC5F0\uC18D</span> <b id="combo">0</b></div></div>
<div class="board-wrap"><div id="board" class="board" role="group" aria-label="Ginkgo trees"></div></div>
<p id="lock-message" class="lock-message" aria-live="polite"></p>
</section>
<section id="end" class="surface" hidden>
<h2 data-i18n="finished">60\uCD08 \uC885\uB8CC!</h2><div class="end-grid"><div class="stat"><span data-i18n="score">\uC810\uC218</span><br><b id="final-score">0</b></div><div class="stat"><span data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</span><br><b id="final-combo">0</b></div></div>
<label for="nickname" data-i18n="name">\uB7AD\uD0B9\uC5D0 \uD45C\uC2DC\uD560 \uB2C9\uB124\uC784</label><br><input class="nickname" maxlength="16" id="nickname" autocomplete="nickname" placeholder="Gimyo">
<div><button class="action" id="submit" data-i18n="submit">\uB7AD\uD0B9 \uB4F1\uB85D</button><button class="action secondary" id="retry" data-i18n="retry">\uB2E4\uC2DC \uC2DC\uC791</button></div>
<p id="result-status" class="status" aria-live="polite"></p>
</section>
<section id="rankings" class="surface" hidden>
<h2 data-i18n="ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</h2><p data-i18n="ranking_info">\uC810\uC218 \uC6B0\uC120 \xB7 \uB3D9\uC810 \uC2DC \uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5 \xB7 1~3\uC704 \uC601\uAD6C \uBCF4\uAD00 / 4\uC704 \uC774\uD558 \uB9E4\uC6D4 1\uC77C \uC0AD\uC81C</p>
<select id="rank-difficulty" class="lang-picker"><option value="normal">NORMAL</option><option value="hard">HARD</option><option value="very_hard">VERY HARD</option></select>
<div style="overflow-x:auto"><table><thead><tr><th data-i18n="place">\uC21C\uC704</th><th data-i18n="player">\uD50C\uB808\uC774\uC5B4</th><th data-i18n="score">\uC810\uC218</th><th data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</th></tr></thead><tbody id="ranking-rows"></tbody></table></div>
<p id="rank-status" class="status" aria-live="polite"></p><button class="action secondary" id="back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
</section>
</main></div></div>
<footer class="site-footer" id="site-footer">
<section class="site-guide" aria-labelledby="ginkgo-guide-heading">
<div class="site-guide-copy"><h2 id="ginkgo-guide-heading">\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC\u306E\u904A\u3073\u65B9</h2><p>60\u79D2\u9593\u3067\u8150\u308B\u524D\u306E\u30AE\u30F3\u30CA\u30F3\u3092\u30BF\u30C3\u30D7\u3002\u30CE\u30FC\u30DE\u30EB\u30FB\u30CF\u30FC\u30C9\u30FB\u30D9\u30EA\u30FC\u30CF\u30FC\u30C9\u3001\u9023\u7D9A\u6210\u529F\u30B9\u30B3\u30A2\u3068\u30E9\u30F3\u30AD\u30F3\u30B0\u3002</p></div>
<details class="site-guide-howto"><summary data-i18n="howto">\uAC8C\uC784 \uBC29\uBC95</summary><p>60\u79D2\u306E\u9593\u306B\u9EC4\u8272\u3044\u30AE\u30F3\u30CA\u30F3\u3092\u30BF\u30C3\u30D7\u3057\u3066\u5F97\u70B9\u3002\u9023\u7D9A\u6210\u529F\u306E\u5F97\u70B9\u306F\u30CE\u30FC\u30DE\u30EB1\u30FB2\u30FB3\u70B9\u3001\u30CF\u30FC\u30C92\u30FB4\u30FB6\u70B9\u3001\u30D9\u30EA\u30FC\u30CF\u30FC\u30C93\u30FB6\u30FB9\u70B9\u3067\u3059\u3002\u8449\u3084\u8150\u3063\u305F\u30AE\u30F3\u30CA\u30F3\u3092\u30BF\u30C3\u30D7\u3059\u308B\u3068\u9023\u7D9A\u8A18\u9332\u304C\u30EA\u30BB\u30C3\u30C8\u3055\u308C\u307E\u3059\u3002\u8150\u3063\u305F\u30AE\u30F3\u30CA\u30F3\u306B\u306F0.5\u79D2\u306E\u30BF\u30C3\u30D7\u5236\u9650\u304C\u3042\u308A\u307E\u3059\u3002</p></details>
<nav aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav>
</section>
</footer>
<script type="module" src="/modules/ginkgo/main.js"><\/script>
</body></html>
`,
  "zh": `<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f8d14f">
<title>\u94F6\u674F\u6811\u7834\u574F\u8005 | POT BREAKER \u4E3B\u98982</title>
<meta name="description" content="60\u79D2\u5185\u70B9\u51FB\u672A\u8150\u70C2\u7684\u94F6\u674F\u679C\u3002\u4E09\u79CD\u96BE\u5EA6\u3001\u8FDE\u7EED\u6210\u529F\u52A0\u5206\u548C\u6392\u884C\u699C\u3002">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://potbreaker.com/ginkgo/zh">
<link rel="alternate" hreflang="ko" href="https://potbreaker.com/ginkgo">
<link rel="alternate" hreflang="en" href="https://potbreaker.com/ginkgo/en">
<link rel="alternate" hreflang="ja" href="https://potbreaker.com/ginkgo/ja">
<link rel="alternate" hreflang="zh-CN" href="https://potbreaker.com/ginkgo/zh">
<link rel="alternate" hreflang="x-default" href="https://potbreaker.com/ginkgo">
<meta property="og:type" content="website">
<meta property="og:url" content="https://potbreaker.com/ginkgo/zh">
<meta property="og:title" content="\u94F6\u674F\u6811\u7834\u574F\u8005 | POT BREAKER \u4E3B\u98982">
<meta property="og:description" content="60\u79D2\u5185\u70B9\u51FB\u672A\u8150\u70C2\u7684\u94F6\u674F\u679C\u3002\u4E09\u79CD\u96BE\u5EA6\u3001\u8FDE\u7EED\u6210\u529F\u52A0\u5206\u548C\u6392\u884C\u699C\u3002">
<meta property="og:locale" content="zh_CN">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{font-family:system-ui,'Noto Sans KR','Malgun Gothic',sans-serif;color:#342a20;background:#fbe9ad;font-synthesis:none}
*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:radial-gradient(circle at 10% 12%,#fff7cd 0,transparent 34%),radial-gradient(circle at 95% 5%,#bdeed8 0,transparent 28%),linear-gradient(125deg,#ffe58b,#fff3c7 45%,#f4dc8c);background-attachment:fixed}
button,input,select{font:inherit}button{cursor:pointer;touch-action:manipulation}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #1f7d74;outline-offset:3px}
.topbar{z-index:30;display:flex;justify-content:space-between;align-items:center;padding:10px clamp(10px,3vw,32px);position:sticky;top:0;background:#fffbebdb;backdrop-filter:blur(12px);border-bottom:3px solid #644630}
.menu{position:relative}.menu-button,.lang-button{border:2px solid #563b2a;border-radius:15px;background:#fff8d8;box-shadow:0 3px 0 #563b2a;padding:8px 13px;font-weight:900;color:#42321e}
.menu-list{position:absolute;top:calc(100% + 9px);left:0;min-width:245px;background:white;border:3px solid #563b2a;border-radius:14px;padding:8px;box-shadow:0 10px 25px #5f461d4b}
.menu-list a{display:block;margin:4px 0;padding:10px 12px;color:#273858;text-decoration:none;border:1px solid #c2d8ee;border-radius:999px;background:#fffdf8;box-shadow:0 2px 0 #90b4d1;font-weight:900}.menu-list a[aria-current]{background:#fff1b8}
.brand-mini{font-size:12px;font-weight:1000;color:#7b552b;letter-spacing:.02em}.lang-picker{border:2px solid #563b2a;background:#fffdf5;border-radius:12px;padding:9px 12px;font-weight:900;color:#463219}
.container{max-width:1080px;margin:0 auto;padding:clamp(10px,3vw,24px);text-align:center}
.heading{padding:12px 0 18px;position:relative}.heading small{font-weight:1000;letter-spacing:.12em;color:#684727}.heading h1{font-weight:1000;font-size:clamp(33px,7vw,78px);margin:6px 0;line-height:1.13;color:#f7b221;-webkit-text-stroke:2px #51341d;text-shadow:4px 5px 0 #67442c,7px 8px 0 #fff7c0}.heading h1 span{color:#7ec94d}.heading p{font-weight:800;line-height:1.5;margin:12px auto}
.leaves{position:absolute;pointer-events:none;font-size:clamp(30px,6vw,70px);top:4px;left:5%}.leaves.right{left:auto;right:6%;transform:rotate(35deg)}
.surface{background:#fff9de;border:3px solid #503623;box-shadow:0 7px 0 #523826;border-radius:23px;padding:clamp(13px,2.5vw,24px)}
.difficulties{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:16px 0}
.difficulties label{cursor:pointer;display:flex;align-items:center;gap:8px;padding:12px 16px;background:#fff9dc;border:2px solid #6a492e;border-radius:13px;font-weight:1000}
.difficulties label:has(input:checked){background:#a4da5c;box-shadow:inset 0 0 0 2px #305c27}
.action{background:linear-gradient(#9fe16c,#58b74a);color:#1d3920;font-weight:1000;padding:12px 22px;border:3px solid #3b5430;border-radius:16px;box-shadow:0 5px 0 #355d37;margin:5px}
.action.secondary{background:linear-gradient(#fff2b0,#e7bf69);border-color:#745232;box-shadow:0 5px 0 #745232}
.action:disabled{filter:grayscale(1);opacity:.55;cursor:not-allowed}
.comic-title{margin:26px 0 15px;font-size:clamp(18px,3vw,28px);font-weight:1000}
.comics{display:flex;justify-content:center;width:min(100%,800px);margin:16px auto}
.comic{margin:0;width:100%;overflow:hidden;border:4px solid #513421;border-radius:18px;background:#fff6cf;box-shadow:0 6px 0 #63432b}
.comic-image{display:block;width:100%;height:auto;object-fit:contain}
@media(max-width:680px){.comics{width:100%;margin:10px auto}.comic{border-width:2px;border-radius:10px}}
.play-area{padding-top:0}
.hud{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px auto;max-width:880px}
.stat{background:#fffaf0;border:2px solid #634531;border-radius:12px;padding:7px 13px;min-width:78px;font-size:clamp(11px,2.1vw,18px);font-weight:1000}
.stat b{font-size:clamp(18px,3vw,29px)}.stat.time{background:#ffe293}
.board-wrap{width:min(100%,880px);margin:auto;padding:7px;border:4px solid #704722;border-radius:22px;background:linear-gradient(#f6d77e,#d4a862);box-shadow:0 10px 0 #714b2b}
.board{display:grid;grid-template-columns:repeat(13,1fr);gap:3px;aspect-ratio:13/7;touch-action:manipulation}
.cell{border:1px solid #b79b52;position:relative;border-radius:7px;background:linear-gradient(160deg,#fff7c2,#f5de7e);padding:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.cell:after{content:'';position:absolute;bottom:9%;left:25%;right:25%;height:3px;background:#a7824d77;border-radius:50%}
.trunk{position:absolute;bottom:15%;left:46%;height:32%;width:10%;border-radius:3px;background:linear-gradient(90deg,#7b5330,#a98051);z-index:1}
.tree{position:absolute;z-index:2;top:7%;height:64%;width:76%;border:2px solid #516a31;border-radius:60% 60% 41% 41%;box-shadow:0 3px 0 #ffffff65 inset;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:1000}
.tree.leaf0{background:radial-gradient(circle at 40% 30%,#d0f783,#78c34c 70%,#4a9d42)}.tree.leaf1{background:radial-gradient(circle at 40% 30%,#fff5a8,#ffc62f 68%,#d99e22);border-color:#9f6d14}
.tree.fruit2,.tree.fruit3{height:45%;width:47%;top:30%;border-radius:50% 45% 58% 48%;background:radial-gradient(circle at 34% 27%,#fff2aa,#dfaa36 67%,#ba7320);border-color:#8d6a22}
.tree.fruit2:after{content:'\u2022';color:#e8c260;text-shadow:-7px 3px #f8d15b,7px 3px #ffe399;font-size:clamp(9px,2vw,23px)}
.tree.fruit3{background:radial-gradient(circle at 35% 20%,#9f8664,#62503f 74%,#392f29);border-color:#382d25}
.tree.fruit3:after{content:'\xD7';font-size:clamp(12px,2vw,24px);color:#f2d5ac}
.cell:active{transform:scale(.93)}.cell:disabled{cursor:default}
.locked{filter:grayscale(.5)}.lock-message{margin:9px auto;color:#763e22;font-weight:900;min-height:1.8em}
.end-grid{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:16px}
.end-grid .stat{min-width:130px}.nickname{border:2px solid #634531;border-radius:12px;padding:10px 12px;width:min(90%,280px);font-weight:700}
table{border-collapse:collapse;width:100%;font-weight:700}td,th{padding:10px 8px;border-bottom:1px solid #d9bf89;text-align:left}td:nth-child(3),td:nth-child(4),th:nth-child(3),th:nth-child(4){text-align:right}
.status{min-height:1.4em;color:#7e432c;font-weight:800}
.seo-copy{max-width:880px;margin:28px auto 10px;text-align:left;line-height:1.65}.seo-copy h2{font-size:21px}
footer{max-width:880px;margin:24px auto;padding-bottom:15px;display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font-size:13px}footer a{color:#533a26}
[hidden]{display:none!important}
@media(max-width:680px){.comics{grid-template-columns:repeat(2,1fr);gap:7px}.comic{min-height:130px;padding:8px}.comics .art{margin:2px 0}.board{gap:1px}.cell{border-radius:3px}.tree{border-width:1px}.trunk{width:11%}.hud{gap:4px}.stat{min-width:0;padding:5px 7px}.heading h1{-webkit-text-stroke:1.3px #51341d;text-shadow:2px 3px 0 #67442c}.topbar{padding:7px}.brand-mini{display:none}}
@media(max-width:380px){.tree.fruit2:after{display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

/* Theme 2 follows the existing Pot Breaker cover \u2192 comic intro \u2192 game entry flow. */
:root{background:#fae9ab}
body{background:linear-gradient(145deg,#fff6c9 0%,#f6d865 50%,#ffeeb6 100%)}
.cover-screen{width:100%;margin:0 auto}
.cover-frame{position:relative;overflow:hidden;width:min(100%,1080px);margin:8px auto 0;aspect-ratio:16/9;border:4px solid #513421;border-radius:22px;background:#f5d75b;box-shadow:0 9px 0 #63432b}
.cover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.cover-actions{width:min(100%,1080px);margin:14px auto 4px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}
.cover-copy{flex:1 1 100%;text-align:center}.cover-copy small{font-weight:1000;letter-spacing:.1em;color:#674824}.cover-copy h1{font-size:clamp(30px,6vw,68px);line-height:1.08;margin:5px 0;color:#f4bc24;-webkit-text-stroke:2px #51341d;text-shadow:3px 4px 0 #67442c,6px 7px 0 #fff7c0}
.cover-copy h1 span:last-child{color:#80c950}.cover-copy p{font-weight:900;margin:7px 0 3px}
.cover-start{min-width:190px;border-radius:999px;padding:15px 25px;font-size:clamp(17px,2.2vw,24px);background:linear-gradient(#ffe877,#ffbd34);color:#49351d;border-color:#78512a;box-shadow:0 5px 0 #79502a}
.intro-screen{width:100%;min-height:calc(100dvh - 80px);display:flex;align-items:center;justify-content:center}
.intro-layout{width:min(100%,1240px);display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,310px);align-items:center;gap:24px;text-align:left}
.intro-art{margin:0;width:100%;max-height:78dvh;display:grid;place-items:center;overflow:hidden;border-radius:14px;background:#fff8dc}
.intro-comic-image{display:block;width:100%;height:auto;max-height:78dvh;object-fit:contain}
.intro-panel{padding:22px 20px;text-align:left}.episode{margin:0 0 8px;color:#79613b;letter-spacing:.14em;font-size:12px;font-weight:1000}
.intro-panel h1{font-size:clamp(22px,2.4vw,32px);line-height:1.2;margin:7px 0}
.intro-copy{font-weight:800;line-height:1.55}.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:7px;margin:13px 0}
.intro-panel .difficulties label{justify-content:flex-start;padding:9px 10px}
.intro-panel .action{width:100%;margin:7px 0}.intro-panel .action.secondary{font-size:15px;padding:9px}
.intro-help{font-size:12px;line-height:1.5;color:#685638}.intro-panel .status{margin:2px 0}
@media(max-width:760px){.cover-frame{aspect-ratio:1.18/1;border-width:2px;border-radius:13px}.cover-actions{gap:8px}.cover-copy h1{-webkit-text-stroke:1.2px #51341d;text-shadow:2px 3px 0 #67442c}.cover-start{min-width:160px}.intro-screen{align-items:flex-start}.intro-layout{grid-template-columns:1fr;gap:10px}.intro-art{max-height:none}.intro-comic-image{max-height:none}.intro-panel{padding:15px}.intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))}.intro-panel .difficulties label{font-size:11px;gap:4px;padding:8px 5px}}


/* Shared Pot Breaker landscape shell: 16:9 stage, rotated for portrait touch screens. */
html,body{width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
body{background:#83c4f3}
.viewport{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 50% 0%,#dff8ff 0,#a5d9fc 45%,#70b8ee 100%)}
.stage{position:relative;flex:0 0 auto;width:min(100vw,177.778dvh);height:min(100dvh,56.25vw);aspect-ratio:16/9;container-type:size;container-name:game-stage;overflow:hidden;isolation:isolate;background:#f6eedf;box-shadow:0 2vh 7vh #2b467669}
.topbar{position:absolute;z-index:30;left:1.5%;right:1.5%;top:1.5%;height:8%;padding:0 1.2%;display:flex;align-items:center;justify-content:space-between;background:#ffffffdb;border:2px solid #fff;border-radius:16px;box-shadow:0 4px 14px #40577b24}
.topbar .menu-button,.topbar .lang-picker{border:2px solid #bfd7ef;border-radius:12px;background:#fffdf9;color:#303d67;box-shadow:0 3px 0 #9ab5d0;padding:6px 10px}
.topbar .brand-mini{font-size:clamp(7px,1cqw,12px);color:#303d67}
.container{position:absolute;inset:11% 2% 2%;width:96%;max-width:none;height:87%;margin:0;padding:0;overflow:hidden;text-align:center}
.cover-screen,.intro-screen,.play-area,#rankings,#end{position:absolute;inset:0;width:100%;height:100%;min-height:0;margin:0;overflow:hidden}
.cover-screen:not([hidden]),.intro-screen:not([hidden]),.play-area:not([hidden]),#rankings:not([hidden]),#end:not([hidden]){display:flex}
.cover-screen{align-items:center;justify-content:center;gap:3%;padding:2.2%;background:linear-gradient(115deg,#e7f8ff,#b0dffc 64%,#98cafa);border:3px solid white;border-radius:24px}
.cover-frame{order:2;flex:0 0 58%;width:58%;max-width:none;aspect-ratio:16/9;margin:0;border:0;border-radius:16px;box-shadow:0 8px 18px #30456832}
.cover-actions{order:1;flex:1;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;width:auto;gap:2%;margin:0}
.cover-copy{flex:0 1 auto;text-align:left}.cover-copy h1{font-size:clamp(22px,5cqw,64px);color:#303d67;-webkit-text-stroke:0;text-shadow:0 3px 0 #fff,0 7px 12px #40577b25}.cover-copy h1 span:last-child{color:#5578bd}.cover-copy p{font-size:clamp(9px,1.5cqw,18px);line-height:1.35}
.cover-start,.action{border:2px solid #fff;border-radius:999px;color:#fff;background:linear-gradient(145deg,#648ddc,#446ab6);box-shadow:0 5px 0 #38528499;padding:clamp(7px,1.2cqw,14px) clamp(12px,2cqw,24px);font-size:clamp(10px,1.5cqw,20px)}
.action.secondary{color:#303d67;background:#fffdf9;border-color:#bfdbf6;box-shadow:0 4px 0 #9ab5d0}
.intro-screen{align-items:center;justify-content:center;padding:1.5%;background:linear-gradient(115deg,#f1faff,#a7d5f9);border:3px solid white;border-radius:24px}
.intro-layout{width:100%;height:100%;display:grid;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;align-items:center}
.intro-art{width:100%;height:100%;max-height:100%;margin:0;display:grid;place-items:center;overflow:hidden;border:3px solid white;border-radius:14px;background:#fffcf5c9}
.intro-comic-image{width:100%;height:100%;max-height:none;object-fit:contain}
.intro-panel{max-height:100%;overflow:auto;padding:2%;border:2px solid white;border-radius:18px;background:#fffcf5ed;box-shadow:0 5px 14px #456f9530}
.intro-panel h1{font-size:clamp(14px,2.5cqw,30px)}.intro-copy,.intro-help{font-size:clamp(8px,1.2cqw,14px);line-height:1.4}
.intro-panel .difficulties{display:grid;grid-template-columns:1fr;gap:4px;margin:7px 0}
.intro-panel .difficulties label{font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
.intro-panel .action{width:100%;margin:3px 0}
.play-area{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1%;background:#f3eada;border:3px solid white;border-radius:24px}
.hud{width:min(100%,90cqw);margin:0 auto 1%;gap:1%}.stat{min-width:0;padding:4px 8px;font-size:clamp(9px,1.15cqw,15px)}.stat b{font-size:clamp(12px,1.8cqw,22px)}
.board-wrap{width:100%;height:auto;max-height:none;min-height:0;flex:1 1 auto;padding:.6%;border:3px solid white;border-radius:14px;box-shadow:0 6px 0 #7b694e44}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.3cqw,4px)}
#play #lock-message:empty{display:none}
..seo-copy{display:none}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:fixed;inset:0;width:100vw;height:100dvh;display:block;overflow:hidden}
 .stage{position:absolute;left:50%;top:50%;width:min(100dvh,177.778vw);height:min(100vw,56.25dvh);transform:translate(-50%,-50%) rotate(90deg);transform-origin:center center}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%;height:100%}
 .intro-panel{max-height:100%;overflow:auto;padding:2%}
 .intro-panel .difficulties{grid-template-columns:1fr}
 .intro-panel .difficulties label{justify-content:flex-start;font-size:clamp(8px,1.05cqw,13px);padding:4px 6px}
}
@media(orientation:landscape) and (pointer:coarse){.viewport{width:100vw;height:100dvh}.stage{width:min(100vw,177.778dvh);height:min(100dvh,56.25vw)}}


/* Pot Breaker visual system: full-screen cover, warm gold CTA, compact floating controls. */
:root{color:#302a27;background:#83c4f3}
body{background:#83c4f3}
.stage{background:#f6eedf}
.topbar{left:1.2%;right:1.2%;top:1.4%;height:8%;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none}
.topbar .menu-button,.topbar .lang-picker{min-height:clamp(28px,5.4cqh,48px);padding:clamp(4px,.8cqw,9px) clamp(8px,1.35cqw,16px);border:2px solid #fff;border-radius:999px;background:#fffdf2;color:#273858;box-shadow:0 4px 0 #9ab5d0,0 6px 13px #18395b38;font-weight:900}
.topbar .brand-mini{color:#fffdf2;font-size:clamp(7px,1cqw,12px);font-weight:1000;letter-spacing:.1em;text-shadow:0 1px 4px #19355c,0 0 7px #19355c}
.menu-list{top:calc(100% + 6px);border:2px solid #c2d8ee;border-radius:18px;background:#fffdf8;box-shadow:0 5px 16px #18395b44}
.container{inset:0;width:100%;height:100%;padding:0}
.cover-screen{display:block!important;padding:0;border:0;border-radius:0;background:#f6eedf}
.cover-frame{position:absolute;inset:0;order:initial;width:100%;height:100%;max-width:none;aspect-ratio:auto;margin:0;border:0;border-radius:0;box-shadow:none;background:#78c6f5}
.cover-image{width:100%;height:100%;object-fit:cover;object-position:center 58%;filter:saturate(1.04)}
.cover-actions{position:absolute;inset:0;order:initial;display:block;width:100%;height:100%;margin:0;pointer-events:none}
.cover-copy{position:absolute;left:12%;right:12%;top:9%;text-align:center;pointer-events:none}
.cover-copy small{display:inline-block;margin-bottom:.3%;padding:.25em .8em;border-radius:999px;color:#fff9df;background:#453527b8;font-size:clamp(8px,1.15cqw,14px);font-weight:1000;letter-spacing:.12em;text-shadow:none}
.cover-copy h1{margin:0;color:#f4cf70;font-family:"Gungsuh","\uAD81\uC11C","\uAD81\uC11C\uCCB4","Nanum Myeongjo","Batang",serif;font-size:clamp(28px,7.1cqw,86px);font-weight:700;line-height:1.08;letter-spacing:.025em;-webkit-text-stroke:clamp(3px,.65cqw,8px) #050403;paint-order:stroke fill;text-shadow:0 3px 10px #1d2b3f99}
.cover-copy h1 span:last-child{color:inherit}
.cover-copy p{display:none}
.cover-start,.action{pointer-events:auto;border:3px solid #583a22;border-radius:999px;color:#302b31;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%);box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360;padding:clamp(8px,1.4cqw,16px) clamp(20px,3.4cqw,42px);font-weight:1000;text-shadow:0 1px #fff8d8;transition:transform .12s,filter .12s}
.cover-start:hover,.action:hover{filter:brightness(1.04);transform:translateY(-1px)}
.site-info-links [class^="info-"]{display:none}html[lang="ko"] .site-info-links .info-ko,html[lang="en"] .site-info-links .info-en,html[lang="zh"] .site-info-links .info-zh,html[lang="ja"] .site-info-links .info-ja{display:inline}
.intro-screen{padding:2%;border:0;border-radius:0;background:linear-gradient(145deg,#a8dcfb,#77bdf0)}
.intro-layout{width:100%;height:100%;grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
.intro-art{border:3px solid #fff;border-radius:18px;background:#f6eedf;box-shadow:0 5px 0 #6489a355}
.intro-panel{padding:2.1%;border:2px solid #fff;border-radius:20px;background:#fffdf7;box-shadow:0 5px 0 #6489a355,0 9px 20px #385b7824;color:#302a27}
.intro-panel .episode{color:#795529}
.intro-panel .action{min-height:clamp(28px,5.5cqh,50px)}
.intro-panel .action.secondary{color:#273858;background:#fffdf7;border:2px solid #c2d8ee;box-shadow:0 3px 0 #90b4d1}
.play-area{inset:1.5%;width:97%;height:97%;padding:1%;border:3px solid #fff;border-radius:22px;background:#f3eada;box-shadow:0 5px 0 #6f5e4840}
/* Floating, non-layout feedback for the brief rotten-fruit input lock. */
.tree.fruit2{border:clamp(2px,.3cqw,4px) solid #e6403b;box-shadow:0 0 0 1px #fff6dd,0 3px 0 #ffffff65 inset,0 2px 4px #572a2344}
.play-area .lock-message{position:absolute;z-index:30;top:10%;left:50%;width:max-content;max-width:82%;margin:0;padding:6px 12px;border:1px solid #fff8e7;border-radius:999px;background:#2d3340df;color:#fff5d6;box-shadow:0 4px 12px #2a283244;font-size:clamp(9px,1.15cqw,14px);font-weight:900;text-align:center;opacity:0;visibility:hidden;transform:translate(-50%,-6px);pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s}
.play-area .lock-message.is-visible{opacity:1;visibility:visible;transform:translate(-50%,0)}

.hud{width:100%;max-width:none;margin:8% auto 1%;gap:1%}
.board-wrap{flex:1 1 0;width:100%;height:auto;max-height:none;min-height:0;padding:.55%;border:3px solid #fff;border-radius:16px;background:linear-gradient(135deg,#f8df82,#dcae58);box-shadow:0 5px 0 #6f5e4844}
.board{width:100%;height:100%;max-height:100%;aspect-ratio:auto;grid-template-rows:repeat(7,minmax(0,1fr));gap:clamp(1px,.32cqw,4px)}
#rankings:not([hidden]),#end:not([hidden]){display:block;inset:3%;width:94%;height:94%;padding:10% 3% 3%;overflow:auto;border:3px solid #fff;border-radius:22px;background:#fffdf7;box-shadow:0 5px 0 #6f5e4844}
#rankings h1,#end h1{color:#303d67}
@media(orientation:portrait) and (pointer:coarse){
 .topbar{left:1.2%;right:1.2%;top:1.4%;height:8%}
 .container{inset:0;width:100%;height:100%}
 .cover-image{object-position:center 58%}
 .cover-copy{top:8%;left:8%;right:8%}
 .cover-copy h1{font-size:clamp(28px,7.1cqw,86px)}

 .play-area{inset:1.5%;width:97%;height:97%}
 .hud{margin-top:8%}
 .intro-screen{padding:2%}
 .intro-layout{grid-template-columns:minmax(0,66%) minmax(0,1fr);gap:1.5%}
}

/* Shared Pot Breaker home controls. Keep these anchors identical in both modes. */
:root{--pb-home-gold:#ffd35c;--pb-home-blue:#303d67;--pb-home-outline:#5c4222;--pb-home-shadow:#9ab8d0}
#pb-game-mode{position:fixed;top:9px;left:9px;z-index:50;pointer-events:auto;font:900 12px/1.3 system-ui,sans-serif;color:#343027}
#pb-game-mode summary{display:flex;align-items:center;gap:6px;min-height:28px;box-sizing:border-box;cursor:pointer;list-style:none;background:#fff7d8f5;border:2px solid #6c482f;border-radius:12px;padding:7px 10px;box-shadow:0 3px 0 #765436}
#pb-game-mode summary::-webkit-details-marker{display:none}
#pb-game-mode nav{position:absolute;top:calc(100% + 8px);left:0;display:grid;width:max-content;min-width:185px;box-sizing:border-box;background:#fffced;border:2px solid #6c482f;border-radius:12px;margin:0;padding:6px;box-shadow:0 9px 22px #32201059}
#title .home-start,.cover-actions .home-start--visible{position:absolute;left:36.6%;top:39.4%;width:26.8%;height:11%;display:flex!important;align-items:center;justify-content:center;gap:.5em;box-sizing:border-box;margin:0!important;padding:0!important;border:3px solid var(--pb-home-outline)!important;border-radius:999px;color:#302b31!important;background:linear-gradient(180deg,#ffe57b 0%,#ffc63d 76%,#f2a92b 100%)!important;box-shadow:0 5px 0 #633f23,0 8px 14px #263c5360!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(16px,2cqw,22px)!important;font-weight:1000;line-height:1;text-shadow:0 1px #fff8d8;white-space:nowrap;z-index:9}
#title .home-start{cursor:pointer}
#title .home-start:hover{transform:none!important}
#title .home-start::before,.cover-actions .home-start--visible::before{content:"";flex:0 0 auto;width:0;height:0;border-top:.48em solid transparent;border-bottom:.48em solid transparent;border-left:.72em solid #242329;filter:drop-shadow(1px 1px 0 #fff8d8)}
.cover-actions .home-start--visible{pointer-events:auto;transform:none}
.cover-actions .home-start--visible:hover{filter:brightness(1.04);transform:none}
#title .home-ranking,.cover-actions .home-ranking{position:absolute;left:3%;bottom:3%;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;width:clamp(96px,9cqw,108px);min-width:clamp(96px,9cqw,108px);height:40px;margin:0;padding:7px 12px;border:2px solid #fff;border-radius:999px;color:var(--pb-home-blue);background:#fffdf2;box-shadow:0 4px 0 var(--pb-home-shadow),0 6px 13px #18395b38;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:12px;font-weight:1000;line-height:1;white-space:nowrap;pointer-events:auto}
.game-switch{position:absolute!important;z-index:5;left:4%!important;bottom:calc(4% + 54px)!important;display:flex!important;align-items:center;justify-content:center;width:clamp(168px,22cqw,226px)!important;height:42px!important;box-sizing:border-box;padding:0 12px!important;border:2px solid #fff!important;border-radius:999px!important;color:#35456d!important;background:#fffdf0e8!important;box-shadow:0 5px 14px #35456535!important;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif!important;font-size:clamp(10px,1.05cqw,14px)!important;font-weight:1000!important;line-height:1!important;text-align:center;text-decoration:none;white-space:nowrap;pointer-events:auto}
.site-info-links{position:absolute!important;z-index:12;right:calc(2.2% + clamp(92px,15cqw,200px))!important;bottom:calc(2.4% + 38px)!important;display:flex!important;align-items:center;justify-content:flex-end;gap:clamp(4px,.7cqw,9px);pointer-events:auto}
.site-info-links a{display:inline-flex;align-items:center;justify-content:center;min-height:clamp(24px,3.6cqw,36px);box-sizing:border-box;padding:4px clamp(7px,1cqw,12px);border:1px solid #fff;border-radius:999px;background:#fffdf0e8;color:#35456d;box-shadow:0 3px 9px #35456530;font-family:system-ui,"Noto Sans KR","Malgun Gothic",sans-serif;font-size:clamp(8px,.95cqw,12px);font-weight:900;line-height:1;text-decoration:none;white-space:nowrap}
#pb-game-mode summary,.topbar .menu-button{min-height:28px;padding:7px 10px;border:2px solid #6c482f;border-radius:12px;background:#fff7d8f5;color:#343027;box-shadow:0 3px 0 #765436;font:900 12px/1.3 system-ui,sans-serif}
.menu-list{min-width:185px;margin-top:8px;padding:6px;border:2px solid #6c482f;border-radius:12px;background:#fffced;box-shadow:0 9px 22px #32201059}
#pb-game-mode nav a,.menu-list a{display:block;margin:0;padding:10px;border:0;border-radius:7px;background:transparent;color:#3f3226;box-shadow:none;font-weight:900;text-decoration:none}
#pb-game-mode nav a:hover,#pb-game-mode nav a:focus-visible,.menu-list a:hover,.menu-list a:focus-visible{background:#f8e5a4}
.menu .locale-control{right:1.2%!important;top:1.4%!important;bottom:auto!important}
.topbar .lang-picker{position:absolute;top:0;right:0}
.locale-control select,.topbar .lang-picker{box-sizing:border-box;max-width:104px;min-height:clamp(28px,5.4cqh,40px);padding:4px 20px 4px 9px;border:1px solid #ffffffed;border-radius:999px;background:#fffef4;color:#293b60;font:700 clamp(9px,1cqw,12px)/1.2 system-ui,sans-serif;box-shadow:0 2px 7px #34486b36;touch-action:manipulation}
.locale-control select:focus-visible,.topbar .lang-picker:focus-visible{outline:3px solid #f0bd48;outline-offset:2px}

#pb-game-mode .mode-label,#pb-game-mode .mode-pot,#pb-game-mode .mode-ginkgo{display:none}
html[lang="ko"] #pb-game-mode .mode-label-ko,html[lang="ko"] #pb-game-mode .mode-pot-ko,html[lang="ko"] #pb-game-mode .mode-ginkgo-ko{display:inline}
html[lang="en"] #pb-game-mode .mode-label-en,html[lang="en"] #pb-game-mode .mode-pot-en,html[lang="en"] #pb-game-mode .mode-ginkgo-en{display:inline}
html[lang="ja"] #pb-game-mode .mode-label-ja,html[lang="ja"] #pb-game-mode .mode-pot-ja,html[lang="ja"] #pb-game-mode .mode-ginkgo-ja{display:inline}
html[lang="zh"] #pb-game-mode .mode-label-zh,html[lang="zh"] #pb-game-mode .mode-pot-zh,html[lang="zh"] #pb-game-mode .mode-ginkgo-zh{display:inline}
#pb-game-mode nav a[aria-current="page"]{background:#f8e5a4}
.topbar{justify-content:flex-end}
/* Shared footer and 16:9 stage sizing for Pot Breaker and Ginkgo Tree Breaker. */
:root{--pb-footer-h:clamp(72px,9vh,104px)}
html,body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}
body{min-height:100dvh!important}
.viewport{position:relative!important;inset:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:280px;box-sizing:border-box;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;background:linear-gradient(135deg,#c8e8ff,#9acaf6)!important}
.stage{position:relative!important;left:auto!important;top:auto!important;flex:0 0 auto!important;width:min(100vw,calc((100dvh - var(--pb-footer-h))*1.77778))!important;height:min(calc(100dvh - var(--pb-footer-h)),56.25vw)!important;transform:none!important;margin:auto!important}
.site-footer{position:relative;z-index:50;width:100%;max-width:none!important;min-height:var(--pb-footer-h);box-sizing:border-box;display:grid;place-items:center;margin:0!important;padding:8px clamp(12px,2vw,28px);background:linear-gradient(100deg,#dff5ff,#b9e0fa 55%,#99cdf2);border-top:1px solid #ffffffc7;color:#293b60}
.site-guide{width:min(100%,1280px);display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:clamp(8px,1.6vw,22px)}
.site-guide-copy h1,.site-guide-copy h2{margin:0 0 3px;font-size:clamp(11px,1.15vw,16px);line-height:1.2}.site-guide-copy p{margin:0;font-size:clamp(9px,.9vw,12px);line-height:1.35}
.site-guide-howto{position:relative;font-size:clamp(9px,.9vw,12px)}.site-guide-howto summary{cursor:pointer;font-weight:800;white-space:nowrap}.site-guide-howto p{max-width:min(55vw,520px);margin:6px 0 0}
.site-guide nav{display:flex;gap:clamp(6px,1vw,14px);flex-wrap:wrap;justify-content:flex-end;font-size:clamp(9px,.9vw,12px)}.site-guide a{color:#244e70;text-underline-offset:2px}
/* Keep shared navigation and legal links out of the active playfield. */
body.is-playing{--pb-footer-h:0px!important}
body.is-playing #home,body.is-playing #title,body.is-playing #pb-game-mode,body.is-playing .topbar,body.is-playing .game-switch,body.is-playing .site-info-links,body.is-playing .site-footer{display:none!important}
body.is-ginkgo-subview #home,body.is-ginkgo-subview .game-switch,body.is-pot-subview #title,body.is-pot-subview .game-switch,body.is-pot-subview .site-info-links{display:none!important}
@media(max-width:700px){:root{--pb-footer-h:clamp(96px,16vh,136px)}.site-guide{grid-template-columns:minmax(0,1fr);align-items:start;gap:5px}.site-guide-copy{grid-column:auto}.site-guide-copy h1,.site-guide-copy h2{font-size:12px}.site-guide-copy p{font-size:10px;line-height:1.3}.site-guide nav{justify-content:flex-start;font-size:10px}.site-guide-howto{font-size:10px}.site-guide-howto p{max-width:90vw}}
@media(orientation:portrait) and (pointer:coarse){
 .viewport{position:relative!important;inset:auto!important;height:calc(100dvh - var(--pb-footer-h))!important;min-height:220px!important;width:100vw!important;display:block!important;overflow:hidden!important}
 .stage{position:relative!important;left:auto!important;top:auto!important;width:100vw!important;height:calc(100dvh - var(--pb-footer-h))!important;transform:none!important;transform-origin:center center!important;margin:0!important;aspect-ratio:auto!important;border-radius:0!important}
 body.is-playing .viewport{position:fixed!important;inset:0!important;height:100dvh!important}
 body.is-playing .stage{position:absolute!important;left:50%!important;top:50%!important;width:min(100dvh,177.778vw)!important;height:min(100vw,56.25dvh)!important;transform:translate(-50%,-50%) rotate(90deg)!important}
 #title .home-start,.cover-actions .home-start--visible{left:50%!important;top:40.5%!important;width:min(82%,320px)!important;height:clamp(52px,9vh,70px)!important;transform:translateX(-50%)!important;font-size:clamp(17px,5vw,22px)!important}
 #title .home-ranking,.cover-actions .home-ranking{left:50%!important;bottom:3%!important;transform:translateX(-50%)!important}
 .game-switch{left:50%!important;bottom:calc(3% + 46px)!important;width:min(82%,260px)!important;transform:translateX(-50%)!important}
 .site-info-links{right:50%!important;bottom:2%!important;transform:translateX(50%)!important;gap:5px!important}
 .site-info-links a{font-size:10px!important}
 #intro{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,1fr) auto!important;gap:8px!important;padding:56px 12px 12px!important}
 #intro>.comic-cover-wrap{height:40vh!important;max-height:40vh!important;min-height:0!important}
 #intro>.intro-side{height:auto!important;max-height:calc(100% - 40vh - 8px)!important;min-height:clamp(220px,34vh,280px)!important;overflow:auto!important;align-items:stretch!important;gap:8px!important;padding:10px!important}
 #intro .difficulty-picker{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 #intro .difficulty-picker span{grid-column:1/-1!important}
 #intro .intro-side h2{font-size:clamp(18px,5vw,26px)!important}
 #intro .intro-side p,#intro .intro-side small{font-size:12px!important}
 #home .cover-frame{width:100%!important;height:100%!important;max-width:none!important;aspect-ratio:auto!important}
 #home .cover-image{object-fit:cover!important;object-position:center 50%!important}
 .intro-layout{width:100%!important;height:100%!important;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(0,32vh) minmax(0,1fr)!important;gap:8px!important;padding:56px 10px 10px!important}
 .intro-art{height:100%!important;max-height:32vh!important;min-height:0!important}
 .intro-comic-image{width:100%!important;height:100%!important;object-fit:contain!important}
 .intro-panel{height:auto!important;min-height:clamp(250px,36vh,300px)!important;max-height:calc(100% - 32vh - 8px)!important;overflow:auto!important;padding:12px!important}
 .intro-panel h1{font-size:clamp(18px,5vw,26px)!important}
 .intro-panel .intro-copy,.intro-panel .intro-help{font-size:12px!important}
 .intro-panel .difficulties{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:4px!important}
 .intro-panel .difficulties label{font-size:10px!important;padding:8px 4px!important}
 .intro-panel .action{min-height:44px!important}
 .play-area{inset:1.5%!important;width:97%!important;height:97%!important}
 .hud{margin-top:clamp(50px,8vh,76px)!important}
}

</style>
</head>
<body>
<div class="viewport"><div class="stage" id="ginkgo-stage">
<header class="topbar">
<select id="language" class="lang-picker" aria-label="Language"><option value="ko">\uD55C\uAD6D\uC5B4</option><option value="en">English</option><option value="ja">\u65E5\u672C\u8A9E</option><option value="zh">\u4E2D\u6587</option></select>
</header>
<main class="container">
<section id="home" class="cover-screen">
<div class="cover-frame">
<img class="cover-image" src="{{COVER_IMAGE}}" alt="\u5409\u55B5\u548C\u514B\u8FBE\u90E8\u957F\u671B\u7740\u91D1\u9EC4\u8272\u7684\u94F6\u674F\u5927\u9053" width="995" height="560" decoding="async" fetchpriority="high">
</div>
<div class="cover-actions">
<div class="cover-copy"><small data-i18n="theme">\uD3FF \uBE0C\uB808\uC774\uCEE4 \uD14C\uB9C8 2</small><h1><span data-i18n="title1">\uAE45\uCF54\uD2B8\uB9AC</span> <span data-i18n="title2">\uBE0C\uB808\uC774\uCEE4!</span></h1><p data-i18n="subtitle">\uB9CE\uC774 \uBF51\uC744\uC218\uB85D \uC88B\uC740 \uAC74\uAC00...? \uC369\uAE30 \uC804\uC5D0 \uC740\uD589\uC744 \uD130\uCE58\uD574 \uC810\uC218\uB97C \uC62C\uB9AC\uC138\uC694!</p></div>
<button class="action cover-start home-start home-start--visible" id="open-intro" data-i18n="open">\uAC8C\uC784 \uC2DC\uC791</button>
<button class="action secondary home-ranking" id="ranks-from-home" data-i18n="home_ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</button><a class="game-switch" id="potbreaker-link" href="/"><span data-i18n="pot">\u{1FAB4} \uD3FF\uBE0C\uB808\uC774\uCEE4 RE</span></a>
</div>
<nav class="site-info-links" aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav></section>
<section id="intro" class="intro-screen" hidden>
<div class="intro-layout">
<figure class="intro-art"><img class="intro-comic-image" src="{{COMIC_IMAGE}}" alt="\u63CF\u7ED8\u5409\u55B5\u4E0A\u73ED\u9014\u4E2D\u63A5\u5230\u94F6\u674F\u6811\u6E05\u9664\u5DE5\u4F5C\u7684\u56DB\u683C\u6F2B\u753B" width="600" height="600" decoding="async" fetchpriority="high"></figure>
<aside class="intro-panel surface">
<p class="episode">EP.02 / GINKGO TREE BREAKER</p>
<h1 data-i18n="intro_title">\uAE30\uBB18\uC758 \uC774\uC0C1\uD55C \uCD9C\uADFC\uAE38</h1>
<p class="intro-copy" data-i18n="intro_copy">\uC740\uD589\uC774 \uC369\uAE30 \uC804\uC5D0 \uD130\uCE58\uD574 \uC5C6\uC560\uC138\uC694. 60\uCD08 \uB3D9\uC548 \uC810\uC218\uB97C \uBAA8\uC544 \uB7AD\uD0B9\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4.</p>
<div class="difficulties">
<label><input type="radio" name="difficulty" value="normal" checked> NORMAL <small>3s</small></label>
<label><input type="radio" name="difficulty" value="hard"> HARD <small>2s</small></label>
<label><input type="radio" name="difficulty" value="very_hard"> VERY HARD <small>1s</small></label>
</div>
<button class="action cover-start" id="begin" data-i18n="enter">\uC740\uD589\uB098\uBB34\uB85C \uCD9C\uADFC \u25B6</button>
<button class="action secondary" id="intro-back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
<p class="intro-help" data-i18n="intro_help">\uB178\uB780 \uC740\uD589\uB9CC \uD130\uCE58\uD558\uC138\uC694. \uC78E\uC740 \uCF64\uBCF4\uB97C \uB04A\uACE0, \uC369\uC740 \uC740\uD589\uC740 0.5\uCD08 \uB3D9\uC548 \uC785\uB825\uC744 \uB9C9\uC2B5\uB2C8\uB2E4.</p>
<p class="status" id="begin-status" aria-live="polite"></p>
</aside>
</div>
</section>
<section id="play" class="play-area" hidden aria-label="Ginkgo Tree Breaker game">
<div class="hud"><div class="stat">\u{1F3C6} <span data-i18n="score">\uC810\uC218</span> <b id="score">0</b></div><div class="stat time">\u23F1\uFE0F <b id="timer">60.0</b>s</div><div class="stat">\u{1F525} <span data-i18n="combo">\uC5F0\uC18D</span> <b id="combo">0</b></div></div>
<div class="board-wrap"><div id="board" class="board" role="group" aria-label="Ginkgo trees"></div></div>
<p id="lock-message" class="lock-message" aria-live="polite"></p>
</section>
<section id="end" class="surface" hidden>
<h2 data-i18n="finished">60\uCD08 \uC885\uB8CC!</h2><div class="end-grid"><div class="stat"><span data-i18n="score">\uC810\uC218</span><br><b id="final-score">0</b></div><div class="stat"><span data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</span><br><b id="final-combo">0</b></div></div>
<label for="nickname" data-i18n="name">\uB7AD\uD0B9\uC5D0 \uD45C\uC2DC\uD560 \uB2C9\uB124\uC784</label><br><input class="nickname" maxlength="16" id="nickname" autocomplete="nickname" placeholder="Gimyo">
<div><button class="action" id="submit" data-i18n="submit">\uB7AD\uD0B9 \uB4F1\uB85D</button><button class="action secondary" id="retry" data-i18n="retry">\uB2E4\uC2DC \uC2DC\uC791</button></div>
<p id="result-status" class="status" aria-live="polite"></p>
</section>
<section id="rankings" class="surface" hidden>
<h2 data-i18n="ranking">\u{1F3C6} \uB7AD\uD0B9 \uBCF4\uAE30</h2><p data-i18n="ranking_info">\uC810\uC218 \uC6B0\uC120 \xB7 \uB3D9\uC810 \uC2DC \uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5 \xB7 1~3\uC704 \uC601\uAD6C \uBCF4\uAD00 / 4\uC704 \uC774\uD558 \uB9E4\uC6D4 1\uC77C \uC0AD\uC81C</p>
<select id="rank-difficulty" class="lang-picker"><option value="normal">NORMAL</option><option value="hard">HARD</option><option value="very_hard">VERY HARD</option></select>
<div style="overflow-x:auto"><table><thead><tr><th data-i18n="place">\uC21C\uC704</th><th data-i18n="player">\uD50C\uB808\uC774\uC5B4</th><th data-i18n="score">\uC810\uC218</th><th data-i18n="best">\uCD5C\uB300 \uC5F0\uC18D \uC131\uACF5</th></tr></thead><tbody id="ranking-rows"></tbody></table></div>
<p id="rank-status" class="status" aria-live="polite"></p><button class="action secondary" id="back" data-i18n="back">\uCC98\uC74C\uC73C\uB85C</button>
</section>
</main></div></div>
<footer class="site-footer" id="site-footer">
<section class="site-guide" aria-labelledby="ginkgo-guide-heading">
<div class="site-guide-copy"><h2 id="ginkgo-guide-heading">\u94F6\u674F\u6811\u7834\u574F\u8005\u73A9\u6CD5</h2><p>60\u79D2\u5185\u70B9\u51FB\u672A\u8150\u70C2\u7684\u94F6\u674F\u679C\u3002\u4E09\u79CD\u96BE\u5EA6\u3001\u8FDE\u7EED\u6210\u529F\u52A0\u5206\u548C\u6392\u884C\u699C\u3002</p></div>
<details class="site-guide-howto"><summary data-i18n="howto">\uAC8C\uC784 \uBC29\uBC95</summary><p>60\u79D2\u5185\u70B9\u51FB\u9EC4\u8272\u94F6\u674F\u679C\u5F97\u5206\uFF0C\u8FDE\u7EED\u6210\u529F\u5F97\u5206\uFF1A\u666E\u901A1\xB72\xB73\u5206\uFF0C\u56F0\u96BE2\xB74\xB76\u5206\uFF0C\u8D85\u96BE3\xB76\xB79\u5206\u3002\u70B9\u51FB\u6811\u53F6\u6216\u8150\u70C2\u7684\u94F6\u674F\u679C\u4F1A\u91CD\u7F6E\u8FDE\u51FB\uFF0C\u8150\u70C2\u7684\u679C\u5B9E\u8FD8\u4F1A\u8BA9\u70B9\u51FB\u6682\u505C0.5\u79D2\u3002\u4E09\u79CD\u96BE\u5EA6\u7684\u9636\u6BB5\u65F6\u95F4\u4E3A3\u79D2\u30012\u79D2\u548C1\u79D2\u3002</p></details>
<nav aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about" data-i18n="about">\uAC8C\uC784 \uC18C\uAC1C</a><a href="/privacy" data-i18n="privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav>
</section>
</footer>
<script type="module" src="/modules/ginkgo/main.js"><\/script>
</body></html>
