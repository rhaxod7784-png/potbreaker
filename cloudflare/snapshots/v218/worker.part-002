var PAGE = `<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"><meta name="theme-color" content="#84c7f7"><title>POT BREAKER RE v1.0.93 \xB7 CBZP</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900;1000&family=Gowun+Dodum&display=swap');
:root{--navy:#303d67;--royal:#5578bd;--cream:#fff9ee;--sky:#93d0fa;--coral:#f8a76d;--gold:#ffd47e;--shadow:#3b466e54;font-family:'Nunito','Gowun Dodum','Malgun Gothic',system-ui,sans-serif}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#8dc6f4;color:var(--navy)}button{font:inherit;cursor:pointer;touch-action:manipulation}button:focus-visible{outline:3px solid #ffbe6d;outline-offset:3px}.viewport{height:100dvh;width:100vw;display:grid;place-items:center;background:radial-gradient(circle at 50% 0%,#dff8ff 0,#a5d9fc 45%,#70b8ee 100%)}
.stage{aspect-ratio:16/9;width:min(100vw,177.778dvh);height:min(100dvh,56.25vw);container-type:size;container-name:game-stage;position:relative;overflow:hidden;isolation:isolate;background:#f6eedf;box-shadow:0 2vh 7vh #2b467669}.hidden{display:none!important}.screen{position:absolute;inset:0;z-index:2;overflow:hidden}.menu{background:linear-gradient(115deg,#e7f8ff 0%,#b0dffc 64%,#98cafa);display:flex;align-items:center;padding:4.5%;gap:4%}.menu::before{content:"";position:absolute;inset:-7%;background:url('data:image/webp;base64,