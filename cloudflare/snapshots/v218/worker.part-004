<section class="screen menu" id="title" aria-label="POT BREAKER RE \uBA54\uC778 \uD654\uBA74"><img class="title-illustration" src="data:image/webp;base64," alt="CBZP \uC0AC\uBB34\uC2E4 \uBC30\uACBD\uC758 POT BREAKER RE \uBA54\uC778 \uD654\uBA74. \uC544\uB798\uC5D0\uB294 \uB4A4\uB3CC\uC544\uC120 \uAE30\uBB18\uC640 \uD06C\uB2E4 \uBD80\uC7A5\uC774 \uBCF4\uC785\uB2C8\uB2E4."><span class="actual-version">POT BREAKER RE v1.0.93</span><button class="start-art-button home-start" id="openIntro" aria-label="\uAC8C\uC784 \uC2DC\uC791">\uAC8C\uC784 \uC2DC\uC791</button><button class="menu-ranking home-ranking" id="openRanking">\u{1F3C6} \uB7AD\uD0B9</button><label class="locale-control"><span class="sr-only">\uC5B8\uC5B4 \uC120\uD0DD</span><select id="pb-locale" aria-label="\uC5B8\uC5B4 \uBCC0\uACBD"><option value="ko">\uD55C\uAD6D\uC5B4</option><option value="en">English</option><option value="zh">\u4E2D\u6587</option><option value="ja">\u65E5\u672C\u8A9E</option></select></label><a class="game-switch" id="openGinkgo" href="/ginkgo"><span class="ginkgo-ko">\u{1F342} \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4</span><span class="ginkgo-en">\u{1F342} Ginkgo Tree Breaker</span><span class="ginkgo-zh">\u{1F342} \u94F6\u674F\u6811\u7834\u574F\u8005</span><span class="ginkgo-ja">\u{1F342} \u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC</span></a><nav class="site-info-links" aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/about"><span class="info-ko">\uAC8C\uC784 \uC18C\uAC1C</span><span class="info-en">About</span><span class="info-zh">\u6E38\u620F\u4ECB\u7ECD</span><span class="info-ja">\u30B2\u30FC\u30E0\u7D39\u4ECB</span></a><a href="/privacy"><span class="info-ko">\uAC1C\uC778\uC815\uBCF4\xB7\uAD11\uACE0</span><span class="info-en">Privacy &amp; ads</span><span class="info-zh">\u9690\u79C1\u4E0E\u5E7F\u544A</span><span class="info-ja">\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u30FB\u5E83\u544A</span></a><a href="https://djgimyo.com/home.html" target="_blank" rel="noopener noreferrer" aria-label="대전의 기묘한 여행, 새 창"><span class="info-ko">🐈 기묘의 대전 여행</span><span class="info-en">🐈 Gimyo in Daejeon</span><span class="info-zh">🐈 奇妙的大田旅行</span><span class="info-ja">🐈 キミョの大田旅</span></a></nav></section>
<section class="screen intro hidden" id="intro"><img class="comic-cover" src="data:image/webp;base64,