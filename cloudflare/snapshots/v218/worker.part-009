var BROWSER_MODULES = { "/modules/ginkgo/board-view.js": "export class GinkgoBoardViewModule {\n  constructor({root, onTap, total = 91}) {\n    this.root = root;\n    this.onTap = onTap;\n    this.total = total;\n    this.cells = [];\n  }\n  mount() {\n    if (this.cells.length) return this;\n    const fragment = document.createDocumentFragment();\n    for (let index = 0; index < this.total; index++) {\n      const button = document.createElement('button');\n      button.type = 'button';\n      button.className = 'cell';\n      button.setAttribute('aria-label', `Tree ${index + 1}`);\n      const trunk = document.createElement('span');\n      trunk.className = 'trunk';\n      const tree = document.createElement('span');\n      tree.className = 'tree leaf0';\n      button.append(trunk, tree);\n      button.addEventListener('pointerdown', event => {\n        if (event.pointerType !== 'mouse') event.preventDefault();\n        this.onTap(index);\n      });\n      button.addEventListener('click', event => {\n        if (event.detail === 0) this.onTap(index);\n      });\n      this.cells.push(tree);\n      fragment.append(button);\n    }\n    this.root.replaceChildren(fragment);\n    return this;\n  }\n  render(phases) {\n    this.mount();\n    phases.forEach((phase, index) => {\n      if (this.cells[index]) this.cells[index].className = `tree ${['leaf0', 'leaf1', 'fruit2', 'fruit3'][phase] || 'leaf0'}`;\n    });\n  }\n  dispose() {\n    this.cells = [];\n    this.root.replaceChildren();\n  }\n}\n", "/modules/ginkgo/local-engine.js": "export class XorShiftRandomModule {\n  constructor(seed) { this.seed = seed >>> 0; }\n  next() {\n    let value = this.seed >>> 0;\n    value ^= value << 13; value ^= value >>> 17; value ^= value << 5;\n    this.seed = value >>> 0;\n    return this.seed / 4294967296;\n  }\n  sex() { return this.next() < .5 ? 0 : 1; }\n}\n\nexport class GinkgoRoundClockModule {\n  constructor(durationMs, intervalMs, remainingMs = durationMs) {\n    this.durationMs = durationMs;\n    this.intervalMs = intervalMs;\n    this.startedAt = Date.now() - (durationMs - remainingMs);\n    this.tick = 0;\n  }\n  target(now) { return Math.max(this.tick, Math.min(Math.ceil(this.durationMs / this.intervalMs), Math.floor(Math.max(0, now - this.startedAt) / this.intervalMs))); }\n  remaining(now) { return Math.max(0, this.durationMs - (now - this.startedAt)); }\n}\n\nexport class GinkgoBoardStateModule {\n  constructor(random, size = 91) {\n    this.random = random;\n    this.cells = Array.from({length:size}, () => {\n      const phase = Math.floor(random.next() * 4);\n      return {phase, sex:phase >= 2 ? 1 : random.sex()};\n    });\n  }\n  advance(steps) {\n    for (let step = 0; step < steps; step++) for (const cell of this.cells) {\n      if (cell.phase === 0) cell.phase = 1;\n      else if (cell.phase === 1) { if (cell.sex === 1) cell.phase = 2; else { cell.phase = 0; cell.sex = this.random.sex(); } }\n      else if (cell.phase === 2) cell.phase = 3;\n      else { cell.phase = 0; cell.sex = this.random.sex(); }\n    }\n  }\n  static fromState(random, cells) {\n    const board = Object.create(GinkgoBoardStateModule.prototype);\n    board.random = random;\n    board.cells = cells;\n    return board;\n  }\n  tap(index, scoring, inputLock, now) {\n    const cell = this.cells[index];\n    if (!cell) return false;\n    if (cell.phase === 2) { scoring.success(); cell.phase = 0; cell.sex = this.random.sex(); }\n    else { scoring.miss(); if (cell.phase === 3) inputLock.lock(now); }\n    return true;\n  }\n}\n\nexport class GinkgoComboScoringModule {\n  constructor(multiplier = 1) { this.multiplier = typeof multiplier === 'string' ? ({normal:1, hard:2, very_hard:3}[multiplier] || 1) : multiplier; this.score = 0; this.combo = 0; this.maxCombo = 0; }\n  success() { this.combo++; this.score += this.combo * this.multiplier; this.maxCombo = Math.max(this.maxCombo, this.combo); }\n  miss() { this.combo = 0; }\n}\n\nexport class GinkgoInputLockModule {\n  constructor(durationMs = 500) { this.durationMs = durationMs; this.until = 0; }\n  lock(now) { this.until = now + this.durationMs; }\n  isLocked(now) { return now < this.until; }\n}\n\nexport class GinkgoLocalEngineModule {\n  constructor(seed, difficulty, remainingMs = 60000) {\n    const interval = {normal:3000, hard:2000, very_hard:1000}[difficulty];\n    this.random = new XorShiftRandomModule(seed);\n    this.clock = new GinkgoRoundClockModule(60000, interval, remainingMs);\n    this.board = new GinkgoBoardStateModule(this.random);\n    this.scoring = new GinkgoComboScoringModule({normal:1, hard:2, very_hard:3}[difficulty]);\n    this.inputLock = new GinkgoInputLockModule();\n  }\n  advance(now = Date.now()) {\n    const target = this.clock.target(now);\n    this.board.advance(target - this.clock.tick);\n    this.clock.tick = target;\n  }\n  tap(index) {\n    const now = Date.now(); this.advance(now);\n    if (this.inputLock.isLocked(now)) return false;\n    return this.board.tap(index, this.scoring, this.inputLock, now);\n  }\n  step() { this.advance(); }\n  sync(snapshot) {\n    if (!snapshot.state) return;\n    const state = snapshot.state;\n    this.random.seed = state.rng >>> 0;\n    this.clock.tick = state.tick;\n    this.scoring.score = state.score; this.scoring.combo = state.combo; this.scoring.maxCombo = state.max_combo;\n    this.inputLock.until = state.lock_until;\n    this.board.cells = state.cells.map(cell => ({...cell}));\n  }\n  state(now = Date.now()) {\n    this.advance(now);\n    const remaining = this.clock.remaining(now);\n    return {score:this.scoring.score, combo:this.scoring.combo, max_combo:this.scoring.maxCombo,\n      cells:this.board.cells.map(cell => cell.phase), remaining_ms:remaining,\n      locked:this.inputLock.isLocked(now), locked_until:this.inputLock.until,\n      phase:remaining <= 0 ? 'finished' : 'playing'};\n  }\n}\n", "/modules/ginkgo/main.js": `"use strict";
