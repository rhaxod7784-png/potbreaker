    ja: { title: "Pot Breaker RE | CBZP\u30AA\u30D5\u30A3\u30B9\u8FF7\u8DEF\u30C1\u30A7\u30A4\u30B9", description: "\u732B\u306E\u30A4\u30F3\u30BF\u30FC\u30F3\u3001\u30AE\u30DF\u30E7\u304C\u30AF\u30C0\u90E8\u9577\u306B\u6311\u3080\u30D6\u30E9\u30A6\u30B6\u30FC\u8FF7\u8DEF\u30B2\u30FC\u30E0 Pot Breaker RE\u3002\u64CD\u4F5C\u65B9\u6CD5\u3001\u30B2\u30FC\u30E0\u30EB\u30FC\u30EB\u3001\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u3001\u5E83\u544A\u306B\u3064\u3044\u3066\u3002", heading: "\u30AE\u30DF\u30E7\u5BFE\u30AF\u30C0\u90E8\u9577\uFF1ACBZP\u30AA\u30D5\u30A3\u30B9\u8FF7\u8DEF\u30C1\u30A7\u30A4\u30B9", summary: "CBZP\u306E\u30A4\u30F3\u30BF\u30FC\u30F3\u732B\u30AE\u30DF\u30E7\u3092\u64CD\u4F5C\u3057\u3066\u3001\u30AA\u30D5\u30A3\u30B9\u8FF7\u8DEF\u3067\u30AF\u30C0\u90E8\u9577\u3092\u907F\u3051\u306A\u304C\u3089\u690D\u6728\u9262\u3092\u6295\u3052\u308B\u4E00\u4EBA\u7528\u30B2\u30FC\u30E0\u3067\u3059\u3002", og: "\u732B\u306E\u30AE\u30DF\u30E7\u3068\u30EF\u30CB\u306E\u30AF\u30C0\u90E8\u9577\u304C\u767B\u5834\u3059\u308B\u30D6\u30E9\u30A6\u30B6\u30FC\u8FF7\u8DEF\u30C1\u30A7\u30A4\u30B9\u3002" }
  };
  let localizedPage = PAGE.replace("</nav></details>", "<a id=\"pb-mode-floor\" href=\"/floor\"><span class=\"mode-ginkgo mode-ginkgo-ko\">♟ 플로어 브레이커</span><span class=\"mode-ginkgo mode-ginkgo-en\">♟ Floor Breaker</span><span class=\"mode-ginkgo mode-ginkgo-ja\">♟ フロアブレイカー</span><span class=\"mode-ginkgo mode-ginkgo-zh\">♟ 地板破坏者</span></a></nav></details>").replace('<html lang="ko">', `<html lang="${pageLocale}">`).replace('<link rel="canonical" href="https://potbreaker.com/">', `<link rel="canonical" href="https://potbreaker.com${localePath}">`).replace('<meta property="og:locale" content="ko_KR">', `<meta property="og:locale" content="${ogLocale}">`);
  if (HOME_SEO[pageLocale]) {
    const seo = HOME_SEO[pageLocale];
    localizedPage = localizedPage.replace(/<title>[\s\S]*?<\/title>/, `<title>${seo.title}</title>`).replace(/<meta name="description" content="[^"]*">/, `<meta name="description" content="${seo.description}">`).replace(/<meta property="og:title" content="[^"]*">/, `<meta property="og:title" content="${seo.title}">`).replace(/<meta property="og:description" content="[^"]*">/, `<meta property="og:description" content="${seo.og}">`).replace(/<h1 id="seo-heading">[\s\S]*?<\/h1>/, `<h1 id="seo-heading">${seo.heading}</h1>`).replace(/(<div class="site-guide-copy">\s*<h1 id="seo-heading">[\s\S]*?<\/h1>\s*<p>)[\s\S]*?(<\/p>)/, `$1${seo.summary}$2`);
  }
  const body = page ? localizedPage.replace("</head>", verification + "</head>") : GAME;
  return new Response(request.method === "HEAD" ? null : body, { status: 200, headers: responseHeaders });
}, async scheduled(controller, env) {
  await ginkgoCronCleanup(env, controller.scheduledTime);
} };
var FLOOR_PAGE="<!doctype html><html lang=\"ko\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#c8e7fc\"><meta name=\"description\" content=\"CBZP 플로어 브레이커: 11×11 4인 난장체스 게임.\"><title>플로어 브레이커 | CBZP POT BREAKER</title><style>\r\n:root{font-family:system-ui,'Malgun Gothic',sans-serif;color:#34405d;--ink:#34405d;--blue:#455b92;--cream:#fffaf2;--gold:#f7ca77}*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:linear-gradient(150deg,#c8dffa,#fcf5ef 65%,#f7e9f4)}button,select{font:inherit}button{cursor:pointer;touch-action:manipulation}button:focus-visible,select:focus-visible{outline:3px solid #bd812c;outline-offset:2px}button:disabled{opacity:.5;cursor:not-allowed}.top{background:#ffffffdc;padding:12px 18px;border-bottom:1px solid #b4c4db;display:flex;gap:16px;align-items:center;justify-content:space-between}.top strong{font-weight:900}.top a{color:#405588}.wrap{max-width:1020px;margin:auto;padding:13px}.screen{background:#fffcf7f2;border:2px solid #aab7d1;border-radius:22px;padding:clamp(14px,3vw,27px);box-shadow:0 8px 22px #4e59751a;margin:14px 0}.hidden{display:none!important}.kicker{font-weight:900;letter-spacing:.1em;color:#6473a6;font-size:.78rem}h1{font-size:clamp(40px,7vw,72px);line-height:1;margin:10px 0;color:#495883;text-shadow:2px 3px #e8ddeb}h2{margin:4px 0 12px}.lead{font-size:1.13rem;line-height:1.6}.btn{padding:11px 20px;background:#f9d58a;color:#3d405d;border:2px solid #8c7395;border-radius:12px;font-weight:850;box-shadow:0 3px #a5a0c0}.btn.alt{background:#dbe6fc}.btn.small{padding:8px 12px}.hero{display:grid;grid-template-columns:1fr 1.1fr;gap:14px;align-items:center}.cast{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;justify-content:center}.cast figure{flex:1;min-width:0;margin:0;padding:12px 3px;background:#f8edf1;border-radius:20px;text-align:center}.cast img{width:100%;max-height:195px;object-fit:contain}.cast figcaption{font-weight:850}.comic{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.panel{min-height:180px;position:relative;padding:15px;background:linear-gradient(160deg,#ebf3ff,#fff3eb);border:2px solid #afbad1;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between}.panel small{font-weight:950;color:#7583a5}.panel p{font-weight:800;line-height:1.45;margin:5px}.scene{display:flex;align-items:center;justify-content:center;gap:8px;min-height:100px}.scene img{height:100px;width:35%;object-fit:contain}.scene .bang{font-size:40px}.pick{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.choice{border:3px solid #bac6de;border-radius:18px;background:#f9f5f1;padding:8px;min-width:0;color:var(--ink);text-align:center}.choice.selected{border-color:#be8a3e;background:#fff2d7}.choice img{width:100%;height:140px;object-fit:contain}.choice strong,.choice small{display:block}.choice small{margin-top:6px;font-size:12px}.status{font-weight:750;line-height:1.5;min-height:1.5em}.game{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:15px;align-items:start}.board-box{background:#e7eef9;border:2px solid #9bacd2;border-radius:15px;padding:8px;display:flex;justify-content:center}.board{width:min(100%,660px);display:grid;grid-template-columns:repeat(11,minmax(0,1fr));aspect-ratio:1/1;background:#53688e;border:2px solid #53688e;gap:1px;touch-action:manipulation}.cell{aspect-ratio:1/1;min-width:0;min-height:0;border:0;position:relative;display:flex;align-items:center;justify-content:center;padding:0;font-size:12px}.cell.light{background:#f5ead6}.cell.dark{background:#bdc9db}.cell.eroded{background:#536070}.cell.used{background:#705878;box-shadow:inset 0 0 0 2px #eec4ef}.cell.restore{background:#d9a6e9!important;box-shadow:inset 0 0 0 3px #7936aa!important;cursor:pointer}.cell .trap-mark{font-size:17px;color:#fff;font-weight:900;text-shadow:0 1px 2px #322}.cell.hint:after{content:\"\";position:absolute;width:32%;height:32%;background:#379a6fba;border-radius:50%}.cell.attack{box-shadow:inset 0 0 0 3px #db6666}.cell.selected{box-shadow:inset 0 0 0 3px #efb454}.handoff{position:fixed;inset:0;z-index:90;display:grid;place-items:center;background:#1b2c49f5;padding:24px}.handoff-card{max-width:460px;width:100%;padding:28px;border:3px solid #f4ce79;border-radius:22px;background:#fffaf0;text-align:center;box-shadow:0 15px 45px #1119}.handoff-card h2{margin:8px 0}.handoff-card p{line-height:1.6}.handoff-card .control{justify-content:center}.cell.own-king:after{content:'♛ 왕';position:absolute;right:2px;bottom:2px;padding:1px 3px;border-radius:4px;background:#a72d3b;color:#fff;font-size:clamp(9px,1.8vw,13px);font-weight:950;z-index:3;box-shadow:0 1px 3px #2228}.cell.piece-special:after{content:'✦ 특';position:absolute;right:2px;bottom:2px;padding:1px 3px;border-radius:4px;background:#533b9e;color:#fff;font-size:clamp(9px,1.8vw,13px);font-weight:950;z-index:3;box-shadow:0 1px 3px #2228}.cell.piece-queen:after{content:'♛ Q';position:absolute;right:2px;bottom:2px;padding:1px 3px;border-radius:4px;background:#ae6c19;color:#fff;font-size:clamp(9px,1.8vw,13px);font-weight:950;z-index:3;box-shadow:0 1px 3px #2228}.cell.exposed-king{outline:3px solid #df313b;outline-offset:-3px;box-shadow:inset 0 0 0 2px white}.cell.warning{box-shadow:inset 0 0 0 3px #e17728;background-image:repeating-linear-gradient(45deg,#f7ad5844 0 4px,transparent 4px 8px)}.cell.last-from{outline:3px dashed #4479b2;outline-offset:-3px}.cell.last-to{outline:3px solid #f5a623;outline-offset:-3px;box-shadow:inset 0 0 0 2px #fff6}.cell.last-to:before{content:'▼';position:absolute;right:1px;top:-3px;color:#e86135;font-size:12px;z-index:2}.last-move{margin:5px 0 0;padding:7px 9px;border-radius:9px;background:#e7f1ff;color:#334b70;font-size:12px;font-weight:850;line-height:1.5}.cell img{height:95%;width:95%;object-fit:contain;position:relative;z-index:1;pointer-events:none}.cell.enemy img{filter:drop-shadow(0 0 1px #24374c) drop-shadow(0 0 2px #263b65)}.cell.owner img{filter:drop-shadow(0 0 2px #fff)}.cell.reveal{background-image:repeating-linear-gradient(30deg,#ed8eac33 0 4px,transparent 4px 9px)}.cell .x{color:#fff;font-weight:900}.side{display:grid;gap:10px}.hud{background:#fff;border:1px solid #c1cce0;border-radius:14px;padding:12px}.hud strong{display:block;margin-bottom:6px}.timer{font-size:26px;font-weight:950;font-variant-numeric:tabular-nums}.muted{font-size:12px;color:#697793;line-height:1.6}.pill{font-size:12px;padding:5px 8px;border-radius:99px;background:#e3edff;font-weight:850}.notice{min-height:3em;font-size:13px;line-height:1.6;font-weight:700}.control{display:flex;gap:8px;flex-wrap:wrap}.result{font-weight:900;color:#ac6c33}.rules{font-size:13px;line-height:1.7}.foot{font-size:12px;color:#68768d;text-align:center;padding:15px}.divider{height:1px;background:#ccd8eb;margin:14px 0}@media(max-width:760px){.hero,.game{grid-template-columns:1fr}.cast img{max-height:155px}.side{grid-template-columns:repeat(2,minmax(0,1fr))}.side .hud:last-child{grid-column:1/-1}.board{width:min(100%,390px)}.pick{gap:5px}.choice img{height:100px}.comic{gap:7px}.panel{min-height:150px;padding:9px}.scene img{height:72px}.scene{min-height:80px}.panel p{font-size:13px}}@media(max-width:370px){.board{width:100%}.side{grid-template-columns:1fr}.side .hud:last-child{grid-column:auto}}\r\n\r\n/* v2: visible objectives, focused controls and readable action feedback */\r\n.battle-bar{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:14px;background:#293956;color:#fff;font-size:13px;font-weight:900;margin:0 0 12px;border:2px solid #526998;box-shadow:0 3px 0 #17243b}\r\n.battle-status{white-space:nowrap}.battle-status.enemy{color:#ffdf9d}.battle-status.alert{color:#ffd0c4}.time-track{height:8px;flex:1;min-width:30px;background:#131f35;border-radius:20px;overflow:hidden}.time-track>div{height:100%;width:100%;background:linear-gradient(90deg,#f1b96c,#ffdf8e);border-radius:inherit;transition:width .13s linear}.time-track.danger>div{background:#ff726f}\r\n.arena{min-width:0;position:relative}.board-box{position:relative;overflow:hidden;background:linear-gradient(160deg,#cedbea,#8dadd0);border:3px solid #4e6083;box-shadow:0 9px 0 #50617f,0 15px 26px #24344929}\r\n.board{box-shadow:inset 0 0 20px #18243c55;position:relative}.cell{transition:filter .14s}.cell:not(:disabled):active{filter:brightness(1.17)}.cell.light{background:#f5e3c8}.cell.dark{background:#a9bed1}\r\n.cell.hint{cursor:pointer}.cell.hint:after{box-shadow:0 0 0 4px #68d39a40,0 0 14px #36b88588;animation:hintBreath 1.35s ease-in-out infinite}.cell.attack{background-color:#e9a9a4;animation:attackGlow 1.1s ease-in-out infinite}.cell.selected{background:#fbe8ab!important;box-shadow:inset 0 0 0 3px #e99c31,0 0 9px #e99c31}.cell.owner:not(:disabled){cursor:pointer}.cell img{height:100%;width:100%;filter:drop-shadow(0 1px 1px #221e22a6)}.cell.owner img{filter:drop-shadow(0 0 2px #fff) drop-shadow(0 1px 1px #42351b)}.cell.enemy img{filter:drop-shadow(0 0 1px #263243) drop-shadow(0 2px 1px #081b33)}\r\n.goal-rank{text-align:center;padding:8px 4px;letter-spacing:.02em;font-size:12px;font-weight:950;color:#493d57}.goal-opponent{background:#ffddad;border:2px solid #c98b44;border-radius:12px 12px 4px 4px;margin-bottom:5px;box-shadow:0 3px 0 #dba567}.goal-own{background:#e7edf9;border:2px solid #829ac5;border-radius:4px 4px 12px 12px;margin-top:12px}\r\n.event-toast{position:relative;margin-top:12px;min-height:49px;background:#fff7df;border:2px solid #ceb58b;border-radius:12px;padding:12px 15px;text-align:center;font-weight:900;font-size:13px;line-height:1.5;color:#684b35}.event-toast.event-attack{background:#fff0ea;border-color:#ce827b}.event-toast.event-danger{background:#fbe3e6;border-color:#cc6d87}.event-toast.event-win{background:#fff0b1;border-color:#d4a43e}\r\n.spotlight{display:flex;align-items:center;gap:12px;min-height:88px}.spotlight img{width:76px;height:85px;object-fit:contain;filter:drop-shadow(0 3px 3px #3b445a44)}.spot-name{font-weight:950;margin-bottom:6px}.spotlight-hud .divider{margin:6px 0 12px}.turn-sub{color:#6a7595;font-size:11px}.timer.urgent{color:#c94646;animation:urgentPulse .65s ease-in-out infinite}\r\n.turn-cue{position:absolute;left:50%;top:30%;transform:translate(-50%,-50%);z-index:8;white-space:nowrap;border:2px solid #ffdc8b;border-radius:12px;color:#fff;background:#263b61e8;padding:11px 19px;pointer-events:none;opacity:0;font-weight:950;font-size:clamp(15px,3.2vw,25px);text-shadow:0 2px 1px #171e30;box-shadow:0 7px 20px #27344b66}.turn-cue.active{animation:cueEnter .72s ease-out forwards}\r\n.effect-layer{position:fixed;inset:0;pointer-events:none;z-index:40;overflow:hidden}.flying-piece{position:fixed;pointer-events:none;z-index:50;object-fit:contain;filter:drop-shadow(0 4px 2px #0007)}.burst-symbol{position:fixed;z-index:51;display:grid;place-items:center;width:52px;height:52px;font-size:37px;font-weight:950;pointer-events:none;text-shadow:0 3px 6px #28364b99}.impact-ring{position:fixed;z-index:41;border:5px solid #ffba55;border-radius:50%;pointer-events:none;opacity:0}.arena.hit .board-box{animation:boardShake .42s ease-in-out}.arena.trap .board-box{animation:boardShake .46s ease-in-out}.arena.win .goal-opponent{animation:goalVictory .55s alternate infinite}\r\n.end-modal{position:fixed;inset:0;background:#19294ad1;backdrop-filter:blur(6px);display:grid;place-items:center;z-index:70;padding:18px;overflow-y:auto}.end-panel{width:min(95vw,490px);background:linear-gradient(180deg,#fff9e7,#ebf2ff);border:5px solid #e4b85b;box-shadow:0 15px 0 #263656,0 35px 60px #0c1b35a9;border-radius:26px;padding:18px 18px 26px;text-align:center;animation:modalLand .48s cubic-bezier(.2,1.4,.3,1)}.end-kicker{font-size:11px;letter-spacing:.2em;font-weight:950;color:#8a6a40}.end-emblem{font-size:37px;color:#e6ae40}.end-panel img{width:118px;height:124px;object-fit:contain;filter:drop-shadow(0 4px 5px #5e557555)}.end-panel h2{font-size:clamp(28px,7vw,43px);color:#3c4a79;line-height:1.13}.end-panel p{font-weight:900;color:#6c5572}.end-stats{font-size:12px;line-height:1.6;background:#ffffffb8;border-radius:12px;padding:10px;margin:14px auto 18px;max-width:360px}.end-controls{justify-content:center}\r\n@keyframes hintBreath{0%,100%{transform:scale(.86);opacity:.6}50%{transform:scale(1.2);opacity:1}}@keyframes attackGlow{0%,100%{box-shadow:inset 0 0 0 2px #dd5959}50%{box-shadow:inset 0 0 0 4px #ff5252,0 0 9px #ff7777}}@keyframes urgentPulse{50%{opacity:.48}}@keyframes boardShake{0%,100%{transform:translateX(0)}18%{transform:translateX(-7px)}38%{transform:translateX(5px)}56%{transform:translateX(-4px)}78%{transform:translateX(3px)}}@keyframes goalVictory{to{filter:brightness(1.4);box-shadow:0 0 12px #edbb47}}\r\n@keyframes cueEnter{0%{opacity:0;transform:translate(-50%,-30%) scale(.85)}18%{opacity:1;transform:translate(-50%,-50%) scale(1.04)}65%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-80%) scale(.98)}}@keyframes modalLand{from{opacity:0;transform:translateY(-30px) scale(.88)}to{opacity:1;transform:translateY(0) scale(1)}}\r\n@media(max-width:760px){.game{gap:14px}.side{grid-template-columns:repeat(2,minmax(0,1fr))}.battle-bar{font-size:12px;padding:9px 10px}.goal-rank{font-size:12px}.spotlight img{width:64px;height:72px}.end-panel img{height:115px}}\r\n@media(max-width:400px){.battle-bar{gap:6px}.battle-status{font-size:10px}.spotlight{gap:5px}.spotlight img{width:52px;height:72px}.goal-rank{font-size:10px}}\r\n@media(prefers-reduced-motion:reduce){.cell.hint:after,.cell.attack,.timer.urgent,.arena.hit .board-box,.arena.trap .board-box,.arena.win .goal-opponent,.end-panel,.turn-cue.active{animation:none!important}.cell{transition:none}.time-track>div{transition:none}}\r\n\r\n.cell.team-0{box-shadow:inset 0 0 0 2px #3778c4}.cell.team-1{box-shadow:inset 0 0 0 2px #dc6464}.cell.team-2{box-shadow:inset 0 0 0 2px #3d9c68}.cell.team-3{box-shadow:inset 0 0 0 2px #8d65c9}.cell .team-mark{position:absolute;left:1px;top:1px;z-index:4;padding:1px 2px;border-radius:3px;background:#fff;line-height:1;font-size:clamp(8px,1.2vw,11px);font-weight:950;color:#223}.cell.team-0 .team-mark{color:#2460a0}.cell.team-1 .team-mark{color:#b03f3f}.cell.team-2 .team-mark{color:#287a49}.cell.team-3 .team-mark{color:#7549a8}.board-legend{display:flex;flex-wrap:wrap;gap:5px 12px;padding:7px 8px;font-size:11px;font-weight:800;color:#354766}.board-legend b{margin-right:3px}.legend-dot{color:#25996b}.legend-attack{color:#db6666}.legend-trap{color:#705878}.legend-restore{color:#7936aa}.legend-extra{color:#1289b4}.legend-pawn{color:#438c44}.cell.checked-king{outline:5px solid #e02f36;outline-offset:-5px;box-shadow:inset 0 0 0 3px #fff,0 0 14px #f43a48;animation:checkPulse .8s alternate infinite}.check-banner{font-weight:950;color:#bd2635}.ability-ready{background:#ece0ff;border-color:#7652ab}@keyframes checkPulse{to{box-shadow:inset 0 0 0 3px #fff,0 0 22px #f43a48}}.cell.item-extra{background-image:radial-gradient(circle,#b6f3ff 0 35%,transparent 70%)}.cell.item-pawn{background-image:radial-gradient(circle,#cbf5bd 0 35%,transparent 70%)}.cell .item-mark{font-size:clamp(21px,4vw,35px);font-weight:950;z-index:1;filter:drop-shadow(0 2px 2px #28456d)}.cell.item-extra.hint:after,.cell.item-pawn.hint:after{width:17%;height:17%;top:4px;left:4px}.blessing{position:fixed;z-index:55;display:flex;align-items:center;gap:6px;padding:5px 10px;background:#fff8d9;border:2px solid #e4bc60;border-radius:12px;color:#614375;font-size:15px;font-weight:950;box-shadow:0 5px 14px #17244a55;white-space:nowrap;pointer-events:none}.blessing img{width:54px;height:54px;object-fit:contain}.cell.neutral-king{background:radial-gradient(circle,#fff3b8,#d8a645)!important;box-shadow:inset 0 0 0 3px #8d5b21}.crown-emblem{font-size:clamp(24px,5vw,45px);line-height:1;color:#7b321d;text-shadow:1px 2px #fff9;z-index:2}.cell.crown-holder{box-shadow:inset 0 0 0 4px #ffd34d!important;background:radial-gradient(circle,#fff8c1,#edc767)!important}.cell.crown-holder:before{content:\"♛\";position:absolute;left:1px;top:-6px;color:#a73625;font-size:clamp(16px,3vw,28px);z-index:4;text-shadow:1px 1px #fff}.cell.team-0{--team:#dc5656;--team-soft:#ffe1e1;box-shadow:inset 0 0 0 3px var(--team)}.cell.team-1{--team:#4279d7;--team-soft:#dceafe;box-shadow:inset 0 0 0 3px var(--team)}.cell.team-2{--team:#d2a71b;--team-soft:#fff0b5;box-shadow:inset 0 0 0 3px var(--team)}.cell.team-3{--team:#3ba265;--team-soft:#d9f5df;box-shadow:inset 0 0 0 3px var(--team)}.cell.team-0 .team-mark{background:#dc5656;color:#fff}.cell.team-1 .team-mark{background:#4279d7;color:#fff}.cell.team-2 .team-mark{background:#d2a71b;color:#302500}.cell.team-3 .team-mark{background:#3ba265;color:#fff}.cell[class*=\"team-\"]:not(.neutral-king){background-image:radial-gradient(circle at 50% 57%,var(--team-soft) 0 42%,transparent 70%)}.cell[class*=\"team-\"] img{filter:drop-shadow(0 0 3px var(--team))}.piece-band{position:absolute;z-index:3;bottom:1px;left:8%;width:84%;height:5px;border-radius:4px;background:var(--team);box-shadow:0 0 2px #fff}.cell.swap-hint{box-shadow:inset 0 0 0 4px #c45bc8!important}.cell.swap-hint:after{content:\"⇄\";position:absolute;color:#8c3295;font-size:22px;font-weight:950;z-index:5}.legend-swap{color:#9d42a4;font-weight:950}.cell.piece-special:after{content:'♞ N'}\r\n.turns-left{font-weight:900;color:#7a3c22;background:#ffedb1;padding:4px 8px;border-radius:8px}.skill-title{display:flex;justify-content:space-between;gap:8px;align-items:center}.skill-title span,.skill-hint{font-size:12px;color:#68577b}.skill-action{display:block;width:100%;font-weight:950;background:linear-gradient(135deg,#ffe792,#f7b66e);border:2px solid #a96a3c;color:#332347;box-shadow:0 4px 0 #72576c}.skill-action.armed{background:#54468b;color:white;border-color:#382c68}.skill-action:disabled{opacity:.52;box-shadow:none}.blessing{display:flex;flex-direction:column;justify-content:center;min-width:190px;max-width:230px;text-align:center;background:radial-gradient(circle,#fffef0,#ffebad);border:3px solid #f6cc62;box-shadow:0 0 24px #ffdb60,0 0 75px #fff4b0;color:#684133}.blessing img{width:112px;height:112px;filter:drop-shadow(0 0 12px #fff1ac)}.blessing span{white-space:normal;line-height:1.25}.blessing-beam{position:fixed;z-index:54;width:170px;height:75vh;transform:translate(-50%,-100%);pointer-events:none;background:linear-gradient(to bottom,transparent,#fff7bd88 25%,#ffe16b99 80%,#fffacccc);clip-path:polygon(42% 0,58% 0,100% 100%,0 100%);animation:clericBeam 1.8s ease-out forwards}@keyframes clericBeam{0%{opacity:0}25%{opacity:1}70%{opacity:1}100%{opacity:0}}@media(max-width:700px){#abilityBtn:not(:disabled){position:fixed;z-index:45;bottom:12px;left:50%;transform:translateX(-50%);width:min(90vw,390px);box-shadow:0 5px 18px #241b5b88}#abilityBtn.armed{box-shadow:0 0 0 4px #ffe184,0 6px 18px #241b5b99}}\r\n/* Shared CBZP comic palette. Game piece/team colors remain in floor.css. */\r\n:root{--ink:#29365c;--blue:#365793;--cream:#fffaf0;--gold:#ffcf79;--coral:#c74e63}\r\nbody{color:var(--ink);background:radial-gradient(circle at 15% 12%,#effaff 0,#c8e7fc 32%,transparent 60%),linear-gradient(150deg,#b0d7f4,#e5f5ff 58%,#fff2d8)}\r\n.top{background:#f8fcffed;border-bottom:3px solid #5477a6;box-shadow:0 3px 0 #fff8;letter-spacing:.02em}\r\n.brand-link{color:#2d3d70;text-decoration:none;font-weight:950}.brand-link:hover{text-decoration:underline}\r\n.top .pill{background:#fff2cc;color:#38537f;border:2px solid #7b96bb}\r\n.locale-picker{display:flex;align-items:center;gap:7px;margin-left:auto;font-weight:850;font-size:.83rem}\r\n.locale-picker select{background:#fffdf6;border:2px solid #7994bc;border-radius:9px;padding:5px 9px;color:#2d477a;font-weight:850}\r\n.screen{background:#fffaf0;border:3px solid #607aaa;border-radius:24px;box-shadow:0 11px 0 #7798bd40,0 17px 32px #33517630}\r\n.kicker{color:#a54559;font-weight:950;letter-spacing:.14em}\r\nh1,h2{color:#2d3d70;text-shadow:2px 2px #fff,3px 3px #ffd78a}\r\n.btn{background:#fbd178;border:3px solid #596a9f;border-radius:15px;box-shadow:0 4px 0 #746f9d;font-weight:950}\r\n.btn:hover:not(:disabled){filter:brightness(1.06);transform:translateY(-1px)}\r\n.btn:active:not(:disabled){transform:translateY(3px);box-shadow:0 1px 0 #746f9d}\r\n.btn.alt{background:#dceafa}\r\n.cast figure,.choice{background:linear-gradient(150deg,#eef7ff,#fff2e2);border:2px solid #96afd2;box-shadow:0 4px 0 #9db6d650}\r\n.cast figcaption{color:#304c84}\r\n.comic{gap:14px;align-items:start}\r\n#intro .panel{padding:0;min-height:0;background:#fffdf7;border:3px solid #2e4677;border-radius:16px;box-shadow:0 5px 0 #7e9cbf;display:block;overflow:hidden}\r\n#intro .panel small{display:block;background:#fff5da;color:#2f457a;font-size:.88rem;padding:8px 12px;border-bottom:2px solid #7994b9}\r\n#intro .panel small::first-letter{color:var(--coral)}\r\n.comic-art{width:100%;height:clamp(150px,14vw,175px);object-fit:cover;object-position:center 55%;display:block;background:#d7e8f7}\r\n#intro .panel p{margin:0;padding:9px 12px;min-height:54px;background:#fffaf0;color:#2d3d6e;border-top:2px solid #7994b9;font-weight:850}\r\n#choose .choice.selected{border-color:#c95464;box-shadow:0 0 0 3px #ffe197,0 5px 0 #bd8d93}\r\n.battle-bar,.hud,.board-legend{background:#f4faff;border-color:#8ba6ca}\r\n.battle-bar{color:#263d67}.battle-status.enemy{color:#9b5925}.battle-status.alert{color:#a93244}.time-track{background:#a9bdd4}\r\n.arena{background:linear-gradient(145deg,#dbedfa,#fff4da)}\r\n.foot{color:#365681}\r\n@media(max-width:700px){.top{flex-wrap:wrap;gap:7px;padding:8px 12px}.locale-picker{margin-left:0}.comic{grid-template-columns:1fr}.comic-art{height:auto;aspect-ratio:1.12;object-fit:cover}#intro .panel p{min-height:0}.screen{margin:8px 0}}\r\n\r\n/* Title screen follows the illustrated, full-bleed covers of Themes 1 and 2. */\r\nbody:has(#cover:not(.hidden)){background:#b5dbf4}\r\nbody:has(#cover:not(.hidden)) .top{position:absolute;z-index:4;left:0;right:0;top:0;padding:10px clamp(12px,3vw,35px);background:transparent;border:0;box-shadow:none}\r\nbody:has(#cover:not(.hidden)) .brand-link,body:has(#cover:not(.hidden)) .locale-picker{background:#fff9e9e8;border:2px solid #42372f;border-radius:15px;box-shadow:0 4px 0 #42372f;padding:7px 12px;color:#292c47}\r\nbody:has(#cover:not(.hidden)) .top .pill{display:none}\r\nbody:has(#cover:not(.hidden)) .wrap{max-width:none;padding:0}\r\n#cover{position:relative;margin:0;min-height:min(780px,calc(100svh - 52px));border:0;border-radius:0;box-shadow:none;background:#a5d7fa url(\"data:image/webp;base64,\") center bottom / cover no-repeat;display:flex;align-items:flex-start;justify-content:center;text-align:center;padding:clamp(72px,10vh,100px) 18px 24px;overflow:hidden}\r\n#cover .hero{display:block;width:min(100%,850px)}\r\n#cover .hero>div:first-child{display:flex;align-items:center;flex-direction:column}\r\n#cover .kicker{display:inline-block;padding:5px 13px;border-radius:99px;background:#223450cf;color:#fff;font-size:12px;letter-spacing:.12em}\r\n#cover h1{margin:8px 0 14px;color:#ffdc70;font-size:clamp(49px,8.5vw,112px);line-height:.87;letter-spacing:-.055em;font-weight:1000;-webkit-text-stroke:clamp(2px,.45vw,6px) #20223b;paint-order:stroke fill;text-shadow:0 6px 0 #24223c,0 11px 16px #2845667d}\r\n#cover .lead{display:none}\r\n#cover #storyBtn{min-width:310px;max-width:90vw;padding:13px 25px;border:3px solid #49382f;border-radius:99px;background:linear-gradient(#ffe98b,#ffc43e);box-shadow:0 7px 0 #49382f,0 12px 22px #24365073;font-size:clamp(18px,2.2vw,25px);color:#262239}\r\n#cover #storyBtn:before{content:'▶';margin-right:10px;font-size:.85em}\r\n#cover .muted{margin:15px 0 0;padding:5px 14px;background:#fff9e9e0;color:#233451;border-radius:99px;font-size:12px;font-weight:850}\r\n#cover .cast{display:none}\r\nbody:has(#cover:not(.hidden)) .foot{background:#bce1fa;text-align:left;padding:11px 22px;color:#193e6c;font-weight:750}\r\n@media(max-width:700px){#cover{min-height:calc(100svh - 44px);background-position:center bottom;padding-top:98px}#cover h1{font-size:clamp(48px,12vw,75px)}#cover .muted{max-width:90vw;line-height:1.3}body:has(#cover:not(.hidden)) .top{flex-wrap:nowrap}body:has(#cover:not(.hidden)) .brand-link{font-size:11px;white-space:nowrap}body:has(#cover:not(.hidden)) .locale-picker{font-size:0;padding:4px}body:has(#cover:not(.hidden)) .locale-picker span{display:none}body:has(#cover:not(.hidden)) .locale-picker select{font-size:12px;border:0;background:transparent;padding:3px}}\r\n</style></head><body><div class=\"top\"><a class=\"brand-link\" href=\"/\">☁ CBZP · POT BREAKER</a><label class=\"locale-picker\" for=\"floorLocale\">🌐 <span>언어</span><select id=\"floorL