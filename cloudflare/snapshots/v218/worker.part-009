zh:{intro_title:"\u5409\u55B5\u7684\u5947\u5999\u4E0A\u73ED\u8DEF",intro_copy:"\u5728\u94F6\u674F\u679C\u8150\u70C2\u524D\u70B9\u51FB\u5B83\u3002\u752860\u79D2\u79EF\u7D2F\u5206\u6570\uFF0C\u6311\u6218\u6392\u884C\u699C\u3002",intro_help:"\u53EA\u70B9\u51FB\u9EC4\u8272\u94F6\u674F\u679C\u3002\u8FDE\u7EED\u6210\u529F\u5F97\u5206\uFF1A\u666E\u901A1\xB72\xB73\u5206\uFF0C\u56F0\u96BE2\xB74\xB76\u5206\uFF0C\u8D85\u96BE3\xB76\xB79\u5206\u3002\u6811\u53F6\u4F1A\u4E2D\u65AD\u8FDE\u51FB\uFF0C\u70C2\u679C\u4F1A\u9501\u5B9A\u64CD\u4F5C0.5\u79D2\u3002",open:"\u5F00\u59CB\u6E38\u620F",enter:"\u524D\u5F80\u94F6\u674F\u6811 \u25B6",choose:"\u9009\u62E9\u6E38\u620F",howto:"\u73A9\u6CD5\u8BF4\u660E",pot:"\u{1FAB4} POT BREAKER RE",ginkgo:"\u{1F342} \u94F6\u674F\u6811\u7834\u574F\u8005",theme:"POT BREAKER \u4E3B\u98982",title1:"\u94F6\u674F\u6811",title2:"\u7834\u574F\u8005\uFF01",subtitle:"\u62D4\u5F97\u8D8A\u591A\u5C31\u8D8A\u597D\u5417\u2026\u2026\uFF1F \u5728\u94F6\u674F\u679C\u8150\u70C2\u524D\u70B9\u51FB\u5B83\uFF01",difficulty:"\u9009\u62E9\u96BE\u5EA6",start:"\u5F00\u59CB60\u79D2\u6E38\u620F",ranking:"\u{1F3C6} \u6392\u884C\u699C",home_ranking:"\u{1F3C6} \u6392\u884C\u699C",story:"\u{1F341} \u5409\u55B5\u7684\u5947\u5999\u4E0A\u73ED\u8DEF \u2014 \u56DB\u683C\u6F2B\u753B",scene1:"\u2460 \u4E0A\u73ED\u8DEF\u4E0A",scene2:"\u2461 \u8FD9\u662F\u5916\u5305\u5417\uFF1F",scene3:"\u2462 \u771F\u7684\u8981\u62D4\u5417\uFF1F",scene4:"\u2463 \u94F6\u674F\u6811\u7834\u574F\u8005\uFF01",line1:"\u8981\u66F4\u6362\u94F6\u674F\u6811\uFF1F\u4E0D\u9519\uFF01",line2:"\u4ECE\u4ECA\u5929\u8D77\uFF0C\u4F60\u6765\u62D4\u3002",line3:"\u62D4\u5F97\u8D8A\u591A\u8D8A\u597D\u5417\u2026\u2026\uFF1F",line4:"\u5C31\u8FD9\u6837\uFF0C\u5409\u55B5\u5F00\u59CB\u62D4\u94F6\u674F\u6811\u4E86\u3002",score:"\u5206\u6570",combo:"\u8FDE\u51FB",finished:"60\u79D2\u7ED3\u675F\uFF01",best:"\u6700\u9AD8\u8FDE\u7EED\u6210\u529F",name:"\u6392\u884C\u699C\u6635\u79F0",submit:"\u63D0\u4EA4\u6210\u7EE9",retry:"\u518D\u73A9\u4E00\u6B21",ranking_info:"\u5148\u6BD4\u603B\u5206\xB7\u540C\u5206\u6BD4\u6700\u9AD8\u8FDE\u51FB\xB7\u524D\u4E09\u540D\u6C38\u4E45\u4FDD\u7559\uFF0C\u5176\u4ED6\u8BB0\u5F55\u6BCF\u67081\u65E5\u6E05\u7406",place:"\u6392\u540D",player:"\u73A9\u5BB6",back:"\u8FD4\u56DE\u9996\u9875",about:"\u6E38\u620F\u4ECB\u7ECD",privacy:"\u9690\u79C1\u4E0E\u5E7F\u544A",loading:"\u6B63\u5728\u51C6\u5907\u6E38\u620F\u3002",locked:"\u70C2\u94F6\u674F\u679C\uFF010.5\u79D2\u5185\u65E0\u6CD5\u70B9\u51FB",network:"\u65E0\u6CD5\u8FDE\u63A5\u670D\u52A1\u5668\uFF0C\u8BF7\u91CD\u8BD5\u3002",offline:"\u670D\u52A1\u5668\u6682\u65F6\u4E0D\u53EF\u7528\uFF0C\u7EE7\u7EED\u79BB\u7EBF\u6E38\u620F\u3002",offline_result:"\u672C\u6B21\u6210\u7EE9\u672A\u63D0\u4EA4\u5230\u6392\u884C\u699C\u3002",registered:"\u6210\u7EE9\u5DF2\u63D0\u4EA4\u3002",empty:"\u6682\u65E0\u8BB0\u5F55\u3002",blocked:"\u65E0\u6CD5\u52A0\u8F7D\u6392\u884C\u699C\u3002",already:"\u6E38\u620F\u5DF2\u7ED3\u675F\u3002"}};
const lang=document.documentElement.lang in T?document.documentElement.lang:"ko",tr=T[lang];
const potLink=document.getElementById("potbreaker-link");if(potLink)potLink.href=lang==="ko"?"/":"/"+lang;
document.querySelectorAll("[data-i18n]").forEach(e=>e.textContent=tr[e.dataset.i18n]||e.textContent);
document.querySelector("#language").value=lang;
const routes={ko:"/ginkgo",en:"/ginkgo/en",ja:"/ginkgo/ja",zh:"/ginkgo/zh"};
document.querySelector("#language").addEventListener("change",e=>location.assign(routes[e.target.value]));
const $=id=>document.getElementById(id);
let run=null,latestVersion=-1,busy=false,tapping=Promise.resolve(),pollTimer=null,deadline=0,finishShown=false,currentDifficulty="normal",feedbackHideTimer=null,serverOffline=false,localLockShown=false;
let localEngine=null,localTimer=null;
const viewport = new GameViewportModule();
const screenLayout = new ScreenLayoutModule({screens:Object.fromEntries(["home","intro","play","end","rankings"].map(id=>[id,$(id)])),hiddenMode:"attribute",bodyStates:{"is-playing":id=>id==="play","is-ginkgo-subview":id=>id!=="home", "is-ginkgo-home":id=>id==="home"},onShow:id=>{if(id==="intro"){const panel=$("intro").querySelector(".intro-panel");panel.scrollTop=0;requestAnimationFrame(()=>{panel.scrollTop=0;});}}});
const show=view=>screenLayout.show(view);
const boardView=new GinkgoBoardViewModule({root:$("board"),onTap:tap});
async function apiFetch(url,options={}){
 const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),2200);
 try{return await fetch(url,{...options,signal:controller.signal});}finally{clearTimeout(timer);}
}
function errors(res){return res.json().then(body=>{if(!res.ok)throw Error(body.error||"network");return body})}
function ensureLocalEngine(seed,remainingMs=60000){localEngine=new GinkgoLocalEngineModule(seed,currentDifficulty,remainingMs);}

function showFeedback(message,timeout=0){
 const el=$("lock-message");clearTimeout(feedbackHideTimer);
 if(!message){el.classList.remove("is-visible");feedbackHideTimer=setTimeout(()=>{if(!el.classList.contains("is-visible"))el.textContent=""},220);return}
 el.textContent=message;el.classList.add("is-visible");
 if(timeout)feedbackHideTimer=setTimeout(()=>showFeedback(""),timeout);
}
function paintStates(phases){if(phases)boardView.render(phases);}
function update(snapshot){
 if(!run||snapshot.version<latestVersion)return;
 latestVersion=snapshot.version;
 if(localEngine){localEngine.sync(snapshot);snapshot={...snapshot,...localEngine.state()};}
 paintStates(snapshot.cells);
 $("score").textContent=snapshot.score;
 $("combo").textContent=snapshot.combo;
 $("timer").textContent=(Math.max(0,snapshot.remaining_ms)/1000).toFixed(1);
 deadline=Date.now()+snapshot.remaining_ms;
 localLockShown=Date.now()<snapshot.locked_until;
 showFeedback(localLockShown?tr.locked:"");
 if(snapshot.done)finishGame(snapshot);
}
function renderLocalState(){
 if(!localEngine)return null;
 const local=localEngine.state();
 paintStates(local.cells);
 $("score").textContent=local.score;
 $("combo").textContent=local.combo;
 $("timer").textContent=(Math.max(0,local.remaining_ms)/1000).toFixed(1);
 if(Boolean(local.locked)!==localLockShown){localLockShown=Boolean(local.locked);showFeedback(localLockShown?tr.locked:"");}
 if(local.phase==="finished")finishGame({...local,done:true});
 return local;
}
function enterOfflineMode(){
 if(serverOffline)return;
 serverOffline=true;clearInterval(pollTimer);pollTimer=null;
 showFeedback(tr.offline,2600);
}
function localSeed(){const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]||987654321;}
function paintBoard(){boardView.mount();}
async function begin(){
 if(busy)return;busy=true;
 const fullscreenRequest=viewport.requestLandscape();
 $("begin").disabled=true;$("begin-status").textContent=tr.loading;
 currentDifficulty=document.querySelector("input[name=difficulty]:checked").value;
 serverOffline=false;localLockShown=false;finishShown=false;latestVersion=-1;
 clearInterval(pollTimer);clearInterval(localTimer);pollTimer=null;
 let seed=localSeed(),data=null;
 try{
  await fullscreenRequest;
  ensureLocalEngine(seed);
  try{
   const response=await apiFetch("/api/ginkgo/start",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({difficulty:currentDifficulty})});
   data=await errors(response);run=data.run_id;
   if(Number.isInteger(data.seed)){seed=data.seed;ensureLocalEngine(seed,data.remaining_ms||60000);}
  }catch(e){serverOffline=true;run=null;}
  deadline=Date.now()+(data?.remaining_ms||60000);paintBoard();show("play");
  if(data){update(data);}else{renderLocalState();showFeedback(tr.offline,2600);}
  localTimer=setInterval(()=>{if(localEngine&&!finishShown){localEngine.step();renderLocalState();}},50);
 }catch(e){$("begin-status").textContent=tr.network+" ("+(e?.message||"")+")"}
 finally{busy=false;$("begin").disabled=false}
}
let pollBusy=false;
async function poll(){
 if(pollBusy||!run||finishShown||serverOffline)return;pollBusy=true;
 try{
  const r=await apiFetch("/api/ginkgo/state?run="+encodeURIComponent(run),{cache:"no-store"});
  update(await errors(r));
 }catch(e){enterOfflineMode();}
 finally{pollBusy=false}
}
function tap(index){
 if((!run&&!serverOffline)||finishShown||Date.now()>=deadline||!localEngine)return;
 if(!localEngine.tap(index)){renderLocalState();return;}
 renderLocalState();
 if(serverOffline||!run)return;
 const tappedRun=run;
 tapping=tapping.then(async()=>{
  if(finishShown||serverOffline||run!==tappedRun)return;
  try{
   let r=await apiFetch("/api/ginkgo/tap",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({run_id:tappedRun,index})});
   if(r.status===409){const e=await r.json();if(e.error==="state_conflict"){r=await apiFetch("/api/ginkgo/tap",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({run_id:tappedRun,index})});}else if(e.error==="temporarily_locked"){showFeedback(tr.locked,700);return}else if(e.error==="game_ended"){await poll();return}}
   if(r.ok)update(await r.json());
   else if(r.status>=500)enterOfflineMode();
  }catch(e){enterOfflineMode();}
 });
}
function finishGame(state){
 if(finishShown)return;finishShown=true;clearInterval(pollTimer);clearInterval(localTimer);
 $("final-score").textContent=state.score;
 $("final-combo").textContent=state.max_combo;
 $("result-status").textContent=serverOffline?tr.offline_result:"";
 show("end");
}
async function rankings(){
 show("rankings");$("rank-difficulty").value=currentDifficulty;
 $("rank-status").textContent=tr.loading;$("ranking-rows").replaceChildren();
 try{
  const r=await apiFetch("/api/ginkgo/rankings?difficulty="+encodeURIComponent($("rank-difficulty").value),{cache:"no-store"});
  const d=await errors(r);
  $("rank-status").textContent=d.rankings.length?"":tr.empty;
  let rank=0,prior="",index=0;
  for(const item of d.rankings){
   index++;const key=item.score+"|"+item.max_combo;if(key!==prior){rank=index;prior=key}
   const row=document.createElement("tr");
   [rank,item.nickname,item.score,item.max_combo].forEach(value=>{const td=document.createElement("td");td.textContent=String(value);row.appendChild(td)});
   $("ranking-rows").append(row);
  }
 }catch(e){$("rank-status").textContent=tr.blocked}
}
new ActionButtonModule($("open-intro"),()=>show("intro")).mount();
new ActionButtonModule($("intro-back"),()=>show("home")).mount();
new ActionButtonModule($("begin"),begin).mount();
$("ranks-from-home").addEventListener("click",rankings);
$("rank-difficulty").addEventListener("change",()=>{currentDifficulty=$("rank-difficulty").value;rankings()});
$("back").addEventListener("click",()=>{run=null;finishShown=false;show("home")});
$("retry").addEventListener("click",()=>{run=null;finishShown=false;show("home")});
$("submit").addEventListener("click",async()=>{
 if(serverOffline||!run){$("result-status").textContent=tr.offline_result;return;}
 const name=$("nickname").value.trim();
 if(!name){$("result-status").textContent=tr.name;return}
 $("submit").disabled=true;
 try{
  const r=await apiFetch("/api/ginkgo/finish",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({run_id:run,nickname:name})});
  await errors(r);$("result-status").textContent=tr.registered;currentDifficulty=document.querySelector("input[name=difficulty]:checked").value;
  await rankings();
 }catch(e){enterOfflineMode();$("result-status").textContent=tr.offline_result}
 finally{$("submit").disabled=false}
});
`, "/modules/potbreaker/controls.css": '.dpad{\n  display:none;\n  position:absolute;\n  left:2.4%;\n  bottom:3.2%;\n  z-index:4;\n  width:clamp(126px,16cqw,164px);\n  aspect-ratio:1;\n  grid-template-columns:repeat(3,minmax(0,1fr));\n  grid-template-rows:repeat(3,minmax(0,1fr));\n  grid-template-areas:". up ." "left . right" ". down .";\n  gap:4px;\n  padding:5px;\n  border:2px solid #ffffffd9;\n  border-radius:22px;\n  background:linear-gradient(145deg,#dceafa9e,#7993b969);\n  box-shadow:inset 0 3px 12px #34486b35,0 5px 12px #324c6b44;\n  pointer-events:auto;\n  touch-action:none;\n  user-select:none;\n  -webkit-user-select:none;\n}\n.dpad-button{\n  display:grid;\n  place-items:center;\n  min-width:0;\n  min-height:0;\n  padding:0;\n  border:2px solid #fffef2ed;\n  border-radius:12px;\n  background:linear-gradient(160deg,#fff9e9,#bad4ed);\n  color:#34466f;\n  box-shadow:0 3px 0 #536c8a91,0 4px 8px #34496742;\n  font-size:clamp(17px,2.2cqw,25px);\n  font-weight:1000;\n  line-height:1;\n  touch-action:none;\n}\n.dpad-up{grid-area:up}.dpad-left{grid-area:left}.dpad-right{grid-area:right}.dpad-down{grid-area:down}\n.dpad-button:active{transform:translateY(2px);background:linear-gradient(160deg,#fff1c8,#a7cafa);box-shadow:0 1px 0 #536c8a91}\n#gamePanel .dpad,#gamePanel .actions{display:none!important}\n.legend,body.is-playing #site-footer{display:none!important}\n@media(pointer:coarse) and (hover:none){\n  #gamePanel .dpad{display:grid!important;width:clamp(252px,32cqw,328px)!important;height:clamp(252px,32cqw,328px)!important}\n  #gamePanel .actions{display:flex!important}\n}\n@media(hover:hover),(pointer:fine){#gamePanel .dpad,#gamePanel .actions{display:none!important}}\n', "/modules/potbreaker/input.js": "export class PotBreakerInputModule {\n  constructor({canvas, directionPad = null, fireButton, dashButton, isRunning, onPause, width = 19, height = 11}) {\n    this.canvas = canvas;\n    this.directionPad = directionPad;\n    this.fireButton = fireButton;\n    this.dashButton = dashButton;\n    this.isRunning = isRunning;\n    this.onPause = onPause;\n    this.width = width;\n    this.height = height;\n    this.keys = new Set();\n    this.padPointers = new Map();\n    this.fire = false;\n    this.dash = false;\n    this.pointerId = null;\n    this.origin = null;\n    this.touchActive = false;\n    this.touchDirection = [0, 0];\n    this.keyDirections = {\n      ArrowUp: 'up', KeyW: 'up', ArrowDown: 'down', KeyS: 'down',\n      ArrowLeft: 'left', KeyA: 'left', ArrowRight: 'right', KeyD: 'right'\n    };\n    this.bind();\n  }\n  bind() {\n    this.onCanvasDown = event => {\n      if (!this.isRunning() || this.pointerId !== null) return;\n      event.preventDefault();\n      this.pointerId = event.pointerId;\n      this.touchActive = true;\n      this.touchDirection = [0, 0];\n      this.origin = {x: event.clientX, y: event.clientY};\n      try { this.canvas.setPointerCapture(event.pointerId); } catch {}\n    };\n    this.onCanvasMove = event => {\n      if (event.pointerId !== this.pointerId || !this.origin) return;\n      event.preventDefault();\n      const [dx, dy] = this.screenDeltaToCells(event.clientX - this.origin.x, event.clientY - this.origin.y);\n      this.origin = {x: event.clientX, y: event.clientY};\n      const ax = Math.abs(dx), ay = Math.abs(dy);\n      if (Math.max(ax, ay) < .07) return;\n      const currentAxis = this.touchDirection[0] !== 0 ? 0 : this.touchDirection[1] !== 0 ? 1 : null;\n      const axis = ax >= ay * 1.1 ? 0 : ay >= ax * 1.1 ? 1 : currentAxis === null ? (ax >= ay ? 0 : 1) : currentAxis;\n      this.touchDirection = axis === 0 ? [Math.sign(dx), 0] : [0, Math.sign(dy)];\n    };\n    this.onCanvasUp = event => { if (event.pointerId === this.pointerId) this.reset(); };\n    this.onPadDown = event => {\n      if (!this.isRunning()) return;\n      event.preventDefault();\n      const direction = event.currentTarget.dataset.direction;\n      if (!['up','down','left','right'].includes(direction)) return;\n      this.padPointers.set(event.pointerId, direction);\n      try { event.currentTarget.setPointerCapture(event.pointerId); } catch {}\n    };\n    this.onPadUp = event => { this.padPointers.delete(event.pointerId); };\n    this.onFireDown = event => {\n      event.preventDefault(); this.fire = true;\n      try { this.fireButton.setPointerCapture(event.pointerId); } catch {}\n    };\n    this.onFireUp = () => { this.fire = false; };\n    this.onDashDown = event => {\n      event.preventDefault(); this.dash = true;\n      try { this.dashButton.setPointerCapture(event.pointerId); } catch {}\n    };\n    this.onKeyDown = event => {\n      if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','ShiftLeft','ShiftRight'].includes(event.code)) event.preventDefault();\n      this.keys.add(event.code);\n      if (event.code === 'Space') this.fire = true;\n      if (event.code === 'ShiftLeft' || event.code === 'ShiftRight') this.dash = true;\n      if (event.code === 'Escape' && this.isRunning()) this.onPause?.();\n    };\n    this.onKeyUp = event => {\n      this.keys.delete(event.code);\n      if (event.code === 'Space') this.fire = false;\n      if (event.code === 'ShiftLeft' || event.code === 'ShiftRight') this.dash = false;\n    };\n    this.onBlur = () => { this.keys.clear(); this.reset(); this.fire = false; this.dash = false; };\n    this.canvas.addEventListener('pointerdown', this.onCanvasDown);\n    this.canvas.addEventListener('pointermove', this.onCanvasMove);\n    this.canvas.addEventListener('pointerup', this.onCanvasUp);\n    for (const type of ['pointercancel','lostpointercapture']) this.canvas.addEventListener(type, this.onCanvasUp);\n    this.padButtons = [...(this.directionPad?.querySelectorAll('[data-direction]') || [])];\n    for (const button of this.padButtons) {\n      button.addEventListener('pointerdown', this.onPadDown);\n      for (const type of ['pointerup','pointercancel','lostpointercapture']) button.addEventListener(type, this.onPadUp);\n    }\n    this.fireButton.addEventListener('pointerdown', this.onFireDown);\n    for (const type of ['pointerup','pointercancel','lostpointercapture']) this.fireButton.addEventListener(type, this.onFireUp);\n    this.dashButton.addEventListener('pointerdown', this.onDashDown);\n    for (const type of ['pointerup','pointercancel','lostpointercapture']) this.dashButton.addEventListener(type, this.onFireUp);\n    window.addEventListener('keydown', this.onKeyDown);\n    window.addEventListener('keyup', this.onKeyUp);\n    window.addEventListener('blur', this.onBlur);\n  }\n  screenDeltaToCells(dx, dy) {\n    try {\n      const quad = this.canvas.getBoxQuads?.()[0];\n      if (quad) {\n        const ux = quad.p2.x - quad.p1.x, uy = quad.p2.y - quad.p1.y;\n        const vx = quad.p4.x - quad.p1.x, vy = quad.p4.y - quad.p1.y;\n        return [((dx * ux + dy * uy) / (ux * ux + uy * uy)) * this.width,\n          ((dx * vx + dy * vy) / (vx * vx + vy * vy)) * this.height];\n      }\n      let localX = dx, localY = dy;\n      const stage = this.canvas.closest('.stage') || this.canvas.closest('.viewport');\n      const transform = stage ? getComputedStyle(stage).transform : 'none';\n      if (transform && transform !== 'none') {\n        const inverse = new DOMMatrix(transform).inverse();\n        localX = inverse.a * dx + inverse.c * dy;\n        localY = inverse.b * dx + inverse.d * dy;\n      }\n      return [localX / (Math.max(1, this.canvas.clientWidth) / this.width),\n        localY / (Math.max(1, this.canvas.clientHeight) / this.height)];\n    } catch {\n      const rect = this.canvas.getBoundingClientRect();\n      const localX = rect.width < rect.height ? dy : dx;\n      const localY = rect.width < rect.height ? -dx : dy;\n      return [localX / (Math.max(1, this.canvas.clientWidth) / this.width),\n        localY / (Math.max(1, this.canvas.clientHeight) / this.height)];\n    }\n  }\n  getMove(directions) {\n    for (const code of [...this.keys].reverse()) {\n      const direction = this.keyDirections[code];\n      if (direction) return directions[direction];\n    }\n    const padDirection = [...this.padPointers.values()].at(-1);\n    if (padDirection) return directions[padDirection];\n    return this.touchActive ? this.touchDirection : [0, 0];\n  }\n  consumeActions() {\n    const actions = {fire: this.fire, dash: this.dash};\n    this.dash = false;\n    return actions;\n  }\n  reset() {\n    this.pointerId = null; this.origin = null; this.touchActive = false; this.touchDirection = [0, 0];\n  }\n  stop() {\n    this.keys.clear(); this.padPointers.clear(); this.reset(); this.fire = false; this.dash = false;\n  }\n  dispose() {\n    this.stop();\n    this.canvas.removeEventListener('pointerdown', this.onCanvasDown);\n    this.canvas.removeEventListener('pointermove', this.onCanvasMove);\n    this.canvas.removeEventListener('pointerup', this.onCanvasUp);\n    for (const type of ['pointercancel','lostpointercapture']) this.canvas.removeEventListener(type, this.onCanvasUp);\n    for (const button of this.padButtons) {\n      button.removeEventListener('pointerdown', this.onPadDown);\n      for (const type of ['pointerup','pointercancel','lostpointercapture']) button.removeEventListener(type, this.onPadUp);\n    }\n    this.fireButton.removeEventListener('pointerdown', this.onFireDown);\n    for (const type of ['pointerup','pointercancel','lostpointercapture']) this.fireButton.removeEventListener(type, this.onFireUp);\n    this.dashButton.removeEventListener('pointerdown', this.onDashDown);\n    for (const type of ['pointerup','pointercancel','lostpointercapture']) this.dashButton.removeEventListener(type, this.onFireUp);\n    window.removeEventListener('keydown', this.onKeyDown);\n    window.removeEventListener('keyup', this.onKeyUp);\n    window.removeEventListener('blur', this.onBlur);\n  }\n}\n", "/modules/potbreaker/main.js": "import {ActionButtonModule, GameViewportModule, ScreenLayoutModule} from '../shared/ui-components.js';\nimport {PotBreakerInputModule} from './input.js';\nimport {createPotBreakerRenderer} from './renderer.js';\n\n(()=>{'use strict';\nconst $=id=>document.getElementById(id),canvas=$('board');\nconst dirs={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};\nlet runtime=null,game=null,active=false,paused=false,raf=0,last=0,acc=0,world=null,tick=0,endTimer=0,controls=null;\nconst renderer=createPotBreakerRenderer({canvas,assets:window.POT_ASSETS});\nconst viewport = new GameViewportModule();\nconst screenLayout = new ScreenLayoutModule({\n screens:{title:$('title'),intro:$('intro'),gamePanel:$('gamePanel'),end:$('end')},\n bodyStates:{'is-playing':id=>id==='gamePanel'||id==='end','is-pot-subview':id=>id!=='title'}\n});\nconst show=id=>screenLayout.show(id);show('title');\n// Difficulty selection and anonymous play/event tracking.\nlet selectedDifficulty='normal',activeRunId=null,gameStartedAt=0,lastClearMs=0,visitorId=null;\nconst difficultyNames={normal:'\uB178\uBA40',hard:'\uD558\uB4DC',very_hard:'\uBCA0\uB9AC \uD558\uB4DC'};\nasync function api(path,data){const response=await fetch(path,{method:data?'POST':'GET',headers:data?{'content-type':'application/json'}:undefined,body:data?JSON.stringify(data):undefined,cache:'no-store'});const payload=await response.json().catch(()=>({}));if(!response.ok)throw new Error(payload.error||'\uC11C\uBC84 \uC5F0\uACB0\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.');return payload}\napi('/api/visit',{}).then(result=>{visitorId=result.visitor_id}).catch(()=>{});\ndocument.querySelectorAll('[data-difficulty]').forEach(button=>button.addEventListener('click',()=>{selectedDifficulty=button.dataset.difficulty;document.querySelectorAll('[data-difficulty]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)))}));\nfunction formatTime(ms){const seconds=Math.max(0,ms)/1000;return `${Math.floor(seconds/60)}:${(seconds%60).toFixed(2).padStart(5,'0')}`}\nfunction openRanking(form=false){$('rankingPanel').classList.remove('hidden');$('rankForm').classList.toggle('hidden',!form);$('rankingMessage').textContent='';loadRankings();if(form){$('rankSummary').textContent=`${formatTime(lastClearMs)} \xB7 ${difficultyNames[selectedDifficulty]}`;$('rankNickname').focus()}}\nasync function loadRankings(){const list=$('rankingList');list.innerHTML='<li>\uB7AD\uD0B9\uC744 \uBD88\uB7EC\uC624\uB294 \uC911\u2026</li>';try{const result=await api('/api/rankings');list.replaceChildren();if(!result.rankings.length){list.innerHTML='<li>\uC544\uC9C1 \uB4F1\uB85D\uB41C \uD074\uB9AC\uC5B4 \uAE30\uB85D\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.</li>';return}for(const row of result.rankings){const item=document.createElement('li');item.textContent=`${row.nickname}\u3000${formatTime(row.elapsed_ms)}\u3000`;const detail=document.createElement('span');detail.textContent=`${difficultyNames[row.difficulty]||row.difficulty} \xB7 ${row.created_at}`;item.append(detail);list.append(item)}}catch(error){list.innerHTML='<li>\uB7AD\uD0B9\uC744 \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.</li>';$('rankingMessage').textContent=error.message}}\n$('openRanking').onclick=()=>openRanking(false);$('closeRanking').onclick=()=>$('rankingPanel').classList.add('hidden');$('rankingPanel').addEventListener('click',event=>{if(event.target===$('rankingPanel'))$('rankingPanel').classList.add('hidden')});$('registerScore').onclick=()=>openRanking(true);$('rankForm').addEventListener('submit',async event=>{event.preventDefault();const nickname=$('rankNickname').value.trim();if(!activeRunId||!nickname)return;try{await api('/api/rankings',{run_id:activeRunId,nickname});$('rankForm').classList.add('hidden');$('rankingMessage').textContent='\uB7AD\uD0B9\uC5D0 \uB4F1\uB85D\uD588\uC2B5\uB2C8\uB2E4.';await loadRankings()}catch(error){$('rankingMessage').textContent=error.message}});\n\nnew ActionButtonModule($('openIntro'),()=>{renderer.unlockGameAudio();show('intro')}).mount();new ActionButtonModule($('begin'),start).mount();new ActionButtonModule($('again'),start).mount();$('home').onclick=()=>{stop();viewport.releaseLandscape();show('title')};$('pauseHome').onclick=()=>{stop();viewport.releaseLandscape();$('pausePanel').classList.add('hidden');show('title')};$('pause').onclick=()=>{paused=true;$('pausePanel').classList.remove('hidden')};$('resume').onclick=()=>{paused=false;$('pausePanel').classList.add('hidden');last=performance.now()};$('retry').onclick=()=>{ $('loader').classList.add('hidden');start()};\ncontrols=new PotBreakerInputModule({canvas,directionPad:$('directionPad'),fireButton:$('fire'),dashButton:$('dash'),isRunning:()=>active&&!paused,onPause:()=>$('pause').click(),width:19,height:11});\nfunction updateHUD(s){\n $('catAmmo').textContent=s.ammo+'/'+s.ammo_cap;$('bossAmmo').textContent=s.boss_ammo;$('difficultyLabel').textContent=difficultyNames[s.difficulty]||'\uB178\uBA40';\n $('catHP').textContent='\u2665'.repeat(Math.max(0,s.player_hp))+'\u2661'.repeat(Math.max(0,3-s.player_hp));\n $('bossHP').textContent=s.boss_hp+'/'+s.boss_hp_cap;$('dashLabel').textContent=s.player_dash_cd>0?s.player_dash_cd.toFixed(1)+'s':'\uB300\uC2DC';\n $('dash').disabled=false;$('dash').classList.toggle('cooldown',s.player_dash_cd>0);$('fire').disabled=s.ammo<1;\n $('notice').textContent=s.notice;$('notice').classList.toggle('hidden',!s.notice);\n}\nfunction stop(){active=false;if(raf)cancelAnimationFrame(raf);raf=0;if(endTimer){clearTimeout(endTimer);endTimer=0}controls?.stop()}\nasync function start(){\n stop();paused=false;await viewport.requestLandscape();show('gamePanel');$('endTag').textContent='';$('endTitle').textContent='';$('endText').textContent='';activeRunId=null;lastClearMs=0;$('registerScore').classList.add('hidden');try{const run=await api('/api/runs',{difficulty:selectedDifficulty,visitor_id:visitorId});activeRunId=run.run_id}catch(error){console.warn('\uB7AD\uD0B9 \uC138\uC158 \uC0DD\uC131 \uC2E4\uD328:',error)}renderer.reset();$('damageFlash').style.opacity='0';$('pausePanel').classList.add('hidden');$('loader').classList.remove('hidden');$('retry').classList.add('hidden');$('loadStatus').textContent='\uAC8C\uC784 \uC5D4\uC9C4\uC744 \uBD88\uB7EC\uC624\uB294 \uC911\u2026';\n try{\n  if(!window.loadPyodide)throw new Error('Pyodide\uB97C \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC778\uD130\uB137 \uC5F0\uACB0\uC744 \uD655\uC778\uD574 \uC8FC\uC138\uC694.');\n  if(!runtime){runtime=await loadPyodide({indexURL:'https://cdn.jsdelivr.net/pyodide/v0.27.7/full/'});const engine=await fetch('/game.py',{cache:'no-store'});if(!engine.ok)throw new Error('\uAC8C\uC784 \uC5D4\uC9C4\uC744 \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.');await runtime.runPythonAsync(await engine.text())}\n  if(game)game.destroy();game=runtime.runPython('PotBreaker(None, \\\"'+selectedDifficulty+'\\\")');world=JSON.parse(game.state());updateHUD(world);renderer.trackEffects(world,tick);show('gamePanel');$('loader').classList.add('hidden');active=true;last=performance.now();gameStartedAt=last;acc=0;raf=requestAnimationFrame(safeLoop)\n }catch(error){$('loadStatus').textContent='\uAC8C\uC784\uC744 \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. '+(error?.message||error);$('retry').classList.remove('hidden')}\n}\nfunction safeLoop(now){try{loop(now)}catch(error){console.error('\uAC8C\uC784 \uD654\uBA74 \uAC31\uC2E0 \uC624\uB958:',error);active=false;$('loadStatus').textContent='\uAC8C\uC784 \uD654\uBA74 \uAC31\uC2E0 \uC624\uB958: '+(error?.message||error);$('loader').classList.remove('hidden');$('retry').classList.remove('hidden')}}\nfunction loop(now){\n if(!active)return;\n if(!paused){\n  const dt=Math.min(.12,(now-last)/1000||.03);tick+=dt;acc+=dt;renderer.step(dt,tick);\n  $('damageFlash').style.opacity=String(renderer.damageFlashOpacity());\n  let count=0;\n  while(acc>=.04&&count++<3){\n   const [mx,my]=controls.getMove(dirs),{fire:fireNow,dash:dashNow}=controls.consumeActions();\n   world=JSON.parse(game.step(.04,mx,my,dashNow,fireNow,0,0));renderer.trackEffects(world,tick);acc-=.04;updateHUD(world);\n   if(world.phase!=='playing')break;\n  }\n  renderer.draw(world,tick,dt);\n  if(world.phase!=='playing'){\n   active=false;endTimer=window.setTimeout(()=>{endTimer=0;if(world&&world.phase!=='playing')end(world.phase)},450);\n   last=now;raf=requestAnimationFrame(safeLoop);return;\n  }\n }\n last=now;raf=requestAnimationFrame(safeLoop);\n}\nasync function end(outcome){if(endTimer){clearTimeout(endTimer);endTimer=0}show('end');void viewport.requestLandscape();let win=outcome==='win';lastClearMs=Math.max(0,Math.round(performance.now()-gameStartedAt));$('registerScore').classList.add('hidden');$('endingArt').src=window.POT_ASSETS[win?'victory':'defeat'];$('endTag').textContent=win?'\u2605 WINNER \u2605':'GAME OVER';$('endTitle').textContent=win?'\uAE30\uBB18 \uC2B9\uB9AC!':'\uD06C\uB2E4 \uBD80\uC7A5 \uC2B9\uB9AC!';$('endText').textContent=win?'\uD654\uBD84 \uD55C \uBC29! \uD06C\uB2E4 \uBD80\uC7A5\uC758 \uB69D\uBC30\uAE30\uB97C \uAE7C\uC2B5\uB2C8\uB2E4.':'\uAE30\uBB18\uAC00 \uD654\uBD84\uC5D0 \uBA38\uB9AC\uB9CC \uB0B4\uB193\uACE0 \uC2EC\uC5B4\uC84C\uC2B5\uB2C8\uB2E4\u2026';if(activeRunId){try{await api('/api/runs/finish',{run_id:activeRunId,outcome,elapsed_ms:lastClearMs});if(win)$('registerScore').classList.remove('hidden')}catch(error){$('rankingMessage').textContent=error.message}}}\nwindow.__potBreakerVisualCheck=(state)=>{world=state;show('gamePanel');renderer.draw(state,tick,.016)};\nwindow.addEventListener('pageshow',()=>{stop();viewport.releaseLandscape();paused=false;activeRunId=null;lastClearMs=0;$('registerScore').classList.add('hidden');$('pausePanel').classList.add('hidden');$('loader').classList.add('hidden');$('retry').classList.add('hidden');show('title')});window.addEventListener('pagehide',stop);\n})();\n", "/modules/potbreaker/renderer.js": "import {SpritePlacementModule} from '../shared/ui-components.js';\n\nexport function createPotBreakerRenderer({canvas, assets = window.POT_ASSETS, width = 19, height = 11}) {\n  const ctx = canvas.getContext('2d');\n  const W = width, H = height;\n  let tick=0,frameStep=.016,hitParticles=[],breakParticles=[],hitLastId=0,movingWallTracks=[],previousWalls=[];\n  const placement = new SpritePlacementModule();\n  const images={};for(const n of ['gimyo','keuda']){const im=new Image();im.src=assets[n];images[n]=im}\n  function rr(x,y,w,h,r,c,stroke,sw){ctx.beginPath();if(typeof ctx.roundRect==='function')ctx.roundRect(x,y,w,h,r);else{r=Math.max(0,Math.min(r,w/2,h/2));ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.arcTo(x+w,y,x+w,y+r,r);ctx.lineTo(x+w,y+h-r);ctx.arcTo(x+w,y+h,x+w-r,y+h,r);ctx.lineTo(x+r,y+h);ctx.arcTo(x,y+h,x,y+h-r,r);ctx.lineTo(x,y+r);ctx.arcTo(x,y,x+r,y,r);ctx.closePath()}if(c){ctx.fillStyle=c;ctx.fill()}if(stroke){ctx.lineWidth=sw||.025;ctx.strokeStyle=stroke;ctx.stroke()}}\n  function ellipse(x,y,rx,ry,color){ctx.beginPath();ctx.ellipse(x,y,rx,ry,0,0,Math.PI*2);ctx.fillStyle=color;ctx.fill()}\n  function strokeLine(pts,c='#8593b1',width=.035){ctx.beginPath();ctx.moveTo(...pts[0]);for(const p of pts.slice(1))ctx.lineTo(...p);ctx.lineWidth=width;ctx.strokeStyle=c;ctx.stroke()}\n  function plant(x,y,size=1,glow=false,kind='item'){const colors={boss:{body:'#e65b58',rim:'#ffaaa0',stroke:'#a93638'},player:{body:'#5b91e8',rim:'#a9caff',stroke:'#315ca0'},item:{body:'#f0c44e',rim:'#ffe99a',stroke:'#8a6a25'},gamgwajang:{body:'#62bd78',rim:'#b4e5b7',stroke:'#347548'},mystery:{body:'#8c70d8',rim:'#ddd2ff',stroke:'#56458e'},heal:{body:'#45b69a',rim:'#a9f0d7',stroke:'#23715f'}};const palette=colors[kind]||colors.item;ctx.save();ctx.translate(x,y);ctx.scale(size,size);ellipse(.01,.26,.31,.12,'#66788739');ellipse(0,-.04,.25,.12,'#385d37');for(const [ox,oy,r] of [[-.13,-.23,-.7],[.12,-.28,.4],[0,-.35,0],[-.16,-.05,-1],[.16,-.13,.8]]){ctx.save();ctx.translate(ox,oy);ctx.rotate(r);ellipse(0,0,.12,.19,'#769e55');ellipse(-.025,-.03,.05,.11,'#a6cc75');ctx.restore()}ctx.beginPath();ctx.moveTo(-.26,-.08);ctx.lineTo(.26,-.08);ctx.lineTo(.19,.33);ctx.quadraticCurveTo(0,.39,-.19,.33);ctx.closePath();ctx.fillStyle=palette.body;ctx.fill();ctx.strokeStyle=palette.stroke;ctx.lineWidth=.045;ctx.stroke();rr(-.29,-.12,.58,.105,.04,palette.rim,palette.stroke,.037);strokeLine([[-.07,.03],[-.055,.22]],'#f4c28c',.04);if(kind==='mystery'){ctx.fillStyle='#fff';ctx.font='1000 .27px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('?',0,.12)}if(kind==='heal'){ctx.fillStyle='#fff';ctx.font='1000 .26px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('\u2665',0,.12)}if(glow){ctx.strokeStyle='#fff1b7';ctx.lineWidth=.052;ctx.beginPath();ctx.arc(0,-.02,.48,0,Math.PI*2);ctx.stroke();for(let i=0;i<4;i++){const a=tick*1.6+i*Math.PI/2;ellipse(Math.cos(a)*.44,Math.sin(a)*.39-.03,.055,.055,'#fff6b7')}}ctx.restore()}\n  function wall(x,y,kind){ctx.save();ctx.translate(x,y);ellipse(.52,.83,.5,.13,'#56698524');rr(.09,.11,.87,.78,.06,'#748baf');rr(.045,.045,.91,.77,.05,'#c8d6e4','#8398b4',.03);rr(.075,.065,.84,.11,.025,'#f1f7ff');rr(.10,.21,.79,.41,.04,'#e8f2fc','#a6b5cc',.02);strokeLine([[.15,.20],[.15,.62]],'#c4d2e1',.016);rr(.07,.66,.87,.11,.02,'#9ab0cf');if(kind%4===0){rr(.46,.33,.25,.29,.01,'#fff4d4','#e2cfa4',.018);strokeLine([[.48,.38],[.64,.38]],'#cfb982',.016)}ctx.restore()}\n  function floor(){const grad=ctx.createLinearGradient(0,0,W,H);grad.addColorStop(0,'#fff4e9');grad.addColorStop(.55,'#eee8e2');grad.addColorStop(1,'#e1eaf4');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);for(let y=0;y<H;y++)for(let x=0;x<W;x++){ctx.fillStyle=(x+y)%3===0?'#ffffff0c':'#87a9c30a';ctx.fillRect(x,y,1,1);ctx.strokeStyle='#afbed052';ctx.lineWidth=.015;ctx.strokeRect(x,y,1,1)}ctx.save();const g=ctx.createLinearGradient(-3,0,13,10);g.addColorStop(0,'#ffffff90');g.addColorStop(.53,'#ffffff10');g.addColorStop(1,'#ffffff02');ctx.fillStyle=g;ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(7,0);ctx.lineTo(16,11);ctx.lineTo(7,11);ctx.closePath();ctx.fill();ctx.restore()}\n  function vision(s){let x=s.boss[0]+.5,y=s.boss[1]+.5,angle=Math.atan2(s.boss_face[1],s.boss_face[0]);for(const off of [[5,155],[-155,-5]]){const a=angle+off[0]*Math.PI/180,b=angle+off[1]*Math.PI/180;ctx.beginPath();ctx.moveTo(x,y);ctx.arc(x,y,s.vision_radius,a,b,false);ctx.closePath();ctx.fillStyle='#fa928a30';ctx.fill();ctx.strokeStyle='#f1a29b66';ctx.lineWidth=.025;ctx.stroke()}}\n  function movableWall(x,y){ctx.save();ctx.translate(x,y);rr(.10,.09,.8,.81,.08,'#afcde7','#6d9bbd',.045);rr(.13,.12,.74,.12,.03,'#f5feff');rr(.14,.31,.72,.38,.045,'#c7e6f1','#93bdcf',.02);ctx.fillStyle='#5c9ac68a';ctx.beginPath();ctx.moveTo(.38,.17);ctx.lineTo(.62,.17);ctx.lineTo(.5,.06);ctx.fill();ctx.restore()}\n  function actor(asset,coords,role){\n   const placed=placement.place(role,coords,tick,frameStep);\n   ctx.save();ctx.translate(placed.x,placed.y);ellipse(0,.35,role==='player'?.42:.51,.135,'#525b7a38');\n   const im=images[asset];\n   if(im.complete&&im.naturalWidth){ctx.filter='drop-shadow(0px 0.04px 0.04px #59688145)';ctx.drawImage(im,-placed.width/2,-placed.height*.68+placed.bob,placed.width,placed.height)}\n   else ellipse(0,-.2,.37,.47,role==='player'?'#9b9088':'#9bba73');ctx.restore()\n  }\n  function crowHead(x,y,size=1,flight=false){\n   ctx.save();ctx.translate(x,y);ctx.scale(size,size);\n   ellipse(0,.29,.46,.15,'#32405c42');\n   if(flight){const flap=Math.sin(tick*18)*.17;ctx.save();ctx.rotate(flap);ellipse(-.41,-.1,.38,.14,'#343c50');ellipse(.42,-.1,.38,.14,'#343c50');ctx.restore()}\n   ellipse(0,0,.34,.34,'#313a50');ellipse(-.08,.02,.11,.115,'#555e79');\n   ctx.fillStyle='#e9b56e';ctx.beginPath();ctx.moveTo(.20,.055);ctx.lineTo(.52,.10);ctx.lineTo(.20,.20);ctx.closePath();ctx.fill();\n   ellipse(.10,-.115,.047,.052,'#fafbfd');ellipse(.113,-.113,.02,.023,'#242d43');ctx.restore()\n  }\n  let audioCtx=null,lastPotBreakId=0,flashTimer=0;function unlockGameAudio(){try{audioCtx??=new(window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume()}catch{}}function shatterSound(){try{unlockGameAudio();if(!audioCtx)return;const now=audioCtx.currentTime;for(const [freq,delay,duration,gain] of [[1850,0,.09,.075],[1250,.025,.13,.065],[720,.055,.18,.05]]){const osc=audioCtx.createOscillator(),amp=audioCtx.createGain();osc.type='triangle';osc.frequency.setValueAtTime(freq,now+delay);osc.frequency.exponentialRampToValueAtTime(Math.max(180,freq*.42),now+delay+duration);amp.gain.setValueAtTime(gain*1.35,now+delay);amp.gain.exponentialRampToValueAtTime(.001,now+delay+duration);osc.connect(amp);amp.connect(audioCtx.destination);osc.start(now+delay);osc.stop(now+delay+duration)}}catch{}}\n  function trackEffects(s){\n   const oldSet=new Set(previousWalls.map(p=>p.join(',')));\n   const newSet=new Set((s.moving_walls||[]).map(p=>p.join(',')));\n   const removed=previousWalls.filter(p=>!newSet.has(p.join(',')));\n   const added=(s.moving_walls||[]).filter(p=>!oldSet.has(p.join(',')));\n   const used=new Set();if(added.length) movingWallTracks=[];\n   for(const to of added){let pick=-1,best=999;\n     removed.forEach((from,i)=>{const cost=Math.abs(from[0]-to[0])+Math.abs(from[1]-to[1]);if(!used.has(i)&&cost<best){best=cost;pick=i}});\n     if(pick>=0&&best===1){used.add(pick);movingWallTracks.push({from:removed[pick],to,start:tick,duration:.42})}\n   }\n   previousWalls=(s.moving_walls||[]).map(p=>[...p]);\n   for(const item of (s.pot_breaks||[]))if(item.id>lastPotBreakId){lastPotBreakId=item.id;shatterSound();flashTimer=.24;const x=item.x+.5,y=item.y+.45;breakParticles.push({x,y:y-.22,vx:0,vy:-.72,t:0,life:1.05,label:true});for(let i=0;i<12;i++){const a=i*Math.PI/6;breakParticles.push({x,y,vx:Math.cos(a)*(1.8+i*.045),vy:Math.sin(a)*1.8-.45,t:0,life:.82,label:false})}}\n   for(const hit of (s.hits||[]))if(hit.id>hitLastId){hitLastId=hit.id;const px=hit.x+.5,py=hit.y+.5;for(let i=0;i<10;i++){const a=i*Math.PI/5;hitParticles.push({x:px,y:py,vx:Math.cos(a)*(1.5+i*.055),vy:Math.sin(a)*(1.35+i*.07)-.7,t:0,life:.58,label:i===0})}}\n  }\n  function shatterFx(){\n   for(const p of hitParticles){const opacity=Math.max(0,1-p.t/p.life);ctx.save();ctx.globalAlpha=opacity;ctx.translate(p.x,p.y);ctx.rotate(p.t*3);if(p.label){ctx.font='1000 .62px sans-serif';ctx.textAlign='center';ctx.lineJoin='round';ctx.strokeStyle='#fff';ctx.lineWidth=.12;ctx.strokeText('\uCA0D\uADF8\uB791!',0,-.34);ctx.fillStyle='#a6492e';ctx.fillText('\uCA0D\uADF8\uB791!',0,-.34)}else{ctx.fillStyle='#dfad78';ctx.strokeStyle='#fff4d1';ctx.lineWidth=.035;ctx.beginPath();ctx.moveTo(-.12,-.07);ctx.lineTo(.05,-.13);ctx.lineTo(.13,.07);ctx.closePath();ctx.fill();ctx.stroke()}ctx.restore()}\n   for(const p of breakParticles){const opacity=Math.max(0,1-p.t/p.life);ctx.save();ctx.globalAlpha=opacity;ctx.translate(p.x,p.y);if(p.label){const scale=1+Math.min(.22,p.t*.3);ctx.scale(scale,scale);ctx.font='1000 .72px sans-serif';ctx.textAlign='center';ctx.lineJoin='round';ctx.strokeStyle='#fff';ctx.lineWidth=.14;ctx.strokeText('\uCA0D\uADF8\uB791!',0,0);ctx.fillStyle='#a5412c';ctx.fillText('\uCA0D\uADF8\uB791!',0,0)}else{ctx.rotate(p.t*4);ctx.fillStyle='#e6b56f';ctx.strokeStyle='#fff8df';ctx.lineWidth=.035;ctx.beginPath();ctx.moveTo(-.12,-.06);ctx.lineTo(.06,-.13);ctx.lineTo(.13,.07);ctx.closePath();ctx.fill();ctx.stroke()}ctx.restore()}\n  }\n  function draw(s){const dpr=Math.min(2,devicePixelRatio||1),box=canvas.getBoundingClientRect();if(!box.width||!box.height)return;const rw=Math.floor(box.width*dpr),rh=Math.floor(box.height*dpr);if(canvas.width!==rw||canvas.height!==rh){canvas.width=rw;canvas.height=rh}ctx.setTransform(rw/W,0,0,rh/H,0,0);ctx.clearRect(0,0,W,H);floor();\n  const obstacles=new Set(s.walls.map(p=>p.join(',')));for(let y=0;y<H;y++)for(let x=0;x<W;x++){if(obstacles.has(x+','+y))wall(x,y,x*7+y*3);else if((x*7+y*11)%47===9){ctx.save();ctx.globalAlpha=.55;plant(x+.5,y+.5,.43);ctx.restore()}}for(const pos of (s.moving_walls||[])){let xx=pos[0],yy=pos[1];const track=movingWallTracks.find(t=>t.to[0]===xx&&t.to[1]===yy);if(track){const t=Math.max(0,Math.min(1,(tick-track.start)/track.duration));xx=track.from[0]+(xx-track.from[0])*t;yy=track.from[1]+(yy-track.from[1])*t}movableWall(xx,yy)}\n  for(const p of (s.crow_bombs||[])){\n   // Crow bombs: visibly thrown pots with airborne arc and a ground impact marker.\n   const duration=p.duration||.98,t=Math.max(0,Math.min(1,1-p.ttl/duration));\n   const startX=p.from_x??s.crow_flight?.x??p.x,startY=p.from_y??s.crow_flight?.y??p.y;\n   const x=startX+(p.x-startX)*t,y=startY+(p.y-startY)*t-Math.sin(t*Math.PI)*1.35;\n   ctx.save();ctx.beginPath();ctx.arc(p.x+.5,p.y+.5,.32,0,Math.PI*2);\n   ctx.fillStyle='#dd7b3940';ctx.fill();ctx.strokeStyle='#c86842a3';ctx.lineWidth=.045;ctx.stroke();ctx.restore();\n   plant(x+.5,y+.35,.76,false,'mystery');\n   }\n   if(s.crow_flight){crowHead(s.crow_flight.x+.5,s.crow_flight.y+.5,1.25,true);ctx.save();ctx.font='900 .37px sans-serif';ctx.textAlign='center';ctx.lineWidth=.065;ctx.strokeStyle='#fff';ctx.strokeText('\uAC10 \uACFC\uC7A5',s.crow_flight.x+.5,s.crow_flight.y-.08);ctx.fillStyle='#2d3958';ctx.fillText('\uAC10 \uACFC\uC7A5',s.crow_flight.x+.5,s.crow_flight.y-.08);ctx.restore()}\n   for(const p of s.pots)plant(p[0]+.5,p[1]+.42,.83,true,'item');for(const p of (s.special_pots||[]))plant(p.x+.5,p.y+.42,.94,true,p.effect);for(const p of (s.mystery_pots||[]))plant(p.x+.5,p.y+.42,.92,true,'mystery');\n  actor('keuda',s.boss,'boss');actor('gimyo',s.player,'player');for(const p of s.projectiles){plant(p.x+.5,p.y+.26,p.boss?.92:.52,true,p.boss?'boss':'player')}shatterFx();\n  }\n  function step(dt, nextTick) {\n    tick=nextTick;frameStep=dt;flashTimer=Math.max(0,flashTimer-dt);\n    for(const p of hitParticles){p.t+=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=dt*3.2}\n    hitParticles=hitParticles.filter(p=>p.t<p.life);\n    for(const p of breakParticles){p.t+=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=dt*2.5}\n    breakParticles=breakParticles.filter(p=>p.t<p.life);\n  }\n  function reset(){placement.reset();hitParticles=[];breakParticles=[];hitLastId=0;lastPotBreakId=0;movingWallTracks=[];previousWalls=[];flashTimer=0}\n  return {draw(state,nextTick=tick,dt=frameStep){tick=nextTick;frameStep=dt;draw(state)},trackEffects(state,nextTick=tick){tick=nextTick;trackEffects(state)},step,reset,unlockGameAudio,damageFlashOpacity(){return flashTimer>0?.24*Math.min(1,flashTimer/.24):0}};\n}\n", "/modules/shared/ui-components.js": "export class ScreenLayoutModule {\n  constructor({screens, bodyStates = {}, onShow = null, hiddenMode = 'class'}) {\n    this.screens = screens;\n    this.bodyStates = bodyStates;\n    this.onShow = onShow;\n    this.hiddenMode = hiddenMode;\n  }\n  show(activeName) {\n    for (const [name, element] of Object.entries(this.screens)) {\n      if (this.hiddenMode === 'attribute') element.hidden = name !== activeName;\n      else element.classList.toggle('hidden', name !== activeName);\n    }\n    for (const [className, predicate] of Object.entries(this.bodyStates)) {\n      document.body.classList.toggle(className, predicate(activeName));\n    }\n    window.scrollTo({top: 0, behavior: 'instant'});\n    this.onShow?.(activeName);\n  }\n}\n\nexport class GameViewportModule {\n  constructor({root = document.documentElement, touchOnly = true} = {}) {\n    this.root = root;\n    this.touchOnly = touchOnly;\n    this.landscapeActive = false;\n  }\n  async requestLandscape() {\n    if (this.touchOnly && !matchMedia('(pointer: coarse)').matches) return false;\n    this.landscapeActive = true;\n    let fullscreen = false;\n    let locked = false;\n    try {\n      if (!document.fullscreenElement) {\n        const enter = this.root.requestFullscreen || this.root.webkitRequestFullscreen;\n        if (enter) {\n          await enter.call(this.root, {navigationUI: 'hide'});\n          fullscreen = true;\n        }\n      } else {\n        fullscreen = true;\n      }\n    } catch {}\n    try {\n      if (screen.orientation?.lock) {\n        await screen.orientation.lock('landscape');\n        locked = true;\n      }\n    } catch {}\n    return fullscreen || locked;\n  }\n  releaseLandscape() {\n    if (!this.landscapeActive) return;\n    this.landscapeActive = false;\n    try { screen.orientation?.unlock?.(); } catch {}\n  }\n}\n\nexport class ActionButtonModule {\n  constructor(element, action, {preventDefault = false} = {}) {\n    this.element = element;\n    this.action = action;\n    this.preventDefault = preventDefault;\n    this.onClick = event => {\n      if (this.preventDefault) event.preventDefault();\n      if (!this.element.disabled) this.action(event);\n    };\n  }\n  mount() {\n    this.element.addEventListener('click', this.onClick);\n    return this;\n  }\n  dispose() {\n    this.element.removeEventListener('click', this.onClick);\n  }\n}\n\nexport class SpritePlacementModule {\n  constructor({player = [1.25, 1.18], boss = [1.63, 1.48]} = {}) {\n    this.metrics = {player, boss};\n    this.positions = new Map();\n  }\n  reset() { this.positions.clear(); }\n  place(role, coordinates, tick, delta) {\n    const current = this.positions.get(role) || [...coordinates];\n    const blend = 1 - Math.exp(-Math.min(.1, delta) * 17.5);\n    current[0] += (coordinates[0] - current[0]) * blend;\n    current[1] += (coordinates[1] - current[1]) * blend;\n    this.positions.set(role, current);\n    const [width, height] = this.metrics[role] || this.metrics.player;\n    return {x: current[0] + .5, y: current[1] + .5, width, height,\n      bob: Math.sin(tick * (role === 'player' ? 12 : 8)) * .016};\n  }\n}\n" };
var INFO_PAGES = { "ko": { "about": '<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>\uAC8C\uC784 \uC18C\uAC1C\uC640 \uC870\uC791\uBC95 | Pot Breaker RE</title><meta name="description" content="\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uC640 \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uC758 \uAC8C\uC784 \uBC29\uBC95\uACFC \uC870\uC791\uBC95\uC744 \uC548\uB0B4\uD569\uB2C8\uB2E4."><link rel="canonical" href="https://potbreaker.com/about"><meta property="og:type" content="website"><meta property="og:locale" content="ko_KR"><meta property="og:title" content="\uAC8C\uC784 \uC18C\uAC1C\uC640 \uC870\uC791\uBC95 | Pot Breaker RE"><meta property="og:description" content="\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uC640 \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uC758 \uAC8C\uC784 \uBC29\uBC95\uACFC \uC870\uC791\uBC95\uC744 \uC548\uB0B4\uD569\uB2C8\uB2E4."><meta property="og:url" content="https://potbreaker.com/about"><style>body{margin:0;background:#f7f2e9;color:#293754;font:18px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:2rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="\uC0AC\uC774\uD2B8 \uC548\uB0B4"><a href="/">\uAC8C\uC784\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30</a><a href="/privacy">\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</a></nav><article><h1>\uB450 \uAC8C\uC784 \uC18C\uAC1C</h1><p>\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uB294 CBZP \uC0AC\uBB34\uC2E4 \uBBF8\uB85C\uC5D0\uC11C \uAE30\uBB18\uC640 \uD06C\uB2E4 \uBD80\uC7A5\uC774 \uB300\uACB0\uD558\uB294 \uBE0C\uB77C\uC6B0\uC800 \uAC8C\uC784\uC785\uB2C8\uB2E4. \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uB294 60\uCD08 \uB3D9\uC548 \uC740\uD589\uB098\uBB34 \uC5F4\uB9E4\uB97C \uD130\uCE58\uD558\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.</p><section><h2>\uC870\uC791\uBC95</h2><p>\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uB294 \uBAA8\uBC14\uC77C \uD130\uCE58 \uC870\uC791 \uB610\uB294 \uCEF4\uD4E8\uD130 \uD0A4\uBCF4\uB4DC\uB85C \uD50C\uB808\uC774\uD569\uB2C8\uB2E4. \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uB294 \uD654\uBA74\uC744 \uD130\uCE58\uD558\uAC70\uB098 \uB9C8\uC6B0\uC2A4\uB85C \uC740\uD589 \uC5F4\uB9E4\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4. \uAC01 \uAC8C\uC784 \uD654\uBA74\uC5D0\uC11C \uB09C\uC774\uB3C4\uC640 \uC810\uC218 \uADDC\uCE59\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</p></section><p><a href="/">\uAC8C\uC784\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30</a></p></article></main></body></html>', "privacy": '<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4 | Pot Breaker RE</title><meta name="description" content="\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uC640 \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uC758 \uAC8C\uC784 \uAE30\uB85D, \uC11C\uBC84 \uCC98\uB9AC \uBC0F \uAD11\uACE0 \uAE30\uC220\uC744 \uC548\uB0B4\uD569\uB2C8\uB2E4."><link rel="canonical" href="https://potbreaker.com/privacy"><meta property="og:type" content="website"><meta property="og:locale" content="ko_KR"><meta property="og:title" content="\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4 | Pot Breaker RE"><meta property="og:description" content="\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uC640 \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uC758 \uAC8C\uC784 \uAE30\uB85D, \uC11C\uBC84 \uCC98\uB9AC \uBC0F \uAD11\uACE0 \uAE30\uC220\uC744 \uC548\uB0B4\uD569\uB2C8\uB2E4."><meta property="og:url" content="https://potbreaker.com/privacy"><style>body{margin:0;background:#f7f2e9;color:#293754;font:17px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:1.5rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4"><a href="/">\uAC8C\uC784\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30</a><a href="/about">\uAC8C\uC784 \uC18C\uAC1C\uC640 \uC870\uC791\uBC95</a></nav><article><h1>\uAC1C\uC778\uC815\uBCF4 \uBC0F \uAD11\uACE0 \uC548\uB0B4</h1><section><h2>\uCC98\uB9AC\uD558\uB294 \uAC8C\uC784 \uAE30\uB85D</h2><p>\uD3FF\uBE0C\uB808\uC774\uCEE4 RE\uB294 \uBB34\uC791\uC704 \uBC29\uBB38\uC790 \uC2DD\uBCC4\uC790, \uAC8C\uC784 \uC2DD\uBCC4\uC790, \uC120\uD0DD \uB09C\uC774\uB3C4, \uC9C4\uD589 \uC0C1\uD0DC\uC640 \uACBD\uAE30 \uC2DC\uAC04, \uAC8C\uC784 \uC774\uBCA4\uD2B8\uB97C \uAE30\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB7AD\uD0B9 \uB4F1\uB85D\uC744 \uC120\uD0DD\uD558\uBA74 \uB2C9\uB124\uC784(\uCD5C\uB300 16\uC790), \uB09C\uC774\uB3C4, \uACBD\uAE30 \uC2DC\uAC04 \uB610\uB294 \uC810\uC218\uAC00 \uC800\uC7A5\uB429\uB2C8\uB2E4. \uAE45\uCF54\uD2B8\uB9AC \uBE0C\uB808\uC774\uCEE4\uB294 \uBB34\uC791\uC704 \uACBD\uAE30 \uC2DD\uBCC4\uC790, \uB09C\uC774\uB3C4, \uC810\uC218\uC640 \uCD5C\uACE0 \uC5F0\uC18D \uC810\uC218\uB97C \uB7AD\uD0B9\uC5D0 \uC800\uC7A5\uD569\uB2C8\uB2E4. \uACC4\uC815 \uAC00\uC785\uC774\uB098 \uC2E4\uBA85\xB7\uC774\uBA54\uC77C\xB7\uC804\uD654\uBC88\uD638 \uC785\uB825\uC740 \uD544\uC694\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</p></section><section><h2>\uBCF4\uAD00\uACFC \uCC98\uB9AC \uBAA9\uC801</h2><p>\uAE30\uB85D\uC740 \uAC8C\uC784 \uC6B4\uC601, \uACB0\uACFC \uAC80\uC99D, \uB7AD\uD0B9 \uD45C\uC2DC\uC640 \uC11C\uBE44\uC2A4 \uC545\uC6A9 \uBC29\uC9C0\uC5D0 Cloudflare Workers \uBC0F D1\uC744 \uD1B5\uD574 \uC0AC\uC6A9\uB429\uB2C8\uB2E4. \uB370\uC774\uD130\uBCA0\uC774\uC2A4 \uAE30\uB85D\uC740 \uC790\uB3D9 \uB9CC\uB8CC\uAC00 \uBCF4\uC7A5\uB418\uC9C0 \uC54A\uC73C\uBA70 \uC6B4\uC601\uC790\uAC00 \uC0AD\uC81C\uD560 \uB54C\uAE4C\uC9C0 \uB0A8\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. Cloudflare\uB294 \uC11C\uBE44\uC2A4 \uC81C\uACF5\uACFC \uB124\uD2B8\uC6CC\uD06C \uBCF4\uC548\uC744 \uC704\uD574 \uC5F0\uACB0 \uBA54\uD0C0\uB370\uC774\uD130(\uC608: IP \uC8FC\uC18C)\uB97C \uCC98\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</p></section><section><h2>\uAD11\uACE0\uC640 \uCFE0\uD0A4</h2><p>\uD604\uC7AC \uAC8C\uC784 \uD654\uBA74\uACFC \uAC1C\uC778\uC815\uBCF4 \uC548\uB0B4 \uD398\uC774\uC9C0\uC5D0\uC11C\uB294 Google AdSense \uC2A4\uD06C\uB9BD\uD2B8\uB97C \uBD88\uB7EC\uC624\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uAD11\uACE0 \uC2A4\uD06C\uB9BD\uD2B8\uB294 \uAC8C\uC2DC\uC790 ID\uC640 \uAD11\uACE0\xB7\uAC1C\uC778\uC815\uBCF4\xB7\uB3D9\uC758 \uC900\uBE44 \uC124\uC815\uC774 \uBAA8\uB450 \uD65C\uC131\uD654\uB41C \uACBD\uC6B0\uC5D0\uB9CC \uAC8C\uC784 \uC18C\uAC1C \uD398\uC774\uC9C0\uC5D0\uC11C \uB85C\uB4DC\uB429\uB2C8\uB2E4. \uAD11\uACE0\uAC00 \uC81C\uACF5\uB418\uBA74 Google \uBC0F \uAD11\uACE0 \uD30C\uD2B8\uB108\uAC00 \uCFE0\uD0A4, \uAD11\uACE0 \uC2DD\uBCC4\uC790, IP \uC8FC\uC18C \uB610\uB294 \uC6F9 \uBE44\uCF58\uC744 \uAD11\uACE0 \uC81C\uACF5\xB7\uCE21\uC815\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB9DE\uCDA4 \uAD11\uACE0 \uC120\uD0DD\uC740 Google \uAD11\uACE0 \uC124\uC815\uC5D0\uC11C \uAD00\uB9AC\uD560 \uC218 \uC788\uACE0, \uC77C\uBD80 \uB9DE\uCDA4 \uAD11\uACE0\uB294 aboutads.info \uC120\uD0DD \uD398\uC774\uC9C0\uC5D0\uC11C \uAC70\uBD80\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</p><p><a href="https://adssettings.google.com/">Google Ads Settings</a> \xB7 <a href="https://www.aboutads.info/choices/">aboutads.info choices</a></p></section><section><h2>\uC9C0\uC5ED\uBCC4 \uB3D9\uC758\uC640 \uC678\uBD80 \uC548\uB0B4</h2><p>EEA, \uC601\uAD6D \uB610\uB294 \uC2A4\uC704\uC2A4\uC5D0\uC11C \uB9DE\uCDA4 \uAD11\uACE0\uB97C \uC81C\uACF5\uD558\uB824\uBA74 \uD574\uB2F9 Google \uC778\uC99D CMP \uBC0F \uB3D9\uC758 \uC694\uAC74\uC774 \uC801\uC6A9\uB429\uB2C8\uB2E4. Google\uC758 \uD30C\uD2B8\uB108 \uC0AC\uC774\uD2B8 \uB370\uC774\uD130 \uC0AC\uC6A9 \uC548\uB0B4\uC640 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC744 \uD655\uC778\uD558\uC138\uC694. <a href="https://policies.google.com/technologies/partner-sites">\uD30C\uD2B8\uB108 \uC0AC\uC774\uD2B8 \uB370\uC774\uD130 \uC0AC\uC6A9 \uC548\uB0B4</a> \xB7 <a href="https://policies.google.com/privacy">\uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68</a></p></section><p>\uCD5C\uC885 \uAC31\uC2E0: 2026-10-31</p></article></main></body></html>' }, "en": { "about": '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Game guide and controls | Pot Breaker RE</title><meta name="description" content="How to play Pot Breaker RE and Ginkgo Tree Breaker, with controls and game details."><link rel="canonical" href="https://potbreaker.com/en/about"><meta property="og:type" content="website"><meta property="og:locale" content="en_US"><meta property="og:title" content="Game guide and controls | Pot Breaker RE"><meta property="og:description" content="How to play Pot Breaker RE and Ginkgo Tree Breaker, with controls and game details."><meta property="og:url" content="https://potbreaker.com/en/about"><style>body{margin:0;background:#f7f2e9;color:#293754;font:18px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:2rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="Site information"><a href="/en">Back to games</a><a href="/en/privacy">Privacy and advertising</a></nav><article><h1>About the games</h1><p>Pot Breaker RE is a browser game where Gimyo and Manager Keuda face off in the CBZP office maze. Ginkgo Tree Breaker is a 60-second game about tapping ginkgo fruit.</p><section><h2>Controls</h2><p>Play Pot Breaker RE with touch controls on mobile or a keyboard on desktop. In Ginkgo Tree Breaker, tap or click ripe ginkgo fruit. Each game screen shows its difficulty and scoring rules.</p></section><p><a href="/en">Back to games</a></p></article></main></body></html>', "privacy": `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Privacy and advertising | Pot Breaker RE</title><meta name="description" content="Information about game records, server processing, and advertising technologies used by Pot Breaker RE and Ginkgo Tree Breaker."><link rel="canonical" href="https://potbreaker.com/en/privacy"><meta property="og:type" content="website"><meta property="og:locale" content="en_US"><meta property="og:title" content="Privacy and advertising | Pot Breaker RE"><meta property="og:description" content="Information about game records, server processing, and advertising technologies used by Pot Breaker RE and Ginkgo Tree Breaker."><meta property="og:url" content="https://potbreaker.com/en/privacy"><style>body{margin:0;background:#f7f2e9;color:#293754;font:17px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:1.5rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="Privacy and advertising"><a href="/en">Back to games</a><a href="/en/about">Game guide</a></nav><article><h1>Privacy and advertising</h1><section><h2>Game records</h2><p>Pot Breaker RE may record a random visitor identifier, game identifier, selected difficulty, game status and duration, and gameplay events. If you submit a leaderboard result, your nickname (up to 16 characters), difficulty, duration, or score is stored. Ginkgo Tree Breaker stores a random game identifier, difficulty, score, and best combo for leaderboard entries. Accounts, legal names, email addresses, and phone numbers are not required.</p></section><section><h2>Storage and purposes</h2><p>Records are processed through Cloudflare Workers and D1 to operate the games, validate results, show leaderboards, and prevent abuse. Automatic expiry is not guaranteed; records may remain until removed by the operator. Cloudflare may process connection metadata, such as IP addresses, to deliver and secure its network services.</p></section><section><h2>Advertising and cookies</h2><p>Google AdSense is not loaded on gameplay screens or this privacy page. The ad script is loaded only on the game guide page when the publisher ID and advertising, privacy, and consent readiness settings are all enabled. If ads are served, Google and its partners may use cookies, advertising identifiers, IP addresses, or web beacons to serve and measure ads. Manage personalized advertising in Google Ads Settings; some personalized ads can also be opted out of through aboutads.info.</p><p><a href="https://adssettings.google.com/">Google Ads Settings</a> \xB7 <a href="https://www.aboutads.info/choices/">aboutads.info choices</a></p></section><section><h2>Regional consent and external information</h2><p>Google-certified CMP and consent requirements apply before personalized ads are served in the EEA, United Kingdom, or Switzerland. See Google's information about data use on partner sites and Google's Privacy Policy. <a href="https://policies.google.com/technologies/partner-sites">data use on partner sites</a> \xB7 <a href="https://policies.google.com/privacy">Privacy Policy</a></p></section><p>Last updated: October 31, 2026</p></article></main></body></html>` }, "zh": { "about": '<!doctype html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>\u6E38\u620F\u4ECB\u7ECD\u4E0E\u64CD\u4F5C\u65B9\u6CD5 | Pot Breaker RE</title><meta name="description" content="\u6CE2\u7279\u7834\u574F\u8005 RE \u4E0E\u94F6\u674F\u6811\u7834\u574F\u8005\u7684\u73A9\u6CD5\u548C\u64CD\u4F5C\u8BF4\u660E\u3002"><link rel="canonical" href="https://potbreaker.com/zh/about"><meta property="og:type" content="website"><meta property="og:locale" content="zh_CN"><meta property="og:title" content="\u6E38\u620F\u4ECB\u7ECD\u4E0E\u64CD\u4F5C\u65B9\u6CD5 | Pot Breaker RE"><meta property="og:description" content="\u6CE2\u7279\u7834\u574F\u8005 RE \u4E0E\u94F6\u674F\u6811\u7834\u574F\u8005\u7684\u73A9\u6CD5\u548C\u64CD\u4F5C\u8BF4\u660E\u3002"><meta property="og:url" content="https://potbreaker.com/zh/about"><style>body{margin:0;background:#f7f2e9;color:#293754;font:18px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:2rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="\u7F51\u7AD9\u4FE1\u606F"><a href="/zh">\u8FD4\u56DE\u6E38\u620F</a><a href="/zh/privacy">\u9690\u79C1\u4E0E\u5E7F\u544A</a></nav><article><h1>\u6E38\u620F\u4ECB\u7ECD</h1><p>\u6CE2\u7279\u7834\u574F\u8005 RE \u662F\u4E00\u6B3E\u6D4F\u89C8\u5668\u6E38\u620F\uFF0C\u57FA\u5999\u4E0E\u514B\u5927\u90E8\u957F\u5728 CBZP \u529E\u516C\u5BA4\u8FF7\u5BAB\u4E2D\u5BF9\u51B3\u3002\u94F6\u674F\u6811\u7834\u574F\u8005\u662F\u4E00\u6B3E 60 \u79D2\u5185\u70B9\u51FB\u94F6\u674F\u679C\u7684\u6E38\u620F\u3002</p><section><h2>\u64CD\u4F5C\u65B9\u6CD5</h2><p>\u5728\u624B\u673A\u4E0A\u4F7F\u7528\u89E6\u63A7\u64CD\u4F5C\u6E38\u73A9\u6CE2\u7279\u7834\u574F\u8005 RE\uFF0C\u5728\u7535\u8111\u4E0A\u4F7F\u7528\u952E\u76D8\u3002\u94F6\u674F\u6811\u7834\u574F\u8005\u53EF\u901A\u8FC7\u89E6\u5C4F\u6216\u9F20\u6807\u70B9\u51FB\u6210\u719F\u7684\u94F6\u674F\u679C\u3002\u96BE\u5EA6\u548C\u8BA1\u5206\u89C4\u5219\u663E\u793A\u5728\u5404\u6E38\u620F\u753B\u9762\u4E2D\u3002</p></section><p><a href="/zh">\u8FD4\u56DE\u6E38\u620F</a></p></article></main></body></html>', "privacy": '<!doctype html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>\u9690\u79C1\u4E0E\u5E7F\u544A\u8BF4\u660E | Pot Breaker RE</title><meta name="description" content="\u8BF4\u660E\u6CE2\u7279\u7834\u574F\u8005 RE \u548C\u94F6\u674F\u6811\u7834\u574F\u8005\u5904\u7406\u7684\u6E38\u620F\u8BB0\u5F55\u3001\u670D\u52A1\u5668\u6570\u636E\u53CA\u5E7F\u544A\u6280\u672F\u3002"><link rel="canonical" href="https://potbreaker.com/zh/privacy"><meta property="og:type" content="website"><meta property="og:locale" content="zh_CN"><meta property="og:title" content="\u9690\u79C1\u4E0E\u5E7F\u544A\u8BF4\u660E | Pot Breaker RE"><meta property="og:description" content="\u8BF4\u660E\u6CE2\u7279\u7834\u574F\u8005 RE \u548C\u94F6\u674F\u6811\u7834\u574F\u8005\u5904\u7406\u7684\u6E38\u620F\u8BB0\u5F55\u3001\u670D\u52A1\u5668\u6570\u636E\u53CA\u5E7F\u544A\u6280\u672F\u3002"><meta property="og:url" content="https://potbreaker.com/zh/privacy"><style>body{margin:0;background:#f7f2e9;color:#293754;font:17px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:1.5rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="\u9690\u79C1\u4E0E\u5E7F\u544A\u8BF4\u660E"><a href="/zh">\u8FD4\u56DE\u6E38\u620F</a><a href="/zh/about">\u6E38\u620F\u4ECB\u7ECD\u4E0E\u64CD\u4F5C\u65B9\u6CD5</a></nav><article><h1>\u9690\u79C1\u4E0E\u5E7F\u544A\u8BF4\u660E</h1><section><h2>\u6E38\u620F\u8BB0\u5F55</h2><p>\u6CE2\u7279\u7834\u574F\u8005 RE \u53EF\u80FD\u8BB0\u5F55\u968F\u673A\u8BBF\u5BA2\u6807\u8BC6\u7B26\u3001\u6E38\u620F\u6807\u8BC6\u7B26\u3001\u6240\u9009\u96BE\u5EA6\u3001\u6E38\u620F\u72B6\u6001\u4E0E\u65F6\u957F\u4EE5\u53CA\u6E38\u620F\u4E8B\u4EF6\u3002\u63D0\u4EA4\u6392\u884C\u699C\u6210\u7EE9\u65F6\uFF0C\u4F1A\u4FDD\u5B58\u6635\u79F0\uFF08\u6700\u591A 16 \u4E2A\u5B57\u7B26\uFF09\u3001\u96BE\u5EA6\u3001\u65F6\u957F\u6216\u5206\u6570\u3002\u94F6\u674F\u6811\u7834\u574F\u8005\u4F1A\u4E3A\u6392\u884C\u699C\u8BB0\u5F55\u968F\u673A\u6E38\u620F\u6807\u8BC6\u7B26\u3001\u96BE\u5EA6\u3001\u5206\u6570\u548C\u6700\u9AD8\u8FDE\u51FB\u6570\u3002\u65E0\u9700\u6CE8\u518C\u8D26\u6237\uFF0C\u4E5F\u65E0\u9700\u63D0\u4F9B\u771F\u5B9E\u59D3\u540D\u3001\u7535\u5B50\u90AE\u4EF6\u6216\u7535\u8BDD\u53F7\u7801\u3002</p></section><section><h2>\u5B58\u50A8\u4E0E\u7528\u9014</h2><p>\u8BB0\u5F55\u901A\u8FC7 Cloudflare Workers \u548C D1 \u5904\u7406\uFF0C\u7528\u4E8E\u8FD0\u884C\u6E38\u620F\u3001\u9A8C\u8BC1\u6210\u7EE9\u3001\u663E\u793A\u6392\u884C\u699C\u548C\u9632\u6B62\u6EE5\u7528\u3002\u65E0\u6CD5\u4FDD\u8BC1\u8BB0\u5F55\u4F1A\u81EA\u52A8\u8FC7\u671F\uFF1B\u8BB0\u5F55\u53EF\u80FD\u4F1A\u4FDD\u7559\u81F3\u8FD0\u8425\u8005\u5220\u9664\u3002Cloudflare \u53EF\u80FD\u4F1A\u5904\u7406 IP \u5730\u5740\u7B49\u8FDE\u63A5\u4FE1\u606F\uFF0C\u4EE5\u63D0\u4F9B\u5E76\u4FDD\u62A4\u7F51\u7EDC\u670D\u52A1\u3002</p></section><section><h2>\u5E7F\u544A\u4E0E Cookie</h2><p>\u6E38\u620F\u753B\u9762\u548C\u672C\u9690\u79C1\u9875\u9762\u4E0D\u4F1A\u52A0\u8F7D Google AdSense \u811A\u672C\u3002\u53EA\u6709\u5728\u53D1\u5E03\u5546 ID \u4EE5\u53CA\u5E7F\u544A\u3001\u9690\u79C1\u548C\u540C\u610F\u51C6\u5907\u8BBE\u7F6E\u5168\u90E8\u542F\u7528\u65F6\uFF0C\u6E38\u620F\u4ECB\u7ECD\u9875\u9762\u624D\u4F1A\u52A0\u8F7D\u5E7F\u544A\u811A\u672C\u3002\u5982\u679C\u5C55\u793A\u5E7F\u544A\uFF0CGoogle \u53CA\u5176\u5408\u4F5C\u4F19\u4F34\u53EF\u80FD\u4F7F\u7528 Cookie\u3001\u5E7F\u544A\u6807\u8BC6\u7B26\u3001IP \u5730\u5740\u6216\u7F51\u7EDC\u4FE1\u6807\u6765\u6295\u653E\u548C\u8861\u91CF\u5E7F\u544A\u3002\u53EF\u5728 Google \u5E7F\u544A\u8BBE\u7F6E\u4E2D\u7BA1\u7406\u4E2A\u6027\u5316\u5E7F\u544A\uFF1B\u4E5F\u53EF\u901A\u8FC7 aboutads.info \u9009\u62E9\u9000\u51FA\u90E8\u5206\u4E2A\u6027\u5316\u5E7F\u544A\u3002</p><p><a href="https://adssettings.google.com/">Google Ads Settings</a> \xB7 <a href="https://www.aboutads.info/choices/">aboutads.info choices</a></p></section><section><h2>\u5730\u533A\u540C\u610F\u4E0E\u5916\u90E8\u8BF4\u660E</h2><p>\u5728\u6B27\u6D32\u7ECF\u6D4E\u533A\u3001\u82F1\u56FD\u6216\u745E\u58EB\u6295\u653E\u4E2A\u6027\u5316\u5E7F\u544A\u524D\uFF0C\u987B\u6EE1\u8DB3 Google \u8BA4\u8BC1 CMP \u548C\u9002\u7528\u7684\u540C\u610F\u8981\u6C42\u3002\u8BF7\u67E5\u770B Google \u5173\u4E8E\u5408\u4F5C\u4F19\u4F34\u7F51\u7AD9\u6570\u636E\u4F7F\u7528\u7684\u8BF4\u660E\u53CA Google \u9690\u79C1\u6743\u653F\u7B56\u3002 <a href="https://policies.google.com/technologies/partner-sites">\u5408\u4F5C\u4F19\u4F34\u7F51\u7AD9\u6570\u636E\u4F7F\u7528\u8BF4\u660E</a> \xB7 <a href="https://policies.google.com/privacy">\u9690\u79C1\u6743\u653F\u7B56</a></p></section><p>\u6700\u540E\u66F4\u65B0\uFF1A2026\u5E7410\u670831\u65E5</p></article></main></body></html>' }, "ja": { "about": '<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>\u30B2\u30FC\u30E0\u7D39\u4ECB\u3068\u64CD\u4F5C\u65B9\u6CD5 | Pot Breaker RE</title><meta name="description" content="\u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC RE \u3068\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC\u306E\u904A\u3073\u65B9\u3068\u64CD\u4F5C\u65B9\u6CD5\u3092\u7D39\u4ECB\u3057\u307E\u3059\u3002"><link rel="canonical" href="https://potbreaker.com/ja/about"><meta property="og:type" content="website"><meta property="og:locale" content="ja_JP"><meta property="og:title" content="\u30B2\u30FC\u30E0\u7D39\u4ECB\u3068\u64CD\u4F5C\u65B9\u6CD5 | Pot Breaker RE"><meta property="og:description" content="\u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC RE \u3068\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC\u306E\u904A\u3073\u65B9\u3068\u64CD\u4F5C\u65B9\u6CD5\u3092\u7D39\u4ECB\u3057\u307E\u3059\u3002"><meta property="og:url" content="https://potbreaker.com/ja/about"><style>body{margin:0;background:#f7f2e9;color:#293754;font:18px/1.7 system-ui,sans-serif}main{max-width:820px;margin:auto;padding:clamp(22px,5vw,64px)}h1,h2{line-height:1.25}a{color:#285c91}nav{display:flex;gap:1em;flex-wrap:wrap}section{margin:2rem 0;padding:1rem 1.3rem;background:#fff;border-radius:16px}</style></head><body><main><nav aria-label="\u30B5\u30A4\u30C8\u60C5\u5831"><a href="/ja">\u30B2\u30FC\u30E0\u306B\u623B\u308B</a><a href="/ja/privacy">\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u3068\u5E83\u544A</a></nav><article><h1>\u30B2\u30FC\u30E0\u7D39\u4ECB</h1><p>\u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC RE \u306F\u3001CBZP \u30AA\u30D5\u30A3\u30B9\u306E\u8FF7\u8DEF\u3067\u30AE\u30DF\u30E7\u3068\u30AF\u30C0\u90E8\u9577\u304C\u5BFE\u6C7A\u3059\u308B\u30D6\u30E9\u30A6\u30B6\u30FC\u30B2\u30FC\u30E0\u3067\u3059\u3002\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC\u306F\u300160 \u79D2\u9593\u30A4\u30C1\u30E7\u30A6\u306E\u5B9F\u3092\u30BF\u30C3\u30D7\u3059\u308B\u30B2\u30FC\u30E0\u3067\u3059\u3002</p><section><h2>\u64CD\u4F5C\u65B9\u6CD5</h2><p>\u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC RE \u306F\u3001\u30E2\u30D0\u30A4\u30EB\u3067\u306F\u30BF\u30C3\u30C1\u64CD\u4F5C\u3001\u30D1\u30BD\u30B3\u30F3\u3067\u306F\u30AD\u30FC\u30DC\u30FC\u30C9\u3067\u904A\u3079\u307E\u3059\u3002\u30AE\u30F3\u30B3\u30C4\u30EA\u30FC\u30FB\u30D6\u30EC\u30A4\u30AB\u30FC\u3067\u306F\u3001\u753B\u9762\u3092\u30BF\u30C3\u30D7\u3059\u308B\u304B\u3001\u30DE\u30A6\u30B9\u3067\u719F\u3057\u305F\u30A4\u30C1\u30E7\u30A6\u306E\u5B9F\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u96E3\u6613\u5EA6\u3068\u5F97\u70B9\u30EB\u30FC\u30EB\u306F\u5404\u30B2\u30FC\u30E0\u753B\u9762\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002</p></section><p><a href="/ja">\u30B2\u30FC\u30E0\u306B\u623B\u308B</a></p></article></main></body></html>', "privacy": '<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u3068\u5E83\u544A\u306B\u3064\u3044\u3066 | Pot Breaker RE</title><meta name="description" content="\u30DD\u30C3\u30C8\u30D6\u30EC\u30A4\u30AB\u30FC RE \u3068\u30AE\u30F3\u30B3\u30C4\u30EA\u